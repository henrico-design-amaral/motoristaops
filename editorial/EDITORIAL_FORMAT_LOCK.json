{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "lock": "MOTORISTAOPS_SOCIAL_EDITORIAL_FORMAT_LOCK",
  "version": "3.8",
  "effective_date": "2026-10-28",
  "status": "LOCKED",
  "authority": "MotoristaOPS/SOCIAL_EDITORIAL.md",
  "default_allowed_formats": [
    "single_static",
    "seasonal_carousel_static",
    "carousel_static",
    "reel_short",
    "story_vertical"
  ],
  "exception_policy": "explicit_current_operator_authorization_only",
  "provider_fallback_allowed": false,
  "font_family": "Instrument Sans",
  "instagram_first": true,
  "microtext_allowed": false,
  "carousel": {
    "opening": [
      "introduction",
      "cta",
      "signature",
      "logo"
    ],
    "intermediate": {
      "purpose": "content",
      "logo": false,
      "commercial_cta": false
    },
    "closing": [
      "institutional_presentation",
      "services",
      "cta",
      "signature",
      "logo"
    ],
    "event_cluster": {
      "allowed": true,
      "grouping_window": [
        "same_day",
        "same_week"
      ],
      "prefer_one_event_per_content_slide": true,
      "verified_name_date_venue_per_event": true,
      "split_when_mobile_legibility_would_degrade": true
    }
  },
  "single_static": [
    "main_message",
    "contextual_composition",
    "cta",
    "closing_signature"
  ],
  "publication_gate": {
    "fail_closed": true,
    "required_qa": [
      "facts_verified",
      "official_logo_verified",
      "typography_verified",
      "margins_verified",
      "mobile_legibility_verified",
      "each_render_inspected",
      "protected_real_assets_verified_when_applicable",
      "identity_integrity_verified",
      "palette_exact_verified",
      "current_vehicle_verified_when_shown",
      "canonical_inheritance_verified",
      "video_qa_verified_when_applicable"
    ]
  },
  "identity_lock": {
    "official_asset_only": true,
    "modification_allowed": false,
    "ai_generated_identity_allowed": false,
    "derived_variant_allowed": false,
    "variant_source": "canonical_assets_only",
    "preferred_when_applicable": [
      "horizontal",
      "simplified"
    ]
  },
  "typography_lock": {
    "family": "Instrument Sans",
    "only_family": true,
    "allowed_weights": [
      "Regular",
      "Medium",
      "Semibold",
      "Bold",
      "ExtraBold"
    ],
    "forbidden_weights": [
      "Light",
      "Thin"
    ]
  },
  "palette_lock": {
    "exact_tokens": {
      "noite": "#070709",
      "grafite": "#151518",
      "champagne": "#C79C5B",
      "champagne_sombra": "#947546",
      "marfim": "#F3EFE4",
      "pedra": "#A6A39E",
      "ambar_percurso": "#F0B44D"
    },
    "allowed_modes": [
      "light",
      "dark",
      "mixed"
    ],
    "derived_brand_tones_allowed": false
  },
  "vehicle_lock": {
    "current_model": "Omoda 5 Luxury",
    "current_color": "cinza",
    "legacy_vehicle": "HB20",
    "legacy_usage": "historical_only",
    "real_approved_media_required_when_shown": true,
    "ai_generated_current_vehicle_allowed": false,
    "generic_substitution_allowed": false,
    "any_visible_car_must_be_current_operational_vehicle": true,
    "other_vehicle_visible_allowed": false,
    "composition_without_car_if_approved_media_unavailable": true
  },
  "production_lock": {
    "default_engine": "gpt_images",
    "direct_surface": "ChatGPT",
    "vector_creation_allowed": false,
    "canva_creation_allowed": false,
    "alternate_generators_allowed": false,
    "magnific": {
      "allowed": true,
      "policy": "extraordinary_last_resort_only",
      "requires_gpt_images_attempt": true,
      "requires_exception_reason": true
    },
    "video": {
      "engine_must_be_declared": true,
      "engine_must_be_approved_for_task": true,
      "short_form_protocol": "HenricoOPS/governance/protocols/SHORT_FORM_VIDEO_PROTOCOL.md",
      "full_render_with_sound_and_muted_qa": true,
      "human_acceptance_separate": true
    }
  },
  "seasonal_routing": {
    "creates_new_format_family": true,
    "target": "seasonal_carousel_static",
    "convertible_to_single_static": false,
    "convertible_without_explicit_override": false
  },
  "reference_fidelity_lock": {
    "real_place_recognizability_required": true,
    "excessive_beautification_forbidden": true,
    "strong_architectural_or_skyline_reconstruction_forbidden": true,
    "only_subtle_adjustments_allowed": true,
    "use_alternate_verifiable_reference_if_fidelity_cannot_be_preserved": true
  },
  "cta_lock": {
    "whatsapp_icon_only_with_phone": true,
    "action_copy_plain_text": true,
    "action_copy_button_treatment_allowed": false,
    "action_copy_whatsapp_icon_allowed": false
  },
  "legacy_planning_policy": {
    "effective_date": "2026-10-28",
    "future_legacy_content_invalid_until_rebuilt": true,
    "published_content_historical_only": true,
    "legacy_visuals_active_reference_allowed": false,
    "legacy_visuals_fallback_allowed": false
  },
  "seasonal_carousel_static": {
    "slides_exactly": 3,
    "opening": [
      "introduction",
      "cta",
      "signature",
      "logo"
    ],
    "content": {
      "purpose": "content_or_utility",
      "logo": false,
      "commercial_cta": false
    },
    "closing": [
      "institutional_presentation",
      "services",
      "cta",
      "signature",
      "logo"
    ]
  },
  "manifest_requirements": {
    "reference_fidelity": {
      "required_when_real_place_is_used": true,
      "recognizability_preserved": true,
      "only_subtle_adjustments": true,
      "excessive_beautification": false,
      "strong_reconstruction": false
    },
    "cta": {
      "whatsapp_icon_only_when_phone_present": true,
      "whatsapp_icon_must_be_adjacent_to_phone": true,
      "action_copy_plain_text": true,
      "action_copy_button_treatment": false,
      "action_copy_whatsapp_icon": false
    },
    "legacy": {
      "active_visual_reference_used": false,
      "legacy_template_fallback_used": false,
      "provider_native_format_used": false
    },
    "inheritance": {
      "current_canon_loaded": true,
      "approved_elements_reused_not_recreated": true,
      "new_format_invented": false,
      "new_visual_family_invented": false,
      "missing_asset_improvised": false
    },
    "vehicle": {
      "other_vehicle_visible": false,
      "visible_vehicle_is_current_operational_vehicle": true
    },
    "event_cluster": {
      "grouped_by_same_day_or_week": true,
      "facts_verified_per_event": true
    },
    "video": {
      "script_ready": true,
      "beat_map_ready": true,
      "shot_asset_map_ready": true,
      "media_provenance_recorded": true,
      "full_render_with_sound_inspected": true,
      "full_render_muted_inspected": true,
      "technical_qa_passed": true,
      "human_acceptance": "APPROVED"
    }
  },
  "last_amended": "2026-11-11",
  "composition_reference_pack": {
    "id": "motoristaops-editorial-2026-11-06",
    "document": "editorial/REFERENCE_PACK_2026-11-06.md",
    "purpose": "composition_only",
    "reference_pixels_approved_for_publication": false,
    "mandatory_context_first": true,
    "mandatory_mobile_qa": true
  },
  "inheritance_lock": {
    "inherit_existing_canon_required": true,
    "new_theme_does_not_authorize_new_format": true,
    "approved_elements_must_not_be_recreated": true,
    "missing_canonical_asset_policy": "pending_blocked",
    "new_format_requires_explicit_operator_override": true
  },
  "reel_short": {
    "media_type": "video",
    "aspect_ratio": "9:16",
    "one_core_idea": true,
    "early_hook_required": true,
    "script_required": true,
    "beat_map_required": true,
    "shot_asset_map_required": true,
    "media_provenance_required": true,
    "full_render_with_sound_inspection_required": true,
    "full_render_muted_inspection_required": true,
    "technical_qa_separate_from_human_acceptance": true,
    "no_synthetic_operator_or_operational_vehicle": true
  },
  "story_vertical": {
    "aspect_ratio": "9:16",
    "media_types": [
      "static",
      "video"
    ],
    "one_main_message": true,
    "safe_zones_required": true,
    "mechanical_resize_forbidden": true,
    "video_inherits_reel_video_qa": true
  }
}
