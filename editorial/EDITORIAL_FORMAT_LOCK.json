{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "lock": "MOTORISTAOPS_SOCIAL_EDITORIAL_FORMAT_LOCK",
  "version": "3.2",
  "effective_date": "2026-10-28",
  "status": "LOCKED",
  "authority": "MotoristaOPS/SOCIAL_EDITORIAL.md",
  "default_allowed_formats": [
    "carousel_static",
    "single_static"
  ],
  "exception_policy": "explicit_current_operator_authorization_only",
  "provider_fallback_allowed": false,
  "font_family": "Instrument Sans",
  "instagram_first": true,
  "microtext_allowed": false,
  "carousel": {
    "opening": [
      "introduction",
      "cta",
      "signature",
      "logo"
    ],
    "intermediate": {
      "purpose": "content",
      "logo": false,
      "commercial_cta": false
    },
    "closing": [
      "institutional_presentation",
      "services",
      "cta",
      "signature",
      "logo"
    ]
  },
  "single_static": [
    "main_message",
    "contextual_composition",
    "cta",
    "closing_signature"
  ],
  "publication_gate": {
    "fail_closed": true,
    "required_qa": [
      "facts_verified",
      "official_logo_verified",
      "typography_verified",
      "margins_verified",
      "mobile_legibility_verified",
      "each_render_inspected",
      "protected_real_assets_verified_when_applicable"
    ]
  },
  "production_lock": {
    "default_engine": "gpt_images",
    "direct_surface": "ChatGPT",
    "vector_creation_allowed": false,
    "canva_creation_allowed": false,
    "alternate_generators_allowed": false,
    "magnific": {
      "allowed": true,
      "policy": "extraordinary_last_resort_only",
      "requires_gpt_images_attempt": true,
      "requires_exception_reason": true
    }
  },
  "identity_lock": {
    "immutable": true,
    "official_assets_only": true,
    "modification_allowed": false,
    "redraw_allowed": false,
    "vectorization_allowed": false,
    "derived_variants_allowed": false,
    "official_existing_variants_only": true,
    "horizontal_and_simplified_allowed_when_exact_asset_exists": true
  },
  "palette_lock": {
    "immutable": true,
    "allowed_modes": [
      "light",
      "dark",
      "mixed"
    ],
    "tones_modified_allowed": false,
    "exact_tokens": {
      "noite": "#070709",
      "grafite": "#151518",
      "champagne": "#C79C5B",
      "champagne_sombra": "#947546",
      "marfim": "#F3EFE4",
      "pedra": "#A6A39E",
      "ambar_percurso": "#F0B44D"
    }
  },
  "vehicle_lock": {
    "current_model": "Omoda 5 Luxury",
    "current_color": "cinza",
    "hb20_status": "historical",
    "official_real_asset_required_when_shown": true,
    "ai_generation_allowed": false,
    "generic_substitution_allowed": false
  }
}
