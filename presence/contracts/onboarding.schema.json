{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motoristaops.com.br/contracts/onboarding.schema.json",
  "title": "MotoristaOPS Presence Onboarding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "vehicle",
    "services",
    "serviceAreas",
    "socialLinks",
    "googleBusiness",
    "printPersonalization",
    "shippingAddress"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "whatsapp"],
      "properties": {
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "fullName": { "type": "string", "maxLength": 160 },
        "phone": { "type": ["string", "null"], "maxLength": 32 },
        "whatsapp": { "type": "string", "minLength": 8, "maxLength": 32 },
        "bio": { "type": ["string", "null"], "maxLength": 1200 }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "model", "year", "color"],
      "properties": {
        "brand": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 80 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "color": { "type": "string", "minLength": 1, "maxLength": 40 },
        "capacity": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "particular",
          "executive",
          "airport",
          "events",
          "corporate",
          "travel",
          "scheduled",
          "recurring",
          "other"
        ]
      }
    },
    "serviceAreas": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2, "maxLength": 120 }
    },
    "socialLinks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instagram": { "type": ["string", "null"], "format": "uri" },
        "linkedin": { "type": ["string", "null"], "format": "uri" },
        "tiktok": { "type": ["string", "null"], "format": "uri" },
        "youtube": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "googleBusiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["not_requested", "create", "connect_existing"]
        }
      }
    },
    "printPersonalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "whatsapp"],
      "properties": {
        "displayName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "whatsapp": { "type": "string", "minLength": 8, "maxLength": 32 },
        "shortServiceLine": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "shippingAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postalCode",
        "street",
        "number",
        "neighborhood",
        "city",
        "state"
      ],
      "properties": {
        "postalCode": { "type": "string", "minLength": 8, "maxLength": 10 },
        "street": { "type": "string", "minLength": 2, "maxLength": 160 },
        "number": { "type": "string", "minLength": 1, "maxLength": 20 },
        "complement": { "type": ["string", "null"], "maxLength": 120 },
        "neighborhood": { "type": "string", "minLength": 2, "maxLength": 120 },
        "city": { "type": "string", "minLength": 2, "maxLength": 120 },
        "state": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    }
  }
}