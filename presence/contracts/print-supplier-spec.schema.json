{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motoristaops.com.br/contracts/print-supplier-spec.schema.json",
  "title": "MotoristaOPS Verified Print Supplier Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supplier",
    "productKey",
    "productName",
    "verification",
    "finishedSizeMm",
    "bleedMm",
    "safeAreaMm",
    "colorProfile",
    "minimumDpi",
    "outputFormat",
    "finish"
  ],
  "properties": {
    "supplier": { "type": "string", "minLength": 2 },
    "productKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "productName": { "type": "string", "minLength": 2 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceUrl", "verifiedAt"],
      "properties": {
        "status": { "const": "verified" },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      }
    },
    "finishedSizeMm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "bleedMm": { "type": "number", "minimum": 0 },
    "safeAreaMm": { "type": "number", "minimum": 0 },
    "colorProfile": { "type": "string", "minLength": 2 },
    "minimumDpi": { "type": "integer", "minimum": 1 },
    "outputFormat": { "type": "string", "minLength": 2 },
    "finish": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supplierRestrictions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
