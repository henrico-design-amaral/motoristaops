{
  "schema": "motoristaops.design-tokens.v2",
  "version": "2026-09-18",
  "authority": "MotoristaOPS Brand Book V2",
  "typography": {
    "dominant": {
      "family": "Instrument Sans",
      "role": "body_ui_labels_primary"
    },
    "editorial": {
      "family": "Bebas Neue",
      "role": "display_editorial_only",
      "forbidden": [
        "body",
        "functional_ui"
      ]
    }
  },
  "color": {
    "noite": {
      "value": "#070709",
      "role": "dark_canvas"
    },
    "grafite": {
      "value": "#151518",
      "role": "dark_surface_ink"
    },
    "champagne": {
      "value": "#C79C5B",
      "role": "brand_accent"
    },
    "champagne_sombra": {
      "value": "#947546",
      "role": "supporting_accent"
    },
    "marfim": {
      "value": "#F3EFE4",
      "role": "light_surface"
    },
    "pedra": {
      "value": "#A6A39E",
      "role": "muted_secondary"
    },
    "ambar_percurso": {
      "value": "#F0B44D",
      "role": "route_location_path_only"
    }
  },
  "spacing": {
    "base_px": 8,
    "half_step_px": 4,
    "rhythm": "4/8"
  },
  "grids": {
    "social": {
      "columns": 6,
      "outer_margin_px": 72,
      "gutter_px": 24
    },
    "web": {
      "desktop_columns": 12,
      "mobile_columns": 4,
      "rule": "use approved responsive contract; no per-page reinvention"
    }
  },
  "logo_presence": {
    "L1": "silent",
    "L2": "support",
    "L3": "protagonist"
  },
  "iconography": {
    "family": "Lucide Icons",
    "native_box": "24x24",
    "style": "outline_monoline",
    "stroke_width": 1.75,
    "fill": "none",
    "linecap": "round",
    "linejoin": "round",
    "sizes_px": {
      "functional": 24,
      "service_process": 32,
      "principles_min": 40,
      "principles_max": 46
    },
    "amber_semantics": [
      "route",
      "location",
      "pin",
      "path"
    ]
  },
  "composition": {
    "grammar": [
      "situation",
      "idea",
      "service",
      "signature"
    ],
    "dominant_areas": 1,
    "default_point_of_view": "service_passenger_first",
    "driver_role": "discreet_operator_secondary"
  },
  "photography": {
    "principle": "correct_do_not_transform",
    "prefer_real_evidence": true,
    "preserve_real_physical_characteristics": true,
    "stock_may_not_replace_available_real_proof": true
  },
  "motion": {
    "principle": "observes_not_performs",
    "reduced_motion_required": true
  }
}
