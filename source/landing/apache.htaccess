RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.motoristaops\.com\.br$ [NC]
RewriteRule ^ https://www.motoristaops.com.br%{REQUEST_URI} [R=301,L,NE]
# Same URL for desktop and mobile. The mobile HTML is an internal rewrite, not a redirect.
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{HTTP_USER_AGENT} "(iPhone|iPod|Android.*Mobile|Windows Phone|BlackBerry|BB10|webOS|Opera Mini|IEMobile|Mobile.*Safari|Googlebot-Smartphone)" [NC]
RewriteRule ^$ mobile/index.html [L]
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/woff2 .woff2
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Device-dependent homepage must vary at every cache layer.
  Header always merge Vary User-Agent
  <Files "og-motoristaops.jpg">
    Header always set Cache-Control "public, max-age=604800, no-transform"
  </Files>
  <FilesMatch "^(index\.html|release-manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
