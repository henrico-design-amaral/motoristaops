/* Social proof — second fold, isolated module
   Reference target: approved 1672×941 visual. No other landing module is affected. */
.social-proof{
  --sp-card:#101113;
  --sp-border:rgba(199,156,91,.58);
  --sp-border-soft:rgba(199,156,91,.34);
  --sp-separator:rgba(243,239,228,.14);
  position:relative;
  overflow:hidden;
  background:var(--mo-night);
  border-top:1px solid rgba(243,239,228,.035);
  padding:clamp(72px,5.45vw,91px) 0 clamp(68px,4.9vw,82px);
}
.social-proof-shell{
  width:100%;
  max-width:1672px;
  margin:0 auto;
  padding-inline:clamp(28px,5.62vw,94px);
}
.social-proof-head{
  display:grid;
  grid-template-columns:minmax(0,620px) minmax(0,650px);
  justify-content:space-between;
  gap:clamp(56px,8vw,214px);
  align-items:start;
  margin-bottom:clamp(34px,2.5vw,42px);
}
.social-proof .eyebrow{
  margin-bottom:17px;
  font-size:13px;
  letter-spacing:.29em;
}
.social-proof-title{
  max-width:620px;
  font-size:clamp(56px,4.55vw,76px);
  line-height:.97;
  letter-spacing:-.018em;
}
.social-proof-title>span{display:block}
.social-proof-title-accent{color:var(--mo-champagne)}
.social-proof-intro{
  max-width:650px;
  margin:8px 0 0;
  font-size:clamp(17px,1.2vw,20px);
  line-height:1.58;
  color:#d8d4cd;
}

.social-proof-metrics,
.social-proof-reviews{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:18px;
}
.social-proof-metrics{margin-bottom:18px}
.social-proof-metric,
.social-proof-review{
  border:1px solid var(--sp-border);
  border-radius:11px;
  background:var(--sp-card);
}
.social-proof-metric{
  min-height:165px;
  padding:27px 28px;
  display:flex;
  align-items:center;
  gap:22px;
}
.social-proof-metric-mark{
  flex:0 0 60px;
  width:60px;
  height:60px;
  display:grid;
  place-items:center;
  color:var(--mo-champagne);
}
.social-proof-metric-mark .brand-icon{
  --mo-brand-size:52px;
  color:var(--mo-champagne);
}
.social-proof-uber-mark{
  width:64px;
  height:64px;
  flex-basis:64px;
  border:1px solid rgba(199,156,91,.58);
  border-radius:10px;
  font-size:22px;
  font-weight:500;
  letter-spacing:-.045em;
  color:var(--mo-ivory);
}
.social-proof-metric-copy{min-width:0}
.social-proof-kicker{
  display:block;
  margin-bottom:8px;
  font-stretch:75%;
  font-size:11.5px;
  font-weight:600;
  line-height:1.2;
  letter-spacing:.23em;
  text-transform:uppercase;
  color:var(--mo-muted);
}
.social-proof-value{
  display:flex;
  flex-wrap:nowrap;
  align-items:center;
  gap:12px;
  margin:0;
  font-stretch:75%;
  font-size:clamp(34px,2.55vw,43px);
  font-weight:700;
  line-height:.96;
  letter-spacing:-.025em;
  color:var(--mo-ivory);
}
.social-proof-value--stacked{
  display:block;
  font-size:clamp(29px,2.15vw,36px);
  line-height:1.04;
}
.social-proof-value--stacked span{display:block}
.social-proof-sub{
  display:block;
  margin-top:8px;
  font-size:15px;
  line-height:1.3;
  color:#d0ccc5;
}
.social-proof-stars{
  display:inline-flex;
  align-items:center;
  gap:1px;
  color:#ffb800;
  font-size:23px;
  line-height:1;
  letter-spacing:0;
  white-space:nowrap;
}
.social-proof-metric .mo-icon{
  --mo-icon-size:54px;
  color:var(--mo-champagne);
}
.social-proof-metric .mo-icon--route{color:var(--mo-amber)}

.social-proof-review{
  position:relative;
  min-height:289px;
  padding:27px 29px 28px;
  display:flex;
  flex-direction:column;
}
.social-proof-review-head{margin-bottom:17px}
.social-proof-review-author{
  display:inline-flex;
  align-items:center;
  gap:8px;
  min-width:0;
  color:var(--mo-ivory);
}
.social-proof-review-name{
  margin:0;
  font-size:17px;
  font-weight:650;
  line-height:1.2;
  color:var(--mo-ivory);
}
.social-proof-review-author .mo-icon{
  --mo-icon-size:17px;
  flex:0 0 auto;
  color:#69aaff;
}
.social-proof-review-meta{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  margin-top:6px;
  font-size:14px;
  line-height:1.3;
  color:#d1cdc6;
}
.social-proof-review-time{white-space:nowrap}
.social-proof-review-stars{
  margin-bottom:19px;
  font-size:24px;
}
.social-proof-review blockquote{
  margin:0;
  font-size:clamp(15.5px,1.06vw,17px);
  line-height:1.47;
  color:#e2ded7;
}
.social-proof-review-quote{
  margin-top:auto;
  padding-top:18px;
  font-family:'Instrument Sans',sans-serif;
  font-size:50px;
  font-weight:700;
  line-height:.58;
  color:var(--mo-champagne);
}

.social-proof-recognition{
  display:grid;
  grid-template-columns:1.22fr repeat(4,1fr) .88fr;
  align-items:stretch;
  margin-top:44px;
}
.social-proof-recognition-lead,
.social-proof-recognition-item,
.social-proof-recognition-end{
  min-height:78px;
  display:flex;
  align-items:center;
}
.social-proof-recognition-lead{
  padding-right:28px;
  font-stretch:75%;
  font-size:14px;
  font-weight:650;
  line-height:1.35;
  letter-spacing:.17em;
  text-transform:uppercase;
  color:#d5d1ca;
}
.social-proof-recognition-lead strong{
  display:block;
  margin-top:5px;
  font-size:15px;
  color:var(--mo-champagne);
}
.social-proof-recognition-item{
  gap:16px;
  padding:0 27px;
  border-left:1px solid var(--sp-separator);
}
.social-proof-recognition-item .mo-icon{
  --mo-icon-size:40px;
  flex:0 0 auto;
  color:var(--mo-champagne);
}
.social-proof-recognition-item>span:last-child{
  font-size:15px;
  line-height:1.36;
  color:#d9d5ce;
}
.social-proof-recognition-end{
  position:relative;
  justify-content:flex-end;
  padding-left:27px;
  border-left:1px solid var(--sp-separator);
  text-align:right;
  font-stretch:75%;
  font-size:11px;
  font-weight:600;
  line-height:1.5;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--mo-muted);
}
.social-proof-recognition-end::after{
  content:"";
  position:absolute;
  right:0;
  bottom:0;
  width:30px;
  height:2px;
  background:var(--mo-amber);
}

@media(max-width:1260px){
  .social-proof-shell{padding-inline:clamp(32px,4vw,58px)}
  .social-proof-head{grid-template-columns:minmax(0,1fr) minmax(360px,.82fr);gap:48px}
  .social-proof-metrics,.social-proof-reviews{grid-template-columns:repeat(2,minmax(0,1fr))}
  .social-proof-recognition{grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid rgba(243,239,228,.08)}
  .social-proof-recognition-lead,.social-proof-recognition-item,.social-proof-recognition-end{padding:20px 22px;min-height:88px;border-left:1px solid var(--sp-separator);border-bottom:1px solid rgba(243,239,228,.08)}
  .social-proof-recognition-lead{border-left:0}
  .social-proof-recognition-end{justify-content:flex-start;text-align:left}
  .social-proof-recognition-end::after{left:22px;right:auto;bottom:16px}
}
@media(max-width:820px){
  .social-proof{padding:64px 0 58px}
  .social-proof-shell{padding-inline:22px}
  .social-proof-head{grid-template-columns:1fr;gap:26px;margin-bottom:34px}
  .social-proof-title{font-size:clamp(48px,12vw,64px)}
  .social-proof-intro{margin-top:0;max-width:100%}
  .social-proof-metrics,.social-proof-reviews{grid-template-columns:1fr;gap:14px}
  .social-proof-metric{min-height:145px;padding:24px}
  .social-proof-review{min-height:260px;padding:24px}
  .social-proof-recognition{grid-template-columns:1fr;margin-top:34px;border-top:0}
  .social-proof-recognition-lead,.social-proof-recognition-item,.social-proof-recognition-end{min-height:76px;padding:17px 0;border-left:0;border-bottom:1px solid rgba(243,239,228,.09)}
  .social-proof-recognition-lead{padding-top:0}
  .social-proof-recognition-end{justify-content:flex-start;text-align:left;border-bottom:0}
  .social-proof-recognition-end::after{left:0;bottom:0}
}
@media(max-width:420px){
  .social-proof-title{font-size:46px}
  .social-proof-metric{gap:18px;padding:22px 20px}
  .social-proof-metric-mark{width:54px;height:54px;flex-basis:54px}
  .social-proof-metric-mark .brand-icon{--mo-brand-size:46px}
  .social-proof-value{font-size:34px;gap:8px}
  .social-proof-stars{font-size:20px}
  .social-proof-review-meta{font-size:13px}
}
