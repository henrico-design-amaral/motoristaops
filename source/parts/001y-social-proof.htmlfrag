/* Social proof — second fold, isolated module */
.social-proof{border-top:1px solid rgba(243,239,228,.06);background:var(--mo-night)}
.social-proof-head{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr);gap:clamp(32px,6vw,96px);align-items:start;margin-bottom:clamp(34px,4.5vw,64px)}
.social-proof-title span{display:block}.social-proof-title .social-proof-title-accent{color:var(--mo-champagne)}
.social-proof-intro{max-width:600px;margin:10px 0 0;font-size:clamp(16px,1.35vw,18px);line-height:1.65;color:var(--mo-muted-light)}
.social-proof-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:16px}
.social-proof-metric{min-height:154px;padding:24px;border:1px solid rgba(199,156,91,.38);background:var(--mo-graphite);display:flex;align-items:center;gap:20px}
.social-proof-metric-mark{flex:0 0 48px;width:48px;height:48px;display:grid;place-items:center;color:var(--mo-champagne)}
.social-proof-metric-mark .brand-icon{--mo-brand-size:42px;color:var(--mo-champagne)}
.social-proof-uber-mark{border:1px solid rgba(199,156,91,.34);font-size:15px;font-weight:650;letter-spacing:-.02em;color:var(--mo-ivory)}
.social-proof-metric-copy{min-width:0}.social-proof-kicker{display:block;margin-bottom:6px;font-stretch:75%;font-size:11.5px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--mo-muted)}
.social-proof-value{display:flex;flex-wrap:wrap;align-items:baseline;gap:7px 10px;margin:0;font-stretch:75%;font-size:clamp(28px,2.6vw,40px);font-weight:700;line-height:1;color:var(--mo-ivory)}
.social-proof-value--stacked{display:block;line-height:1.05}.social-proof-value--stacked span{display:block}.social-proof-sub{display:block;margin-top:7px;font-size:14px;line-height:1.35;color:var(--mo-muted-light)}
.social-proof-stars{display:inline-flex;gap:2px;color:var(--mo-amber);font-size:20px;line-height:1;letter-spacing:0}
.social-proof-metric .mo-icon{--mo-icon-size:44px;color:var(--mo-champagne)}.social-proof-metric .mo-icon--route{color:var(--mo-amber)}
.social-proof-reviews{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.social-proof-review{min-height:286px;padding:24px;border:1px solid rgba(199,156,91,.28);background:#101012;display:flex;flex-direction:column}
.social-proof-review-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:14px}.social-proof-review-name{margin:0;font-size:16px;font-weight:650;color:var(--mo-ivory)}.social-proof-review-source{display:block;margin-top:3px;font-size:13px;color:var(--mo-muted)}
.social-proof-review-link{display:inline-flex;align-items:center;gap:5px;color:#9EC4FF}.social-proof-review-link .mo-icon{--mo-icon-size:18px;color:currentColor}
.social-proof-review-stars{margin-bottom:18px}.social-proof-review blockquote{margin:0;font-size:16px;line-height:1.55;color:var(--mo-muted-light)}.social-proof-review-quote{margin-top:auto;padding-top:22px;font-size:42px;font-weight:700;line-height:.7;color:var(--mo-champagne)}
.social-proof-recognition{display:grid;grid-template-columns:1.15fr repeat(4,1fr) .95fr;align-items:stretch;margin-top:clamp(34px,4vw,54px);border-top:1px solid rgba(243,239,228,.10);border-bottom:1px solid rgba(243,239,228,.10)}
.social-proof-recognition-lead,.social-proof-recognition-item,.social-proof-recognition-end{min-height:92px;padding:18px 20px;display:flex;align-items:center}
.social-proof-recognition-lead{padding-left:0;font-stretch:75%;font-size:14px;font-weight:650;line-height:1.3;letter-spacing:.13em;text-transform:uppercase;color:var(--mo-muted-light)}.social-proof-recognition-lead strong{display:block;margin-top:5px;color:var(--mo-champagne)}
.social-proof-recognition-item{gap:14px;border-left:1px solid rgba(243,239,228,.10)}.social-proof-recognition-item .mo-icon{--mo-icon-size:32px;color:var(--mo-champagne)}.social-proof-recognition-item span:last-child{font-size:14px;line-height:1.35;color:var(--mo-muted-light)}
.social-proof-recognition-end{border-left:1px solid rgba(243,239,228,.10);padding-right:0;justify-content:flex-end;text-align:right;font-stretch:75%;font-size:11.5px;font-weight:600;line-height:1.45;letter-spacing:.18em;text-transform:uppercase;color:var(--mo-muted)}
@media(max-width:1100px){.social-proof-metrics,.social-proof-reviews{grid-template-columns:repeat(2,minmax(0,1fr))}.social-proof-recognition{grid-template-columns:repeat(3,minmax(0,1fr))}.social-proof-recognition-lead,.social-proof-recognition-end{padding-left:20px;padding-right:20px}.social-proof-recognition-end{justify-content:flex-start;text-align:left}.social-proof-recognition-item,.social-proof-recognition-end{border-left:1px solid rgba(243,239,228,.10)}}
@media(max-width:780px){.social-proof-head{grid-template-columns:1fr}.social-proof-intro{margin-top:0}.social-proof-metrics,.social-proof-reviews{grid-template-columns:1fr}.social-proof-metric{min-height:132px;padding:20px}.social-proof-review{min-height:0}.social-proof-recognition{grid-template-columns:1fr}.social-proof-recognition-lead,.social-proof-recognition-item,.social-proof-recognition-end{min-height:74px;padding:16px 0;border-left:0;border-top:1px solid rgba(243,239,228,.08)}.social-proof-recognition-lead{border-top:0}.social-proof-recognition-end{justify-content:flex-start;text-align:left}}
