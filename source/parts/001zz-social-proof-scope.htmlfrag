/* Social proof safety/isolation layer.
   Keeps the second fold visually independent from the global site header
   and aligned to the same 1440px layout system used by the landing. */
#prova-social{
  contain:layout paint;
  overflow:clip;
}
#prova-social .social-proof-shell{
  width:100%;
  max-width:1440px;
  margin:0 auto;
  padding-inline:clamp(18px,3.2vw,48px);
}
/* The social proof title block is a nested <header>. Neutralize the global
   `header { position:fixed ... }` rule so it stays inside this section. */
#prova-social .social-proof-head{
  position:static !important;
  inset:auto !important;
  z-index:auto !important;
  width:auto !important;
  max-width:none !important;
  padding:0 !important;
  background:transparent !important;
  -webkit-backdrop-filter:none !important;
  backdrop-filter:none !important;
  border:0 !important;
  box-shadow:none !important;
}
/* Social proof is critical trust content: render every card immediately.
   This also prevents delayed reveal states from making the fourth card
   disappear in screenshots or fast scrolls. */
#prova-social [data-reveal]{
  opacity:1 !important;
  transform:none !important;
  transition:none !important;
}
@media(max-width:1260px){
  #prova-social .social-proof-shell{padding-inline:clamp(24px,3.2vw,48px)}
}
@media(max-width:820px){
  #prova-social .social-proof-shell{padding-inline:22px}
}
@media(max-width:420px){
  #prova-social .social-proof-shell{padding-inline:18px}
}
