<script>
(function(){
  'use strict';
  function parseStyle(s){
    var o={}; (s||'').split(';').forEach(function(p){ var i=p.indexOf(':'); if(i>0){o[p.slice(0,i).trim()]=p.slice(i+1).trim();}}); return o;
  }
  function hoverEnhance(){
    document.querySelectorAll('[style-hover]').forEach(function(el){
      var next=parseStyle(el.getAttribute('style-hover')), prev={};
      Object.keys(next).forEach(function(k){ prev[k]=el.style.getPropertyValue(k); });
      el.addEventListener('mouseenter',function(){Object.keys(next).forEach(function(k){el.style.setProperty(k,next[k]);});});
      el.addEventListener('mouseleave',function(){Object.keys(next).forEach(function(k){el.style.setProperty(k,prev[k]||'');});});
    });
  }
  function motion(){
    var reduced=window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var reveal=[].slice.call(document.querySelectorAll('[data-reveal]'));
    var steps=[].slice.call(document.querySelectorAll('[data-step]'));
    function show(el){var d=reduced?0:parseInt(el.getAttribute('data-reveal')||'0',10);setTimeout(function(){el.style.opacity='1';el.style.transform='none';},d);}
    function activate(el){el.style.opacity='1';var n=el.querySelector('[data-num]');if(n){n.style.color='#C79C5B';n.style.borderColor='rgba(199,156,91,.65)';}}
    if(reduced){reveal.forEach(show);steps.forEach(activate);return;}
    reveal.forEach(function(el){el.style.opacity='0';el.style.transform='translateY(16px)';});
    if('IntersectionObserver' in window){
      var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){show(e.target);io.unobserve(e.target);}});},{threshold:.08,rootMargin:'0px 0px -6% 0px'});
      reveal.forEach(function(el){io.observe(el);});
      var so=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){activate(e.target);so.unobserve(e.target);}});},{threshold:.08,rootMargin:'0px 0px -8% 0px'});
      steps.forEach(function(el){so.observe(el);});
    } else {reveal.forEach(show);steps.forEach(activate);}
    setTimeout(function(){reveal.forEach(function(el){el.style.opacity='1';el.style.transform='none';});steps.forEach(activate);},4000);
  }
  function header(){
    var h=document.querySelector('[data-header]'); if(!h) return;
    function onScroll(){var on=window.scrollY>40;h.style.background=on?'rgba(10,10,12,.9)':'rgba(10,10,12,.44)';h.style.backdropFilter=on?'blur(16px)':'blur(8px)';h.style.borderBottomColor=on?'rgba(199,156,91,.24)':'rgba(199,156,91,.10)';var l=h.querySelector('[data-logo]');if(l)l.style.opacity=on?'1':'.9';}
    window.addEventListener('scroll',onScroll,{passive:true});onScroll();
  }
  function init(){hoverEnhance();motion();header();}
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
})();
</script>
