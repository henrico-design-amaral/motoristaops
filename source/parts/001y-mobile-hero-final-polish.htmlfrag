/* MotoristaOPS — acabamento final da Hero mobile.
   Escopo isolado: badge de localidade e copy de apoio em duas linhas. */
@media(max-width:780px){
  .mo-mobile-hero .mo-mobile-eyebrow{
    display:inline-flex;
    align-items:center;
    width:max-content;
    margin:0 0 12px;
    padding:7px 10px 6px;
    background:var(--mo-amber);
    color:var(--mo-night);
    font-size:10px;
    font-weight:750;
    line-height:1;
    letter-spacing:.16em;
  }
  .mo-mobile-hero-copy{
    width:100%;
    max-width:none!important;
    margin-top:14px;
    font-family:'Instrument Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    font-size:15.5px;
    font-weight:400;
    font-stretch:normal;
    line-height:1.58;
    letter-spacing:normal;
    color:var(--mo-muted-light);
  }
  .mo-mobile-hero-copy span{display:block;white-space:nowrap}
}

@media(max-width:340px){
  .mo-mobile-hero-copy span{white-space:normal}
}
