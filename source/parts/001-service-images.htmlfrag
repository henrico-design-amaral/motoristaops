#servicos .container{
  max-width:1440px;
  padding-left:clamp(18px,3.2vw,48px);
  padding-right:clamp(18px,3.2vw,48px);
}
#servicos .grid-3{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}
#servicos .service-card{
  position:relative;
  overflow:hidden;
  padding:0 24px 28px;
  min-height:0;
  border:1px solid rgba(199,156,91,.24);
  border-radius:14px;
  background:linear-gradient(180deg,rgba(21,21,24,.58) 0%,rgba(15,15,18,.78) 46%,rgba(10,10,12,.94) 100%);
  box-shadow:0 14px 34px rgba(0,0,0,.12);
  transition:transform 200ms var(--mo-ease),border-color 200ms var(--mo-ease),background-color 200ms var(--mo-ease);
}
#servicos .service-card:hover{
  transform:translateY(-2px);
  border-color:rgba(199,156,91,.46);
}
#servicos .service-card::before{
  content:'';
  display:block;
  height:clamp(190px,16vw,228px);
  margin:0 -24px;
  background-image:linear-gradient(180deg,rgba(10,10,12,0) 0%,rgba(10,10,12,0) 72%,rgba(10,10,12,.18) 100%),url('/assets/service-cards.webp');
  background-repeat:no-repeat;
  background-size:100% 100%,300% 200%;
  background-color:#111216;
  border-bottom:1px solid rgba(243,239,228,.07);
  transition:filter 180ms var(--mo-ease);
}
#servicos .service-card:nth-child(1)::before{background-position:center,0% 0%}
#servicos .service-card:nth-child(2)::before{background-position:center,50% 0%}
#servicos .service-card:nth-child(3)::before{background-position:center,100% 0%}
#servicos .service-card:nth-child(4)::before{background-position:center,0% 100%}
#servicos .service-card:nth-child(5)::before{background-position:center,50% 100%}
#servicos .service-card:nth-child(6)::before{background-position:center,100% 100%}
#servicos .service-card:hover::before{filter:brightness(1.025)}

/* Iconografia oficial anterior: arquivo real, sem círculo, sem máscara e fora da imagem. */
#servicos .service-top{
  position:relative;
  left:auto;
  top:auto;
  width:auto;
  height:auto;
  margin:20px 0 14px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  gap:0;
  border:0;
  border-radius:0;
  background:transparent;
  box-shadow:none;
}
#servicos .service-top .card-num{display:none!important}
#servicos .service-top .card-icon{
  display:block!important;
  width:32px;
  height:32px;
  margin:0;
  padding:0;
  border:0;
  border-radius:0;
  background:transparent;
  box-shadow:none;
  object-fit:contain;
  opacity:.92;
}
#servicos .service-top::before{content:none!important;display:none!important}

#servicos .service-card h3{
  margin:0 0 9px;
  font-family:Georgia,'Times New Roman',serif;
  font-stretch:normal;
  font-size:clamp(19px,1.35vw,22px);
  font-weight:400;
  line-height:1.16;
  letter-spacing:-.012em;
  text-transform:none;
  color:var(--mo-ivory);
}
#servicos .service-card p{
  margin:0;
  max-width:34em;
  font-size:14px;
  line-height:1.55;
  color:#C8C4BC;
}

@media(max-width:980px) and (min-width:681px){
  #servicos .grid-3{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  #servicos .service-card::before{height:220px}
}
@media(max-width:680px){
  #servicos .container{padding-left:18px;padding-right:18px}
  #servicos .grid-3{grid-template-columns:1fr;gap:16px}
  #servicos .service-card{padding:0 20px 24px}
  #servicos .service-card::before{height:clamp(210px,58vw,260px);margin:0 -20px}
  #servicos .service-top{margin-top:18px;margin-bottom:13px}
  #servicos .service-top .card-icon{width:31px;height:31px}
  #servicos .service-card h3{font-size:21px}
  #servicos .service-card p{font-size:14.5px}
}
