<script src="https://unpkg.com/lucide@0.574.0" crossorigin="anonymous"></script>
<script>
(function(){
  'use strict';
  var ICONS={
    'airport':'plane',
    'meeting':'briefcase',
    'health':'stethoscope',
    'event':'calendar-days',
    'travel':'route',
    'wait':'hourglass',
    'schedule':'calendar-check',
    'route':'route',
    'communication':'message-circle',
    'details':'clipboard-check',
    'punctuality':'timer',
    'discretion':'eye-off',
    'care':'heart',
    'continuity':'repeat-2',
    'experience':'car-front',
    'commitment':'clock',
    'posture':'shield-check',
    'arrow-right':'arrow-right',
    'external':'arrow-up-right',
    'location':'map-pin'
  };

  var BRAND_ICONS={
    whatsapp:'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z',
    instagram:'M7.03.084c-1.277.06-2.149.264-2.911.563-.789.308-1.458.72-2.123 1.388C1.33 3.703.921 4.372.616 5.162.321 5.926.121 6.799.064 8.076.008 9.354-.005 9.764.001 13.023c.006 3.259.021 3.667.083 4.947.061 1.277.264 2.148.563 2.911.308.789.72 1.457 1.388 2.123.668.665 1.337 1.074 2.129 1.38.763.295 1.636.496 2.913.552 1.277.056 1.688.069 4.946.063 3.258-.006 3.668-.021 4.948-.081 1.28-.061 2.147-.265 2.91-.563.789-.309 1.458-.72 2.123-1.388.665-.668 1.074-1.338 1.38-2.128.295-.763.496-1.636.552-2.912.056-1.281.069-1.69.063-4.948-.006-3.258-.021-3.667-.082-4.947-.061-1.28-.264-2.149-.563-2.912-.308-.789-.72-1.457-1.388-2.123C21.298 1.33 20.628.921 19.838.617 19.074.321 18.202.12 16.924.065 15.647.009 15.236-.005 11.977.001 8.718.008 8.31.022 7.03.084m.14 21.693c-1.17-.051-1.805-.245-2.229-.408-.561-.216-.96-.477-1.382-.895-.422-.418-.681-.819-.9-1.378-.164-.423-.362-1.058-.417-2.228-.06-1.265-.072-1.644-.079-4.848-.007-3.204.005-3.583.061-4.848.05-1.169.246-1.805.408-2.228.216-.561.476-.96.895-1.382.419-.422.818-.681 1.378-.9.423-.165 1.058-.361 2.227-.417 1.266-.06 1.645-.072 4.848-.079 3.203-.007 3.584.005 4.85.061 1.169.051 1.805.245 2.228.408.561.216.96.475 1.382.895.422.419.682.818.901 1.379.165.422.362 1.056.417 2.226.06 1.266.074 1.645.08 4.848.006 3.203-.006 3.583-.061 4.848-.051 1.17-.245 1.806-.408 2.229-.216.56-.476.96-.895 1.381-.419.422-.818.681-1.378.9-.422.165-1.058.362-2.226.417-1.266.06-1.645.072-4.85.079-3.204.007-3.582-.006-4.848-.061M16.953 5.586a1.44 1.44 0 1 0 1.437-1.442 1.44 1.44 0 0 0-1.437 1.442M5.839 12.012a6.162 6.162 0 1 0 12.323-.024 6.162 6.162 0 0 0-12.323.024M8 12.008a4 4 0 1 1 4.008 3.992A4 4 0 0 1 8 12.008',
    google:'M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12S5.867 24 12.48 24c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z'
  };

  function renderIcons(root){
    root=root||document;
    var nodes=[].slice.call(root.querySelectorAll('[data-mo-icon]'));
    nodes.forEach(function(host){
      if(host.getAttribute('data-mo-rendered')==='true')return;
      var semantic=host.getAttribute('data-mo-icon');
      var icon=ICONS[semantic];
      if(!icon)return;
      var placeholder=document.createElement('i');
      placeholder.setAttribute('data-lucide',icon);
      host.textContent='';
      host.appendChild(placeholder);
      host.setAttribute('data-mo-rendered','true');
    });
    if(window.lucide&&typeof window.lucide.createIcons==='function'){
      window.lucide.createIcons({attrs:{
        'aria-hidden':'true',
        'focusable':'false',
        'fill':'none',
        'stroke':'currentColor',
        'stroke-width':'1.75',
        'stroke-linecap':'round',
        'stroke-linejoin':'round'
      }});
    }
  }

  function renderBrands(root){
    root=root||document;
    var ns='http://www.w3.org/2000/svg';
    var nodes=[].slice.call(root.querySelectorAll('[data-brand-icon]'));
    nodes.forEach(function(host){
      if(host.getAttribute('data-brand-rendered')==='true')return;
      var brand=host.getAttribute('data-brand-icon');
      var d=BRAND_ICONS[brand];
      if(!d)return;
      var svg=document.createElementNS(ns,'svg');
      var path=document.createElementNS(ns,'path');
      svg.setAttribute('viewBox','0 0 24 24');
      svg.setAttribute('aria-hidden','true');
      svg.setAttribute('focusable','false');
      svg.setAttribute('class','brand-glyph brand-glyph--'+brand);
      path.setAttribute('d',d);
      svg.appendChild(path);
      host.textContent='';
      host.appendChild(svg);
      host.setAttribute('data-brand-rendered','true');
    });
  }

  function render(root){renderIcons(root);renderBrands(root);}
  window.MotoristaIconSystem={family:'Lucide',base:24,stroke:1.75,sizes:{sm:24,md:32,lg:42},icons:ICONS,render:renderIcons};
  window.MotoristaBrandSystem={family:'brand-glyphs',base:24,icons:Object.keys(BRAND_ICONS),render:renderBrands};
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){render(document)});else render(document);
})();
</script>
