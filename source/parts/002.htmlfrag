@media(max-width:780px){.header-inner{flex-wrap:wrap}.header-logo{height:38px}.nav{order:3;width:100%;justify-content:space-between;gap:10px;overflow:auto;padding-top:2px}.nav a{font-size:11px}.header-inner>.btn{margin-left:auto;min-height:42px;padding:11px 15px;font-size:11px}.hero{padding-top:164px}.hero-content{max-width:100%}.hero-media img{object-position:68% center}.split-head,.timeline-wrap{grid-template-columns:1fr}.grid-3,.grid-4,.grid-5,.grid-8{grid-template-columns:1fr}.driver-grid{grid-template-columns:1fr}.driver-meta{grid-column:auto;grid-template-columns:1fr}.footer-grid{grid-template-columns:1fr}.footer-mid{border-left:0;border-right:0;border-top:1px solid rgba(243,239,228,.08);border-bottom:1px solid rgba(243,239,228,.08);padding:28px 0;text-align:left}.hero-actions .btn{width:100%}.hero-proof{gap:10px 16px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}[data-reveal]{opacity:1!important;transform:none!important}}
