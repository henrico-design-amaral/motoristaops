        <div data-reveal="0" style="padding:26px 24px 30px; border:1px solid rgba(21,21,23,.12); background:#FAF8F3; transition:border-color 240ms ease, transform 240ms cubic-bezier(.16,1,.3,1), opacity 520ms ease" style-hover="border-color:rgba(156,118,56,.55); transform:translateY(-2px)">
          <span style="display:block; font-family:'Instrument Sans', Helvetica, sans-serif; font-stretch:75%; font-size:14px; letter-spacing:.18em; color:#947546; margin-bottom:18px">01</span>
          <h3 style="margin:0 0 10px; font-family:'Instrument Sans', Helvetica, sans-serif; font-stretch:75%; font-size:19px; font-weight:600; letter-spacing:.005em; text-transform:uppercase">Rotina real</h3>
          <p style="margin:0; font-size:14.5px; line-height:1.6; color:#4A4845">O que vem antes da prática é leitura de contexto, rotina e necessidade.</p>
