<body data-build="motoristaops-claude-design-2026-09-05">
<header data-header>
  <div class="header-inner">
    <a href="#topo" aria-label="MotoristaOPS — início"><img data-logo class="header-logo" src="/landing-v3/logo-header-v3.svg" alt="MotoristaOPS por Henrico Amaral"></a>
    <nav class="nav" aria-label="Navegação principal">
