  <section id="diferenciais" style="padding:clamp(56px,7vw,108px) 0; background:#F3EFE4; color:#151518">
    <div style="max-width:1440px; margin:0 auto; padding:0 clamp(16px,3vw,40px)">
      <p style="margin:0 0 22px; font-family:'Instrument Sans', Helvetica, sans-serif; font-stretch:75%; font-size:14px; letter-spacing:.22em; text-transform:uppercase; color:#947546">Experiência e diferenciais</p>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:clamp(20px,4vw,64px); align-items:start; margin-bottom:clamp(34px,4vw,56px)">
