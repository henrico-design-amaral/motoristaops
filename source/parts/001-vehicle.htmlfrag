/* New-car profile: scoped to the operator's supplied dark visual reference. */
.mo-vehicle{position:relative;isolation:isolate;overflow:hidden;background:var(--mo-night);color:var(--mo-ivory);padding:56px 0 40px;font-family:inherit;border-top:1px solid rgba(243,239,228,.06)}
.mo-vehicle::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:-1;background:linear-gradient(138deg,transparent 8%,rgba(243,239,228,.035) 8.05%,transparent 8.15%,transparent 21%,rgba(243,239,228,.018) 21.05%,transparent 21.2%)}
.mo-vehicle--mobile{display:none}
.mo-vehicle__shell{max-width:1672px;margin:0 auto;padding:0 clamp(24px,3.2vw,54px)}
.mo-vehicle__lead{position:relative;min-height:430px;padding:0 0 28px;display:flex;flex-direction:column;justify-content:center}
.mo-vehicle__presentation{position:relative;z-index:2;width:48%;min-width:0}
.mo-vehicle__eyebrow{display:flex;align-items:center;gap:20px;margin:0 0 24px;color:var(--mo-champagne);font-size:12px;font-weight:650;letter-spacing:.22em;text-transform:uppercase;line-height:1.5}
.mo-vehicle__eyebrow>span{flex:1;height:1px;background:linear-gradient(90deg,var(--mo-champagne),transparent)}
.mo-vehicle__title{margin:0;font-family:inherit;font-stretch:75%;font-size:clamp(40px,4.25vw,68px);font-weight:700;letter-spacing:-.045em;line-height:1.03;text-transform:uppercase}
.mo-vehicle__title>span{color:var(--mo-champagne)}
.mo-vehicle__identity{margin:20px 0 10px;color:var(--mo-ivory);font-size:16px;font-weight:650;line-height:1.5}
.mo-vehicle__copy{margin:0;color:var(--mo-muted-light);font-size:15px;line-height:1.7;max-width:590px}
.mo-vehicle__copy strong{font-weight:600;color:var(--mo-ivory)}
.mo-vehicle__visual{position:absolute;z-index:0;right:-3%;top:-56px;width:60%;margin:0;pointer-events:none;mask-image:linear-gradient(90deg,transparent 0%,#000 12%,#000 100%)}
.mo-vehicle__crop{position:relative;overflow:hidden;aspect-ratio:var(--mo-crop-w)/var(--mo-crop-h);background:var(--mo-night)}
.mo-vehicle__crop img{position:absolute;display:block;max-width:none;width:calc(1672 / var(--mo-crop-w) * 100%);height:auto;left:calc(-1 * var(--mo-crop-x) / var(--mo-crop-w) * 100%);top:0;transform:translateY(calc(-1 * var(--mo-crop-y) / 941 * 100%))}
.mo-vehicle__crop--main{--mo-crop-x:806;--mo-crop-y:0;--mo-crop-w:866;--mo-crop-h:496}
.mo-vehicle__crop--rear{--mo-crop-x:30;--mo-crop-y:505;--mo-crop-w:535;--mo-crop-h:260}
.mo-vehicle__crop--interior{--mo-crop-x:586;--mo-crop-y:505;--mo-crop-w:555;--mo-crop-h:260}
.mo-vehicle__crop--detail{--mo-crop-x:1163;--mo-crop-y:505;--mo-crop-w:478;--mo-crop-h:260}
.mo-vehicle__attributes{position:relative;z-index:2;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));width:52%;list-style:none;margin:24px 0 0;padding:14px 0;border:1px solid rgba(199,156,91,.65);border-radius:7px;background:rgba(7,7,9,.86)}
.mo-vehicle__attributes li{display:flex;align-items:center;gap:8px;padding:0 12px;font-size:11px;line-height:1.5;color:var(--mo-muted-light);min-width:0}
.mo-vehicle__attributes li+li{border-left:1px solid rgba(199,156,91,.3)}
.mo-vehicle__attributes strong{font-weight:600;color:var(--mo-ivory)}
.mo-vehicle__gallery{position:relative;z-index:2;display:grid;grid-template-columns:535fr 555fr 478fr;gap:12px;margin:0 0 16px}
.mo-vehicle__shot{position:relative;min-width:0;overflow:hidden;margin:0;border:1px solid rgba(199,156,91,.65);border-radius:5px;background:var(--mo-graphite)}
.mo-vehicle__shot figcaption{position:absolute;bottom:0;left:0;right:0;margin:0;padding:24px 12px 8px;background:linear-gradient(transparent,rgba(7,7,9,.94));color:var(--mo-ivory);font-size:10px;line-height:1.5}
.mo-vehicle__features{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
.mo-vehicle__feature{display:flex;align-items:flex-start;gap:14px;padding:20px 14px;min-width:0;border:1px solid rgba(199,156,91,.46);border-radius:6px;background:linear-gradient(140deg,rgba(21,21,24,.55),rgba(7,7,9,.4))}
.mo-vehicle__feature>div{min-width:0}
.mo-vehicle__feature h3{margin:0 0 8px;font-family:inherit;font-size:14px;font-weight:600;line-height:1.35;letter-spacing:-.015em;color:var(--mo-ivory)}
.mo-vehicle__feature p{margin:0;color:var(--mo-muted-light);font-size:12px;line-height:1.6}
.mo-vehicle__feature .mo-icon{--mo-icon-size:32px}
.mo-vehicle__status{display:block;margin-top:10px;color:var(--mo-champagne);font-size:10px;line-height:1.5;font-weight:600}
.mo-vehicle__footnotes{display:flex;justify-content:space-between;gap:32px;margin-top:18px}
.mo-vehicle__footnotes p{max-width:630px;margin:0;color:var(--mo-muted);font-size:11px;line-height:1.6}
.mo-vehicle__footnotes a{color:var(--mo-muted-light);text-decoration:underline;text-underline-offset:3px}
.mo-vehicle__footnotes a:focus-visible{outline:2px solid var(--mo-champagne);outline-offset:4px}
.mo-vehicle__sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
@media(min-width:1500px){.mo-vehicle__lead{min-height:460px}.mo-vehicle__copy{font-size:17px}.mo-vehicle__attributes li{font-size:12px;padding:0 16px}.mo-vehicle__feature .mo-icon{--mo-icon-size:42px}}
@media(min-width:781px) and (max-width:1100px){.mo-vehicle__lead{min-height:400px}.mo-vehicle__visual{width:61%;top:24px}.mo-vehicle__attributes{width:70%}.mo-vehicle__features{grid-template-columns:repeat(3,minmax(0,1fr))}.mo-vehicle__feature .mo-icon{--mo-icon-size:42px}.mo-vehicle__title{font-size:40px}.mo-vehicle__copy{font-size:14px}}
@media(max-width:780px){
 .mo-vehicle--desktop{display:none}
 .mo-vehicle--mobile{display:block;padding:48px 0 36px}
 .mo-vehicle__shell{max-width:720px;padding:0 22px}
 .mo-vehicle__lead{min-height:0;padding:0;display:flex;flex-direction:column}
 .mo-vehicle__presentation{width:100%}
 .mo-vehicle__eyebrow{font-size:11px;letter-spacing:.18em;margin-bottom:20px}
 .mo-vehicle__title{font-size:clamp(34px,8.5vw,52px);line-height:1.05}
 .mo-vehicle__identity{font-size:16px;margin-top:20px}
 .mo-vehicle__copy{font-size:15px;line-height:1.7;max-width:none}
 .mo-vehicle__visual{position:relative;top:auto;right:auto;width:calc(100% + 44px);margin:24px -22px 0;mask-image:none}
 .mo-vehicle__attributes{width:100%;grid-template-columns:repeat(2,minmax(0,1fr));margin:16px 0 24px;padding:0}
 .mo-vehicle__attributes li{padding:12px 14px;font-size:12px;gap:12px;min-height:64px}
 .mo-vehicle__attributes li+li{border-left:0}
 .mo-vehicle__attributes li:nth-child(even){border-left:1px solid rgba(199,156,91,.3)}
 .mo-vehicle__attributes li:nth-child(n+3){border-top:1px solid rgba(199,156,91,.3)}
 .mo-vehicle__attributes li:last-child{grid-column:1/-1}
 .mo-vehicle__gallery{grid-template-columns:1fr;gap:12px;margin-bottom:20px}
 .mo-vehicle__shot figcaption{font-size:11px;padding:24px 12px 8px}
 .mo-vehicle__features{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
 .mo-vehicle__feature{flex-direction:column;gap:14px;padding:18px 14px}
 .mo-vehicle__feature .mo-icon{--mo-icon-size:32px}
 .mo-vehicle__feature h3{font-size:15px;line-height:1.4}
 .mo-vehicle__feature p{font-size:13px;line-height:1.6}
 .mo-vehicle__status{font-size:11px}
 .mo-vehicle__footnotes{display:block;margin-top:24px}
 .mo-vehicle__footnotes p{font-size:12px;line-height:1.65}
 .mo-vehicle__footnotes p+p{margin-top:12px}
}
@media(min-width:600px) and (max-width:780px){.mo-vehicle__gallery{grid-template-columns:repeat(3,minmax(0,1fr))}.mo-vehicle__features{grid-template-columns:repeat(3,minmax(0,1fr))}}
