/* Vehicle profile only. Existing hero and global styles remain unchanged. */
.mo-vehicle{background:var(--mo-ivory);color:var(--mo-ink);padding:clamp(64px,7vw,104px) 0;font-family:inherit}
.mo-vehicle--mobile{display:none}
.mo-vehicle__shell{max-width:1440px;margin:0 auto;padding:0 clamp(18px,3.2vw,48px)}
.mo-vehicle__intro{display:grid;grid-template-columns: .85fr 1.15fr;gap:clamp(32px,5vw,72px);align-items:center}
.mo-vehicle__presentation{min-width:0}
.mo-vehicle__eyebrow{margin:0 0 20px;color:#947546;font-size:12px;font-weight:650;letter-spacing:.16em;text-transform:uppercase;line-height:1.5}
.mo-vehicle__title{margin:0;max-width:520px;font-family:inherit;font-size:clamp(36px,3.9vw,56px);font-weight:550;letter-spacing:-.045em;line-height:1.06}
.mo-vehicle__identity{margin:24px 0 16px;font-size:17px;font-weight:650;line-height:1.5}
.mo-vehicle__copy{margin:0;max-width:510px;color:#515154;font-size:16px;line-height:1.7}
.mo-vehicle__figure{min-width:0;margin:0}
.mo-vehicle__image{display:block;width:100%;height:auto;aspect-ratio:1672/941;object-fit:contain;background:var(--mo-night)}
.mo-vehicle__caption{margin:12px 0 0;color:#606063;font-size:11.5px;line-height:1.5}
.mo-vehicle__details{margin-top:56px;padding-top:28px;border-top:1px solid rgba(21,21,24,.2)}
.mo-vehicle__label{margin:0 0 24px;font-family:inherit;font-size:13px;font-weight:650;letter-spacing:.1em;text-transform:uppercase;line-height:1.5}
.mo-vehicle__features{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px;margin:0}
.mo-vehicle__feature dt{margin:0 0 10px;font-size:18px;font-weight:600;line-height:1.3;letter-spacing:-.015em}
.mo-vehicle__feature dd{margin:0;font-size:14px;line-height:1.65;color:#515154}
.mo-vehicle__source{margin:24px 0 0;color:#606063;font-size:11.5px;line-height:1.6}
.mo-vehicle__source a{color:inherit;text-decoration:underline;text-underline-offset:3px}
.mo-vehicle__source a:focus-visible{outline:2px solid var(--mo-ink);outline-offset:4px}
.mo-vehicle__care{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(32px,5vw,72px);margin-top:40px;padding-top:36px;border-top:1px solid rgba(21,21,24,.2)}
.mo-vehicle__care .mo-vehicle__eyebrow{margin-bottom:12px}
.mo-vehicle__care-title{margin:0;max-width:360px;font-family:inherit;font-size:30px;line-height:1.15;font-weight:550;letter-spacing:-.03em}
.mo-vehicle__care-items{display:grid;grid-template-columns:1fr 1fr;gap:16px 32px;min-width:0}
.mo-vehicle__care-item h4{font-family:inherit;margin:0 0 8px;font-size:16px;font-weight:600;line-height:1.4}
.mo-vehicle__care-item p{margin:0;color:#515154;font-size:14px;line-height:1.65}
.mo-vehicle__note{grid-column:1/-1;margin:0;color:#606063;font-size:11.5px;line-height:1.6}
.mo-vehicle__sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
@media(max-width:1000px) and (min-width:781px){.mo-vehicle__intro{grid-template-columns:1fr 1fr;gap:32px}.mo-vehicle__features{gap:24px}.mo-vehicle__care{grid-template-columns:1fr 1fr;gap:32px}}
@media(max-width:780px){
 .mo-vehicle--desktop{display:none}
 .mo-vehicle--mobile{display:block;padding:64px 0}
 .mo-vehicle__shell{padding:0 22px;max-width:640px}
 .mo-vehicle__intro{display:flex;flex-direction:column;gap:28px;align-items:stretch}
 .mo-vehicle__eyebrow{font-size:11px;letter-spacing:.12em;margin-bottom:16px}
 .mo-vehicle__title{font-size:clamp(36px,8vw,48px);max-width:460px}
 .mo-vehicle__identity{margin:20px 0 12px;font-size:16px}
 .mo-vehicle__copy{max-width:none;font-size:15px;line-height:1.7}
 .mo-vehicle__details{margin-top:36px;padding-top:24px}
 .mo-vehicle__features{grid-template-columns:1fr 1fr;gap:28px 22px}
 .mo-vehicle__feature dt{font-size:17px}
 .mo-vehicle__feature dd{font-size:14px}
 .mo-vehicle__care{grid-template-columns:1fr;gap:24px;margin-top:32px;padding-top:28px}
 .mo-vehicle__care-title{font-size:28px}
 .mo-vehicle__care-items{grid-template-columns:1fr;gap:22px}
 .mo-vehicle__caption,.mo-vehicle__source,.mo-vehicle__note{font-size:12px}
}
