/* New-car profile: scoped to the operator's supplied dark visual reference. */
.mo-vehicle{position:relative;isolation:isolate;overflow:hidden;background:var(--mo-night);color:var(--mo-ivory);padding:0 0 40px;font-family:inherit;border-top:1px solid rgba(243,239,228,.06)}
.mo-vehicle__shell{container-type:inline-size}
.mo-vehicle--mobile{display:none}
/* The shared .container owns width and gutters, exactly as Services. */
.mo-vehicle__lead{position:relative;min-height:31.088cqw;padding:4.2cqw 0 1.4cqw 1.669cqw;display:flex;flex-direction:column;justify-content:flex-start}
.mo-vehicle__presentation{position:relative;z-index:2;width:45cqw;min-width:0}
.mo-vehicle__eyebrow{display:flex;align-items:center;gap:20px;margin:0 0 1.15cqw;color:var(--mo-champagne);font-size:12px;font-weight:650;letter-spacing:.22em;text-transform:uppercase;line-height:1.5}
.mo-vehicle__eyebrow>span{flex:1;height:1px;background:linear-gradient(90deg,var(--mo-champagne),transparent)}
.mo-vehicle__title{margin:0;font-family:inherit;font-stretch:75%;font-size:clamp(40px,4.65cqw,66px);font-weight:700;letter-spacing:-.025em;line-height:1.04;text-transform:uppercase}
.mo-vehicle__title>span{color:var(--mo-champagne)}
.mo-vehicle__identity{margin:20px 0 10px;color:var(--mo-ivory);font-size:16px;font-weight:650;line-height:1.5}
.mo-vehicle__copy{margin:.8cqw 0 0;color:var(--mo-muted-light);font-size:clamp(15px,1.15cqw,18px);line-height:1.55;max-width:640px}
.mo-vehicle__copy strong{font-weight:600;color:var(--mo-ivory)}
.mo-vehicle__visual{position:absolute;z-index:0;right:0;top:0;width:56.551298%;margin:0;pointer-events:none;mask-image:linear-gradient(90deg,transparent 0%,#000 8%,#000 100%)}
.mo-vehicle__crop{position:relative;overflow:hidden;aspect-ratio:var(--mo-crop-w)/var(--mo-crop-h);background:var(--mo-night)}
.mo-vehicle__crop img{position:absolute;display:block;max-width:none;width:calc(1672 / var(--mo-crop-w) * 100%);height:auto;left:calc(-1 * var(--mo-crop-x) / var(--mo-crop-w) * 100%);top:0;transform:translateY(calc(-1 * var(--mo-crop-y) / 941 * 100%))}
.mo-vehicle__crop--main{--mo-crop-x:730;--mo-crop-y:0;--mo-crop-w:915;--mo-crop-h:496;clip-path:polygon(0 0,100% 0,100% 100%,8.74317% 100%,8.74317% 78.62904%,0 78.62904%)}
.mo-vehicle__crop--rear{--mo-crop-x:29;--mo-crop-y:505;--mo-crop-w:537;--mo-crop-h:262}
.mo-vehicle__crop--interior{--mo-crop-x:582;--mo-crop-y:505;--mo-crop-w:563;--mo-crop-h:262}
.mo-vehicle__crop--detail{--mo-crop-x:1160;--mo-crop-y:505;--mo-crop-w:483;--mo-crop-h:262}
.mo-vehicle__attributes{position:relative;z-index:2;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));width:46.48cqw;list-style:none;margin:1.5cqw 0 0;padding:14px 0;border:1px solid rgba(199,156,91,.65);border-radius:7px;background:rgba(7,7,9,.86)}
.mo-vehicle__attributes li{display:flex;align-items:center;gap:8px;padding:0 12px;font-size:12px;line-height:1.45;color:var(--mo-muted-light);min-width:0}
.mo-vehicle__attributes li+li{border-left:1px solid rgba(199,156,91,.3)}
.mo-vehicle__attributes strong{font-weight:600;color:var(--mo-ivory)}
.mo-vehicle__gallery{position:relative;z-index:2;display:grid;grid-template-columns:541fr 567fr 487fr;gap:12px;margin:0 0 16px}
.mo-vehicle__shot{position:relative;min-width:0;overflow:hidden;margin:0;border:1px solid rgba(199,156,91,.65);border-radius:5px;background:var(--mo-graphite)}
.mo-vehicle__shot figcaption{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;margin:-1px;padding:0}
.mo-vehicle__features{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
.mo-vehicle__feature{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;min-width:0;border:1px solid rgba(199,156,91,.46);border-radius:6px;background:linear-gradient(140deg,rgba(21,21,24,.55),rgba(7,7,9,.4))}
.mo-vehicle__feature>div{min-width:0}
.mo-vehicle__feature h3{margin:0 0 6px;font-family:inherit;font-size:13px;font-weight:600;line-height:1.35;letter-spacing:-.015em;color:var(--mo-ivory)}
.mo-vehicle__feature p{margin:0;color:var(--mo-muted-light);font-size:12px;line-height:1.5}
.mo-vehicle__feature .mo-icon{--mo-icon-size:42px}
.mo-vehicle__status{display:block;margin-top:10px;color:var(--mo-champagne);font-size:10px;line-height:1.5;font-weight:600}
.mo-vehicle__footnotes{display:flex;justify-content:space-between;gap:32px;margin-top:18px}
.mo-vehicle__footnotes p{max-width:630px;margin:0;color:var(--mo-muted);font-size:11px;line-height:1.6}
.mo-vehicle__footnotes a{color:var(--mo-muted-light);text-decoration:underline;text-underline-offset:3px}
.mo-vehicle__footnotes a:focus-visible{outline:2px solid var(--mo-champagne);outline-offset:4px}
.mo-vehicle__sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}

@media(min-width:781px) and (max-width:1100px){
 .mo-vehicle__lead{display:grid;grid-template-columns:1fr 1fr;gap:24px;min-height:0;padding:36px 0 24px}
 .mo-vehicle__presentation{width:100%}
 .mo-vehicle__visual{position:relative;grid-column:2;grid-row:1;align-self:center;width:100%;top:auto;right:auto;margin-top:-36px}
 .mo-vehicle__title{font-size:clamp(34px,4.2cqw,42px)}
 .mo-vehicle__copy{font-size:14px;margin-top:18px}
 .mo-vehicle__eyebrow{margin-bottom:20px;font-size:11px;gap:12px}
 .mo-vehicle__attributes{grid-column:1/-1;width:100%;margin:0}
 .mo-vehicle__features{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:780px){
 .mo-vehicle--desktop{display:none}
 .mo-vehicle--mobile{display:block;padding:48px 0 36px}
 .mo-vehicle__shell.container{max-width:none;padding:0 18px}
 .mo-vehicle__lead{min-height:0;padding:0;display:flex;flex-direction:column}
 .mo-vehicle__presentation{width:100%}
 .mo-vehicle__eyebrow{font-size:11px;letter-spacing:.18em;margin-bottom:20px}
 .mo-vehicle__title{font-size:clamp(34px,8.5vw,52px);line-height:1.05}
 .mo-vehicle__identity{font-size:16px;margin-top:20px}
 .mo-vehicle__copy{font-size:15px;line-height:1.7;max-width:none;margin-top:20px}
 .mo-vehicle__visual{position:relative;top:auto;right:auto;width:100%;margin:24px 0 0;mask-image:none}.mo-vehicle__crop--main{--mo-crop-x:806;--mo-crop-w:866;clip-path:none}
 .mo-vehicle__attributes{width:100%;grid-template-columns:repeat(2,minmax(0,1fr));margin:16px 0 24px;padding:0}
 .mo-vehicle__attributes li{padding:12px 14px;font-size:12px;gap:12px;min-height:64px}
 .mo-vehicle__attributes li+li{border-left:0}
 .mo-vehicle__attributes li:nth-child(even){border-left:1px solid rgba(199,156,91,.3)}
 .mo-vehicle__attributes li:nth-child(n+3){border-top:1px solid rgba(199,156,91,.3)}
 .mo-vehicle__attributes li:last-child{grid-column:1/-1}
 .mo-vehicle__gallery{grid-template-columns:1fr;gap:12px;margin-bottom:20px}
 .mo-vehicle__features{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
 .mo-vehicle__feature{flex-direction:column;gap:12px;padding:16px 14px}
 .mo-vehicle__feature .mo-icon{--mo-icon-size:32px}
 .mo-vehicle__feature h3{font-size:15px;line-height:1.4}
 .mo-vehicle__feature p{font-size:13px;line-height:1.6}
 .mo-vehicle__status{font-size:11px}
 .mo-vehicle__footnotes{display:block;margin-top:24px}
 .mo-vehicle__footnotes p{font-size:12px;line-height:1.65}
 .mo-vehicle__footnotes p+p{margin-top:12px}
}
@media(min-width:600px) and (max-width:780px){.mo-vehicle__gallery{grid-template-columns:repeat(3,minmax(0,1fr))}.mo-vehicle__features{grid-template-columns:repeat(3,minmax(0,1fr))}}
