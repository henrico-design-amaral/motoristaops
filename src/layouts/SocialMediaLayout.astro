---
import '../styles/global.css';
import '../styles/socialmedia.css';
const { title = 'MotoristaOPS · Social Media Control Center' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MotoristaOPS Social Media Control Center: planejamento, publicação, performance e aprendizados." />
    <meta name="theme-color" content="#070709" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="social-app">
    <slot />
  </body>
</html>
