---
import '../styles/global.css';
import '../styles/dashboard-control.css';
import '../styles/dashboard-mobile.css';
import '../styles/dashboard-visual-v2.css';
import '../styles/dashboard-visual-v2-mobile.css';
import '../styles/module-shell.css';
import AppTabs from '../components/AppTabs.astro';
const { title = 'MotoristaOps' } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const relativePath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname.replace(/^\//,'');
const firstSegment = relativePath.split('/').filter(Boolean)[0] || '';
const operationalRoutes = new Set(['','painel','transito','previsao','inteligencia','contexto','fontes-contexto','importar-uber','historico-importacoes','fechamento','copiloto']);
const isOperational = operationalRoutes.has(firstSegment);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="MotoristaOps: presença pública e painel de controle da operação de motorista." />
    <meta name="theme-color" content="#0B0C0D" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class:list={{'app-operational':isOperational}}>
    {isOperational && <AppTabs />}
    <slot />
  </body>
</html>