---
import { driverProfile as profile } from '../data/driver-profile';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${baseUrl}${path.replace(/^\//, '')}`;

const whatsappUrl = new URL(profile.whatsapp);
whatsappUrl.searchParams.set('text', 'Olá, Henrico. Gostaria de solicitar um orçamento.\n\nData:\nHorário:\nOrigem:\nDestino:\nPassageiros:\nBagagem/observações:');
const whatsapp = whatsappUrl.toString();

const benefits = [
  ['01', 'É compromisso.', 'O planejamento começa antes do percurso e termina na hora combinada.'],
  ['02', 'Comunicação clara.', 'Combinamos o trajeto, o ritmo e o que precisa ser considerado antes da saída.'],
  ['03', 'Cuidado no trajeto.', 'Rota, bagagem, espera e contexto entram na leitura do atendimento.'],
  ['04', 'Discrição.', 'Presença profissional sem exposição. O contexto define a postura.']
] as const;

const services = [
  ['01', 'Aeroportos e rodoviárias', 'Ida e chegada com horário planejado, bagagem no trajeto e atenção ao compromisso.', 'Voos, embarques, conexões e chegadas.'],
  ['02', 'Reuniões e compromissos', 'Deslocamento com hora marcada, leitura de contexto e atenção aos detalhes do tempo.', 'Reuniões, consultas e agendas importantes.'],
  ['03', 'Eventos', 'Chegada e saída alinhadas antes para reduzir improvisos no momento crítico.', 'Eventos sociais, profissionais e culturais.'],
  ['04', 'Viagens e deslocamentos', 'Trajetos particulares fora da rotina com percurso e condições combinadas.', 'Bate-voltas e viagens previamente alinhadas.'],
  ['05', 'Espera e acompanhamento', 'Quando contratado, mantenho uma presença discreta dentro da mesma demanda.', 'Compromissos com espera ou retorno combinado.'],
  ['06', 'Rotinas personalizadas', 'Agenda recorrente com previsibilidade, contexto e continuidade de atendimento.', 'Rotinas profissionais, pessoais e familiares.']
] as const;

const advance = [
  ['01', 'Disponibilidade', 'O horário é reservado antes, com clareza sobre origem, destino e contexto.'],
  ['02', 'Rota pensada', 'Tempo, trânsito, distância, espera e possíveis paradas entram no planejamento.'],
  ['03', 'Menos ruído', 'Valor, horário, forma de atendimento e detalhes importantes ficam alinhados antes.'],
  ['04', 'Mais tranquilidade', 'Você segue para o compromisso sem resolver o deslocamento em cima da hora.']
] as const;

const process = [
  ['01', 'Você chama', 'Passa data, horário, origem, destino e o que precisa ser considerado.'],
  ['02', 'Alinhamos o trajeto', 'Rota, tempo, paradas, espera e detalhes importantes ficam claros antes da confirmação.'],
  ['03', 'Você confirma', 'Valor, condições e apontamentos são confirmados pelo canal oficial.'],
  ['04', 'Eu cuido do trajeto', 'O serviço acontece conforme o combinado, com comunicação e atenção ao contexto.']
] as const;

const quality = [
  ['Discrição', 'Presença profissional com reserva e respeito ao contexto.'],
  ['Pontualidade', 'Compromisso com o horário combinado e com o tempo.'],
  ['Comunicação', 'Informações claras antes, durante e depois do percurso.'],
  ['Cuidado', 'Atenção com bagagem, pertences e preferências do trajeto.'],
  ['Continuidade', 'Atendimento recorrente com consistência e adaptação.']
] as const;

const behaviors = [
  ['01', 'Rotina real', 'A leitura vem da prática: horários, trânsito, espera, bagagem, compromisso e contexto.'],
  ['02', 'Comunicação sem ruído', 'O combinado fica claro antes. Mudanças são tratadas sem improviso.'],
  ['03', 'Pontualidade com método', 'Horário certo depende de rota, margem, trânsito e ritmo do compromisso.'],
  ['04', 'Discrição e cuidado', 'O atendimento acompanha o contexto sem exposição desnecessária.']
] as const;
---

<div class="mops-page" data-build="motoristaops-landing-v4">
  <header class="mops-header" data-header>
    <div class="mops-shell mops-header__inner">
      <a class="mops-brand" href="#inicio" aria-label="MotoristaOPS — início">
        <img src={asset('landing-v3/logo-header-v3.svg')} alt="MotoristaOPS" width="293" height="96" />
      </a>

      <nav class="mops-nav" aria-label="Navegação principal">
        <a href="#servicos">Serviços</a>
        <a href="#por-que-combinar">Por que combinar</a>
        <a href="#como-funciona">Como funciona</a>
        <a href="#quem-dirige">Quem dirige</a>
      </nav>

      <a class="mops-header__cta" href={whatsapp}>Solicitar orçamento</a>
    </div>
  </header>

  <main>
    <section class="mops-hero" id="inicio" aria-labelledby="hero-title">
      <img
        class="mops-hero__media"
        src={asset('landing-v3/hero-motoristaops-v4.webp')}
        alt=""
        width="2048"
        height="868"
        fetchpriority="high"
        decoding="async"
      />
      <div class="mops-hero__veil" aria-hidden="true"></div>
      <div class="mops-hero__grid" aria-hidden="true"></div>

      <div class="mops-shell mops-hero__inner">
        <div class="mops-hero__copy">
          <p class="mops-eyebrow mops-reveal">Motorista particular em São Paulo <span>•</span> atendimento com hora marcada</p>
          <h1 id="hero-title" class="mops-reveal" style="--delay: 100ms">
            <span>Seu compromisso</span>
            <span>começa antes</span>
            <em>do destino.</em>
          </h1>
          <p class="mops-hero__lead mops-reveal" style="--delay: 180ms">Corridas particulares para aeroportos, reuniões, consultas, eventos e viagens — com planejamento, comunicação direta, discrição e cuidado do início ao fim.</p>

          <div class="mops-actions mops-reveal" style="--delay: 260ms">
            <a class="mops-button mops-button--primary" href={whatsapp}>Solicitar orçamento no WhatsApp</a>
            <a class="mops-button mops-button--ghost" href="#como-funciona">Entender como funciona <span aria-hidden="true">→</span></a>
          </div>
          <p class="mops-trust-note mops-reveal" style="--delay: 340ms">Atendimento direto com Henrico Amaral. Confirmação pelo canal oficial.</p>
        </div>
      </div>

      <svg class="mops-route mops-route--hero" viewBox="0 0 1200 150" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 104C145 64 249 127 374 93C510 56 572 19 711 53C831 83 883 130 1010 91C1082 68 1130 38 1200 27" />
        <circle cx="374" cy="93" r="4" />
        <circle cx="1010" cy="91" r="4" />
      </svg>
    </section>

    <section class="mops-benefits" aria-label="Diferenciais do atendimento">
      <div class="mops-shell mops-benefits__grid">
        {benefits.map(([number, title, description], index) => (
          <article class="mops-benefit mops-reveal" style={`--delay:${index * 70}ms`}>
            <span class="mops-index">{number}</span>
            <div><h2>{title}</h2><p>{description}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="mops-section mops-services" id="servicos">
      <div class="mops-shell">
        <div class="mops-section-head mops-reveal">
          <div>
            <p class="mops-kicker">O que ofereço</p>
            <h2>Para compromissos que pedem mais controle do trajeto.</h2>
          </div>
          <p>Você informa o contexto. O deslocamento é pensado nos detalhes que realmente mudam o atendimento: horário, rota, espera, bagagem, paradas e ritmo do compromisso.</p>
        </div>

        <div class="mops-services__grid">
          {services.map(([number, title, description, idealFor], index) => (
            <article class="mops-service-card mops-reveal" style={`--delay:${(index % 3) * 70}ms`}>
              <span class="mops-index">{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
              <small><strong>Ideal para:</strong> {idealFor}</small>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mops-section mops-advance" id="por-que-combinar">
      <div class="mops-shell mops-advance__layout">
        <div class="mops-advance__intro mops-reveal">
          <p class="mops-kicker">Por que combinar antes</p>
          <h2>Porque compromisso com hora marcada não deve depender de improviso.</h2>
          <p>Antecedência não é cerimônia. É o que permite reservar horário, entender o contexto e reduzir decisões em cima da hora.</p>
        </div>

        <div class="mops-advance__track" data-route-track>
          <div class="mops-advance__line" aria-hidden="true"><span></span></div>
          {advance.map(([number, title, description], index) => (
            <article class="mops-advance__step mops-reveal" style={`--delay:${index * 80}ms`}>
              <span class="mops-node">{number}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mops-section mops-process" id="como-funciona">
      <div class="mops-shell mops-process__layout">
        <div class="mops-process__intro mops-reveal">
          <p class="mops-kicker">Como funciona</p>
          <h2>Direto, suficiente e detalhado para evitar ruído.</h2>
          <p>O contato começa pela troca direta. Depois, necessidade, condições e apontamentos ficam alinhados antes da execução.</p>
        </div>

        <div class="mops-timeline" data-timeline>
          <span class="mops-timeline__rail" aria-hidden="true"><i></i></span>
          {process.map(([number, title, description]) => (
            <article class="mops-timeline__step" data-step>
              <span class="mops-timeline__number">{number}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mops-section mops-quality">
      <div class="mops-shell">
        <div class="mops-section-head mops-section-head--compact mops-reveal">
          <div>
            <p class="mops-kicker">Qualidade operacional</p>
            <h2>Critérios que aparecem no atendimento.</h2>
          </div>
          <p>Mais do que dirigir, o serviço depende de leitura de contexto, comunicação e presença calma no momento certo.</p>
        </div>

        <div class="mops-quality__list">
          {quality.map(([title, description], index) => (
            <article class="mops-quality__row mops-reveal" style={`--delay:${index * 55}ms`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mops-section mops-behavior" aria-labelledby="behavior-title">
      <div class="mops-shell">
        <div class="mops-section-head mops-section-head--light mops-reveal">
          <div>
            <p class="mops-kicker">Experiência e diferenciais</p>
            <h2 id="behavior-title">O valor aparece no jeito de trabalhar.</h2>
          </div>
          <p>Menos adjetivo. Mais comportamento que pode ser percebido no atendimento.</p>
        </div>

        <div class="mops-behavior__grid">
          {behaviors.map(([number, title, description], index) => (
            <article class="mops-behavior__card mops-reveal" style={`--delay:${index * 65}ms`}>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mops-section mops-driver" id="quem-dirige">
      <div class="mops-shell mops-driver__layout">
        <figure class="mops-driver__photo mops-reveal">
          <img src={asset('landing-v3/henrico-amaral-v4.webp')} alt="Henrico Amaral, motorista particular" width="848" height="1272" loading="lazy" decoding="async" />
        </figure>

        <div class="mops-driver__copy mops-reveal" style="--delay:80ms">
          <p class="mops-kicker">Quem dirige</p>
          <h2>Henrico Amaral.</h2>
          <p class="mops-driver__lead">O serviço leva meu nome porque a responsabilidade também é minha.</p>
          <p>Motorista particular em São Paulo. Atendimento direto, com hora marcada, comunicação clara, pontualidade, discrição e atenção ao contexto de cada compromisso.</p>
          <blockquote>“{profile.slogan}”</blockquote>
        </div>

        <aside class="mops-driver__facts mops-reveal" style="--delay:160ms" aria-label="Informações de confiança">
          <div><span>Avaliação na Uber</span><strong>{profile.uberRating}</strong></div>
          <div><span>Atendimento</span><strong>Direto</strong></div>
          <div><span>Região</span><strong>São Paulo</strong></div>
          <a href={profile.google} target="_blank" rel="noreferrer">Ver presença no Google <span aria-hidden="true">↗</span></a>
        </aside>
      </div>
    </section>

    <section class="mops-final-cta" aria-labelledby="cta-title">
      <svg class="mops-route mops-route--cta" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 146C145 103 226 174 356 141C498 104 556 43 714 83C852 118 927 194 1048 126C1112 90 1152 70 1200 64" />
        <circle cx="356" cy="141" r="4" />
        <circle cx="1048" cy="126" r="4" />
      </svg>
      <div class="mops-shell mops-final-cta__inner mops-reveal">
        <p class="mops-kicker">Próximo trajeto</p>
        <h2 id="cta-title">Precisa combinar um trajeto?<br /><em>Fale comigo pelo WhatsApp.</em></h2>
        <p>Envie data, horário, origem, destino e qualquer detalhe importante. A partir disso, alinhamos rota, condições e confirmação pelo canal oficial.</p>
        <a class="mops-button mops-button--primary" href={whatsapp}>Chamar no WhatsApp</a>
      </div>
    </section>
  </main>

  <footer class="mops-footer">
    <div class="mops-shell mops-footer__grid">
      <a class="mops-brand mops-brand--footer" href="#inicio" aria-label="MotoristaOPS — voltar ao início">
        <img src={asset('landing-v3/logo-header-v3.svg')} alt="MotoristaOPS" width="293" height="96" loading="lazy" />
      </a>
      <div>
        <strong>Serviços</strong>
        <a href="#servicos">Aeroportos</a>
        <a href="#servicos">Reuniões</a>
        <a href="#servicos">Eventos</a>
        <a href="#servicos">Viagens</a>
      </div>
      <div>
        <strong>Navegação</strong>
        <a href="#por-que-combinar">Por que combinar</a>
        <a href="#como-funciona">Como funciona</a>
        <a href="#quem-dirige">Quem dirige</a>
      </div>
      <div>
        <strong>Contato</strong>
        <a href={whatsapp}>WhatsApp</a>
        <a href={profile.instagram} target="_blank" rel="noreferrer">Instagram</a>
        <a href={profile.google} target="_blank" rel="noreferrer">Google</a>
      </div>
    </div>
    <div class="mops-shell mops-footer__bottom">
      <span>© 2026 MotoristaOPS por Henrico Amaral.</span>
      <span>{profile.slogan}</span>
    </div>
  </footer>

  <a class="mops-mobile-whatsapp" href={whatsapp} aria-label="Solicitar orçamento no WhatsApp">WhatsApp</a>
</div>

<script>
  const pageRoot = document.querySelector('.mops-page');
  pageRoot?.classList.add('mops-js');

  const header = document.querySelector('[data-header]');
  const updateHeader = () => header?.toggleAttribute('data-scrolled', window.scrollY > 16);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  const revealObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('is-visible');
      observer.unobserve(entry.target);
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });

  document.querySelectorAll('.mops-reveal').forEach((element) => revealObserver.observe(element));

  const timeline = document.querySelector('[data-timeline]');
  const steps = [...document.querySelectorAll('[data-step]')];
  const stepObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) entry.target.classList.add('is-active');
    });
    const activeCount = steps.filter((step) => step.classList.contains('is-active')).length;
    if (timeline instanceof HTMLElement) timeline.style.setProperty('--progress', `${Math.max(0, activeCount - 1) / Math.max(1, steps.length - 1) * 100}%`);
  }, { threshold: 0.45 });
  steps.forEach((step) => stepObserver.observe(step));

  const routeTrack = document.querySelector('[data-route-track]');
  if (routeTrack) {
    const routeObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-active');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.3 });
    routeObserver.observe(routeTrack);
  }
</script>

<style>
  :global(:root) {
    --mops-night: #070709;
    --mops-graphite: #151518;
    --mops-champagne: #C79C5B;
    --mops-champagne-shadow: #947546;
    --mops-ivory: #F3EFE4;
    --mops-stone: #A6A39E;
    --mops-amber: #F0B44D;
    --mops-border: rgba(199, 156, 91, .24);
    --mops-shell: 1260px;
    --mops-section-space: clamp(84px, 8vw, 132px);
    --mops-ease: cubic-bezier(.16, 1, .3, 1);
  }

  .mops-page { min-height: 100vh; overflow: clip; background: var(--mops-night); color: var(--mops-ivory); }
  .mops-shell { width: min(var(--mops-shell), calc(100% - clamp(36px, 7vw, 112px))); margin-inline: auto; }
  .mops-header { position: fixed; z-index: 100; inset: 0 0 auto; height: 82px; background: linear-gradient(180deg, rgba(7, 7, 9, .92), rgba(7, 7, 9, .6)); border-bottom: 1px solid transparent; transition: background 220ms ease, border-color 220ms ease, backdrop-filter 220ms ease; }
  .mops-header[data-scrolled] { background: rgba(7, 7, 9, .9); border-bottom-color: rgba(199, 156, 91, .2); backdrop-filter: blur(18px); }
  .mops-header__inner { height: 100%; display: flex; align-items: center; gap: 34px; }
  .mops-brand { width: clamp(178px, 15vw, 226px); flex: 0 0 auto; display: inline-flex; align-items: center; }
  .mops-brand img { display: block; width: 100%; height: auto; }
  .mops-nav { margin-left: auto; display: flex; align-items: center; gap: clamp(22px, 2.2vw, 38px); }
  .mops-nav a, .mops-footer a { text-decoration: none; }
  .mops-nav a { position: relative; color: rgba(243, 239, 228, .82); font-size: 12px; font-weight: 650; letter-spacing: .095em; text-transform: uppercase; }
  .mops-nav a::after { content: ''; position: absolute; height: 1px; left: 0; right: 100%; bottom: -9px; background: var(--mops-champagne); transition: right 180ms ease; }
  .mops-nav a:hover::after, .mops-nav a:focus-visible::after { right: 0; }
  .mops-header__cta { min-height: 44px; padding: 0 18px; display: inline-flex; align-items: center; justify-content: center; color: var(--mops-night); background: var(--mops-champagne); border: 1px solid var(--mops-champagne); text-decoration: none; font-size: 11px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; transition: transform 180ms ease, background 180ms ease; }
  .mops-header__cta:hover, .mops-header__cta:focus-visible { transform: translateY(-2px); background: var(--mops-ivory); }
  .mops-hero { position: relative; min-height: 840px; display: grid; align-items: center; overflow: hidden; isolation: isolate; border-bottom: 1px solid rgba(199, 156, 91, .16); }
  .mops-hero__media { position: absolute; z-index: -4; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 54% center; transform: scale(1.04); animation: mopsHeroIn 1200ms var(--mops-ease) forwards; }
  .mops-hero__veil { position: absolute; z-index: -3; inset: 0; background: linear-gradient(90deg, rgba(7,7,9,.98) 0%, rgba(7,7,9,.94) 29%, rgba(7,7,9,.7) 46%, rgba(7,7,9,.1) 72%), linear-gradient(180deg, rgba(7,7,9,.45), transparent 24%, transparent 68%, rgba(7,7,9,.8)); }
  .mops-hero__grid { position: absolute; z-index: -2; inset: auto 0 0; height: 31%; opacity: .16; background-image: linear-gradient(rgba(199,156,91,.12) 1px, transparent 1px), linear-gradient(90deg, rgba(199,156,91,.09) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to top, #000, transparent 88%); }
  .mops-hero__inner { width: min(var(--mops-shell), calc(100% - clamp(36px, 7vw, 112px))); min-height: 840px; padding: 120px 0 86px; display: flex; align-items: center; }
  .mops-hero__copy { width: min(650px, 52vw); }
  .mops-eyebrow, .mops-kicker { margin: 0 0 22px; color: var(--mops-champagne); font-size: 12px; line-height: 1.35; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .mops-eyebrow span { color: var(--mops-amber); margin-inline: .4em; }
  .mops-hero h1 { margin: 0; max-width: 640px; color: var(--mops-ivory); font-size: clamp(55px, 5.3vw, 88px); font-weight: 700; line-height: .94; letter-spacing: -.048em; text-transform: uppercase; }
  .mops-hero h1 span, .mops-hero h1 em { display: block; font-style: normal; }
  .mops-hero h1 em { color: var(--mops-champagne); }
  .mops-hero__lead { margin: 30px 0 0; max-width: 570px; color: rgba(243, 239, 228, .78); font-size: clamp(16px, 1.45vw, 19px); line-height: 1.65; }
  .mops-actions { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 12px; }
  .mops-button { min-height: 49px; padding: 0 20px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; border: 1px solid var(--mops-border); text-decoration: none; font-size: 11px; font-weight: 750; letter-spacing: .07em; text-transform: uppercase; transition: transform 220ms var(--mops-ease), box-shadow 220ms ease, background 220ms ease, border-color 220ms ease; }
  .mops-button:hover, .mops-button:focus-visible { transform: translateY(-2px); }
  .mops-button--primary { color: var(--mops-night); background: var(--mops-champagne); border-color: var(--mops-champagne); }
  .mops-button--primary:hover, .mops-button--primary:focus-visible { background: var(--mops-ivory); border-color: var(--mops-ivory); box-shadow: 0 0 0 6px rgba(199, 156, 91, .08); }
  .mops-button--ghost { color: var(--mops-ivory); background: rgba(7,7,9,.28); }
  .mops-button--ghost:hover, .mops-button--ghost:focus-visible { border-color: rgba(199, 156, 91, .62); background: rgba(21,21,24,.58); }
