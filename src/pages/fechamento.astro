---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="MotoristaOPS · Fechamento do dia">
<main class="close-shell">
  <header class="close-head"><div><p class="eyebrow">Fechamento do dia</p><h1>Consolidar operação.</h1><p>Complete horas, quilômetros, corridas, receitas e custos. O MotoristaOPS calcula o resultado antes de salvar.</p></div><div class="close-state"><span id="close-auth-state">verificando sessão</span></div></header>

  <section id="close-login" class="login-panel" hidden>
    <div><strong>Acesso necessário</strong><p>Use seu e-mail para receber um link de acesso. O fechamento só é gravado na sua conta autenticada.</p></div>
    <form id="close-login-form"><input type="email" name="email" required placeholder="seu@email.com" autocomplete="email"><button type="submit">Enviar link</button></form>
  </section>

  <form id="day-close-form" class="close-grid" hidden>
    <section class="form-panel core"><div class="panel-title"><span>01</span><h2>Operação</h2></div><div class="fields three"><label>Data<input name="operation_date" type="date" required></label><label>Turno<select name="shift"><option value="">—</option><option>Manhã</option><option>Tarde</option><option>Noite</option><option>Madrugada</option><option>Dia inteiro</option></select></label><label>Plataforma principal<select name="primary_platform"><option>Uber</option><option>Uber + 99</option><option>Uber + Particular</option><option>Uber + 99 + Particular</option><option>Particular</option></select></label></div><div class="fields four"><label>Horas online<input name="hours_online" type="number" min="0" step="0.01" required></label><label>Horas em corrida<input name="hours_in_ride" type="number" min="0" step="0.01"></label><label>KM total<input name="km_total" type="number" min="0" step="0.1" required></label><label>KM passageiro<input name="km_passenger" type="number" min="0" step="0.1"></label></div></section>

    <section class="form-panel"><div class="panel-title"><span>02</span><h2>Corridas e receita</h2></div><div class="fields three"><label>Corridas Uber<input name="trips_uber" type="number" min="0" step="1" value="0"></label><label>Corridas 99<input name="trips_99" type="number" min="0" step="1" value="0"></label><label>Corridas Particular<input name="trips_private" type="number" min="0" step="1" value="0"></label></div><div class="fields four"><label>Uber R$<input name="revenue_uber" type="number" min="0" step="0.01" value="0"></label><label>99 R$<input name="revenue_99" type="number" min="0" step="0.01" value="0"></label><label>Particular R$<input name="revenue_private" type="number" min="0" step="0.01" value="0"></label><label>Gorjetas/extras R$<input name="tips_extras" type="number" min="0" step="0.01" value="0"></label></div></section>

    <section class="form-panel"><div class="panel-title"><span>03</span><h2>Custos</h2></div><div class="fields four"><label>Combustível R$<input name="fuel_cost" type="number" min="0" step="0.01" value="0"></label><label>Alimentação R$<input name="food_cost" type="number" min="0" step="0.01" value="0"></label><label>Lavagem R$<input name="wash_cost" type="number" min="0" step="0.01" value="0"></label><label>Outros R$<input name="other_operational_cost" type="number" min="0" step="0.01" value="0"></label></div><div class="fields two"><label>Consumo km/L<input name="fuel_efficiency_km_l" type="number" min="0" step="0.1"></label><label>Preço combustível R$/L<input name="fuel_price_reference" type="number" min="0" step="0.01"></label></div></section>

    <aside class="result-panel"><div class="panel-title"><span>Resultado</span><small>prévia antes de salvar</small></div><dl><div><dt>Receita</dt><dd id="close-gross">R$ 0,00</dd></div><div><dt>Custo operacional</dt><dd id="close-cost">R$ 0,00</dd></div><div class="strong"><dt>Lucro operacional</dt><dd id="close-profit">R$ 0,00</dd></div><div><dt>Receita / h</dt><dd id="close-rph">—</dd></div><div><dt>Lucro / h</dt><dd id="close-pph">—</dd></div><div><dt>Receita / km</dt><dd id="close-rpk">—</dd></div><div><dt>Corridas</dt><dd id="close-trips">0</dd></div></dl></aside>

    <section class="form-panel notes"><div class="panel-title"><span>04</span><h2>Observações</h2></div><label>Notas<textarea name="notes" rows="4" placeholder="Trânsito, dinâmica, região, ocorrência, detalhe relevante…"></textarea></label><div id="draft-note" class="draft-note" hidden>Rascunho importado da Uber carregado. Complete horas, km e custos antes de salvar.</div></section>

    <div class="form-actions"><button type="reset" class="ghost">Limpar</button><button id="save-day-close" type="submit">Salvar fechamento completo</button></div>
  </form>
  <div id="close-message" class="close-message" hidden aria-live="polite"></div>
</main>
<script>import '../scripts/day-close.ts';</script>
<style>
.close-shell{max-width:1420px;margin:auto;padding:26px 30px 72px}.close-head{display:flex;justify-content:space-between;gap:24px;align-items:end;padding:20px 0 24px;border-bottom:1px solid #2B2E32}.close-head h1{font:700 clamp(1.8rem,3vw,2.7rem)/1 Manrope,sans-serif;margin:5px 0}.close-head p{max-width:68ch;margin:8px 0 0;color:#9da1a6;font-size:.88rem;line-height:1.55}.eyebrow{margin:0;color:#C8A96B;font:700 11px Inter,sans-serif;text-transform:uppercase;letter-spacing:.12em}.close-state{font:600 11px Inter,sans-serif;color:#9da1a6}.login-panel,.form-panel,.result-panel{border:1px solid #2B2E32;background:#181A1D;border-radius:12px}.login-panel{margin-top:20px;padding:18px;display:flex;justify-content:space-between;gap:24px;align-items:center}.login-panel p{margin:5px 0 0;color:#9da1a6;font-size:.82rem}.login-panel form{display:flex;gap:8px}.login-panel input,.login-panel button{height:40px}.close-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;margin-top:18px}.form-panel{grid-column:1;padding:20px}.form-panel.core{margin-top:0}.result-panel{grid-column:2;grid-row:1/4;padding:20px;align-self:start;position:sticky;top:76px}.notes{grid-column:1}.panel-title{display:flex;align-items:center;gap:10px;margin-bottom:16px}.panel-title>span{font:700 11px Inter,sans-serif;color:#C8A96B;text-transform:uppercase;letter-spacing:.08em}.panel-title h2{font:700 16px Inter,sans-serif;margin:0}.panel-title small{margin-left:auto;color:#858a90}.fields{display:grid;gap:12px}.fields.two{grid-template-columns:repeat(2,1fr)}.fields.three{grid-template-columns:repeat(3,1fr)}.fields.four{grid-template-columns:repeat(4,1fr);margin-top:12px}label{display:grid;gap:6px;color:#a5a9ae;font:600 11px Inter,sans-serif}input,select,textarea{width:100%;border:1px solid #34383d;background:#101214;color:#F2EFE9;border-radius:8px;padding:10px 11px;font:500 14px Inter,sans-serif}input:focus,select:focus,textarea:focus{outline:2px solid rgba(200,169,107,.55);border-color:#C8A96B}.result-panel dl{margin:0}.result-panel dl div{display:flex;justify-content:space-between;gap:20px;padding:13px 0;border-top:1px solid #2B2E32}.result-panel dt{color:#92979d;font-size:12px}.result-panel dd{margin:0;font-weight:700;font-variant-numeric:tabular-nums}.result-panel .strong dd{color:#C8A96B;font-size:20px}.draft-note{margin-top:12px;padding:11px;border-left:2px solid #C8A96B;background:#111315;color:#b8b3aa;font-size:12px}.form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:9px;padding-top:2px}.form-actions button,.login-panel button{border:1px solid #C8A96B;background:#C8A96B;color:#0B0C0D;border-radius:8px;padding:10px 14px;font-weight:800}.form-actions .ghost{background:transparent;color:#F2EFE9;border-color:#34383d}.close-message{margin-top:12px;padding:13px;border:1px solid #2B2E32;border-radius:9px}.close-message[data-kind="ok"]{border-color:#617a67}.close-message[data-kind="error"]{border-color:#8d554d}@media(max-width:900px){.close-shell{padding:18px 15px 56px}.close-grid{grid-template-columns:1fr}.result-panel{grid-column:1;grid-row:auto;position:static}.fields.four,.fields.three{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.close-head,.login-panel{display:grid}.login-panel form{display:grid}.fields.two,.fields.three,.fields.four{grid-template-columns:1fr}.form-actions{position:sticky;bottom:0;background:rgba(11,12,13,.96);padding:10px 0}.form-actions button{flex:1}}
</style>
</BaseLayout>