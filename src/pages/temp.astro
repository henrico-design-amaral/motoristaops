---
import LandingLayout from '../layouts/LandingLayout.astro';

const whatsapp = 'https://wa.me/5511984240398?text=Ol%C3%A1%2C%20Henrico.%20Gostaria%20de%20solicitar%20um%20or%C3%A7amento.%0A%0AOrigem%3A%0ADestino%3A%0AData%3A%0AHor%C3%A1rio%3A%0APassageiros%3A%0ABagagem%2Fobserva%C3%A7%C3%B5es%3A';
---

<LandingLayout
  title="MotoristaOPS | Motorista Particular em São Paulo"
  description="Motorista particular em São Paulo para corridas agendadas, aeroportos, reuniões e compromissos, com conforto, discrição e pontualidade."
  noindex={true}
>
  <main class="landing-v3" data-build="landing-v3-block-01-r2">
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#inicio" aria-label="MotoristaOPS — início">
          <img src="/temp/landing-v3/logo-header-v3.svg" alt="MotoristaOPS" width="293" height="96" />
        </a>

        <nav class="desktop-nav" aria-label="Navegação principal">
          <a href="#servicos">Serviços</a>
          <a href="#como-funciona">Como funciona</a>
          <a href="#quem-dirige">Quem dirige</a>
        </nav>

        <a class="header-cta" href={whatsapp} aria-label="Falar no WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 20.5 11.7Z" />
            <path d="M8.3 7.8c.3-.3.7-.2.9.1l1.1 1.8c.2.3.1.6-.1.9l-.7.8c.8 1.6 2 2.8 3.7 3.6l.8-.8c.2-.2.6-.3.9-.1l1.8 1.1c.3.2.4.6.1.9-.6.7-1.4 1.1-2.3 1-3.8-.5-7.1-3.7-7.6-7.5-.1-.9.3-1.8 1.4-1.8Z" />
          </svg>
          <span>Falar no WhatsApp</span>
        </a>
      </div>
    </header>

    <section class="hero" id="inicio">
      <div class="hero-ambient" aria-hidden="true"></div>

      <svg class="route-field" viewBox="0 0 960 760" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="routeGradient" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#947546" stop-opacity="0.08" />
            <stop offset="0.44" stop-color="#C79C5B" stop-opacity="0.44" />
            <stop offset="1" stop-color="#F0B44D" stop-opacity="0.82" />
          </linearGradient>
        </defs>
        <path d="M60 728C217 680 278 632 346 556C421 472 433 403 519 343C618 275 714 292 778 214C836 144 824 82 911 38" />
      </svg>

      <div class="hero-visual" aria-hidden="true">
        <img src="/temp/landing-v3/hero-visual-html.svg" alt="" width="680" height="488" fetchpriority="high" />
        <div class="visual-shade"></div>
        <div class="visual-bottom"></div>
      </div>

      <div class="destination-pin" aria-hidden="true">
        <span></span>
      </div>

      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">SÃO PAULO <span>•</span> CORRIDAS AGENDADAS</p>

          <h1>
            <span>MOTORISTA PARTICULAR</span>
            <span>EM SÃO PAULO, COM</span>
            <em>CONFORTO, DISCRIÇÃO</em>
            <em>E PONTUALIDADE.</em>
          </h1>

          <p class="lead">Atendimento direto para aeroportos, reuniões, compromissos e deslocamentos planejados — com comunicação clara e uma experiência cuidadosa do início ao fim.</p>

          <div class="actions">
            <a class="button button-primary" href={whatsapp}>Falar no WhatsApp</a>
            <a class="button button-secondary" href="#servicos">Ver serviços <span aria-hidden="true">→</span></a>
          </div>

          <div class="trust-row" aria-label="Diferenciais do atendimento">
            <article>
              <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12" /><path d="M16 8v9l6 3" /></svg>
              <span>Atendimento com<br />hora marcada</span>
            </article>
            <article>
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m6 17 20-9-8 20-3-8-9-3Z" /><path d="m15 20 5-5" /></svg>
              <span>Aeroportos e<br />deslocamentos</span>
            </article>
            <article>
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 28s9-8.4 9-15A9 9 0 0 0 7 13c0 6.6 9 15 9 15Z" /><circle cx="16" cy="13" r="3" /></svg>
              <span>São Paulo<br />e região</span>
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>
</LandingLayout>

<style>
  :global(:root) {
    --night: #070709;
    --graphite: #151518;
    --champagne: #C79C5B;
    --champagne-shadow: #947546;
    --ivory: #F3EFE4;
    --stone: #A6A39E;
    --amber: #F0B44D;
  }

  .landing-v3 {
    min-height: 100vh;
    overflow: hidden;
    background: var(--night);
  }

  .shell {
    width: min(1880px, calc(100% - clamp(48px, 7vw, 168px)));
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    z-index: 30;
    height: 94px;
    background: rgba(7, 7, 9, 0.98);
    border-bottom: 1px solid rgba(199, 156, 91, 0.42);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 36px;
  }

  .brand {
    display: flex;
    align-items: center;
    width: 276px;
    flex: 0 0 276px;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(30px, 2.8vw, 58px);
    margin-left: auto;
  }

  .desktop-nav a {
    position: relative;
    color: rgba(243, 239, 228, 0.9);
    text-decoration: none;
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -10px;
    height: 1px;
    background: var(--champagne);
    transition: right 180ms ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    right: 0;
  }

  .header-cta {
    min-height: 46px;
    margin-left: 12px;
    padding: 0 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    border: 1px solid rgba(199, 156, 91, 0.82);
    border-radius: 4px;
    text-decoration: none;
    color: var(--champagne);
    background: rgba(21, 21, 24, 0.26);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .header-cta:hover,
  .header-cta:focus-visible {
    color: var(--night);
    background: var(--champagne);
    border-color: var(--champagne);
  }

  .header-cta svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero {
    position: relative;
    min-height: 820px;
    isolation: isolate;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(7, 7, 9, 0.98) 0%, rgba(7, 7, 9, 0.92) 31%, rgba(7, 7, 9, 0.62) 49%, rgba(7, 7, 9, 0.08) 73%),
      var(--night);
    border-bottom: 1px solid rgba(199, 156, 91, 0.12);
  }

  .hero-ambient {
    position: absolute;
    z-index: -3;
    inset: 0;
    background:
      radial-gradient(circle at 79% 40%, rgba(199, 156, 91, 0.12), transparent 30%),
      linear-gradient(180deg, rgba(255,255,255,0.018), transparent 32%);
    pointer-events: none;
  }

  .hero-ambient::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    opacity: 0.22;
    background-image:
      linear-gradient(rgba(199,156,91,0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(199,156,91,0.09) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to top, #000, transparent 88%);
  }

  .hero-visual {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    width: min(61vw, 1500px);
    height: 100%;
    overflow: hidden;
  }

  .hero-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    display: block;
    transform: scale(1.04);
    filter: saturate(0.94) contrast(1.03) brightness(0.93);
  }

  .visual-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--night) 0%, rgba(7,7,9,0.9) 12%, rgba(7,7,9,0.42) 37%, rgba(7,7,9,0.06) 66%),
      linear-gradient(180deg, rgba(7,7,9,0.08), transparent 55%);
  }

  .visual-bottom {
    position: absolute;
    inset: auto 0 0 0;
    height: 27%;
    background: linear-gradient(180deg, transparent, rgba(7,7,9,0.93) 94%);
  }

  .route-field {
    position: absolute;
    z-index: 0;
    right: -1.5%;
    bottom: -7%;
    width: min(53vw, 1180px);
    height: 88%;
    overflow: visible;
    pointer-events: none;
    opacity: 0.82;
  }

  .route-field path {
    fill: none;
    stroke: url(#routeGradient);
    stroke-width: 3.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .destination-pin {
    position: absolute;
    z-index: 2;
    right: clamp(7%, 9vw, 13%);
    top: 16%;
    width: 28px;
    height: 38px;
    opacity: 0.94;
    filter: drop-shadow(0 0 10px rgba(240,180,77,0.18));
  }

  .destination-pin::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--amber);
    border-radius: 55% 55% 55% 0;
    transform: rotate(-45deg);
  }

  .destination-pin span {
    position: absolute;
    left: 9px;
    top: 8px;
    width: 10px;
    height: 10px;
    border: 2px solid var(--amber);
    border-radius: 50%;
  }

  .hero-inner {
    position: relative;
    z-index: 5;
    min-height: 820px;
    display: flex;
    align-items: center;
  }

  .hero-copy {
    width: min(760px, 46vw);
    padding: 64px 0 70px;
  }

  .eyebrow {
    margin: 0 0 30px;
    color: var(--amber);
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .eyebrow span {
    margin: 0 0.55em;
    color: var(--champagne);
  }

  h1 {
    margin: 0;
    color: var(--ivory);
    font-size: clamp(64px, 4.5vw, 108px);
    font-weight: 700;
    line-height: 0.93;
    letter-spacing: -0.046em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 80, 'wght' 700;
    text-wrap: balance;
  }

  h1 span,
  h1 em {
    display: block;
  }

  h1 em {
    color: var(--champagne);
    font-style: normal;
  }

  .lead {
    max-width: 660px;
    margin: 30px 0 0;
    color: rgba(243, 239, 228, 0.86);
    font-size: clamp(17px, 1.05vw, 20px);
    line-height: 1.62;
    letter-spacing: -0.012em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 34px;
  }

  .button {
    min-height: 56px;
    padding: 0 25px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border-radius: 4px;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.08em;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
  }

  .button-primary {
    min-width: 190px;
    color: var(--night);
    background: var(--champagne);
    border: 1px solid var(--champagne);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: #D4AA6C;
    border-color: #D4AA6C;
  }

  .button-secondary {
    min-width: 166px;
    color: var(--champagne);
    background: rgba(7, 7, 9, 0.46);
    border: 1px solid rgba(199, 156, 91, 0.72);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    color: var(--ivory);
    border-color: var(--champagne);
    background: rgba(21, 21, 24, 0.74);
  }

  .trust-row {
    display: flex;
    align-items: stretch;
    margin-top: 40px;
    max-width: 740px;
  }

  .trust-row article {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 0 clamp(18px, 1.55vw, 30px);
    border-left: 1px solid rgba(199, 156, 91, 0.3);
  }

  .trust-row article:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .trust-row svg {
    width: 35px;
    height: 35px;
    flex: 0 0 auto;
    fill: none;
    stroke: var(--amber);
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trust-row span {
    color: rgba(243, 239, 228, 0.88);
    font-size: 11px;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  @media (min-width: 1900px) {
    .site-header { height: 102px; }
    .brand { width: 304px; flex-basis: 304px; }
    .desktop-nav a { font-size: 14px; }
    .hero, .hero-inner { min-height: 900px; }
    .hero-copy { width: min(820px, 45vw); }
    h1 { font-size: clamp(80px, 4.25vw, 116px); }
    .lead { max-width: 700px; }
  }

  @media (max-width: 1280px) {
    .shell { width: min(1160px, calc(100% - 56px)); }
    .site-header { height: 86px; }
    .brand { width: 232px; flex-basis: 232px; }
    .desktop-nav { gap: 26px; }
    .desktop-nav a { font-size: 11px; }
    .header-cta { padding-inline: 16px; font-size: 10px; }
    .hero, .hero-inner { min-height: 760px; }
    .hero-copy { width: min(640px, 50vw); padding-block: 54px 62px; }
    h1 { font-size: clamp(56px, 5vw, 76px); }
    .lead { font-size: 16px; }
    .hero-visual { width: 64vw; }
  }

  @media (max-width: 940px) {
    .site-header { height: 80px; }
    .header-inner { gap: 16px; }
    .desktop-nav { display: none; }
    .brand { width: 210px; flex-basis: 210px; }
    .header-cta { margin-left: auto; min-height: 44px; }
    .hero { min-height: auto; padding-bottom: 0; background: var(--night); }
    .hero-inner { min-height: auto; display: block; }
    .hero-copy { width: 100%; max-width: 690px; padding: 44px 0 500px; }
    .hero-visual { top: auto; bottom: 0; width: 100%; height: 540px; }
    .hero-visual img { object-position: 58% center; transform: scale(1.02); }
    .visual-shade { background: linear-gradient(180deg, var(--night) 0%, rgba(7,7,9,0.9) 10%, rgba(7,7,9,0.18) 34%, rgba(7,7,9,0.06) 72%); }
    .visual-bottom { height: 22%; }
    .route-field { width: 88vw; height: 48%; right: -10%; bottom: -3%; opacity: 0.7; }
    .destination-pin { right: 15%; top: auto; bottom: 30%; }
    .eyebrow { margin-bottom: 22px; font-size: 11px; }
    h1 { font-size: clamp(48px, 8.5vw, 70px); max-width: 720px; }
    .lead { max-width: 620px; }
  }

  @media (max-width: 640px) {
    .shell { width: calc(100% - 32px); }
    .site-header { height: 72px; }
    .brand { width: 174px; flex-basis: 174px; }
    .header-cta { width: 44px; min-width: 44px; padding: 0; }
    .header-cta span { display: none; }
    .hero-copy { padding-top: 30px; padding-bottom: 374px; }
    .eyebrow { font-size: 9px; letter-spacing: 0.21em; margin-bottom: 18px; }
    h1 { font-size: clamp(39px, 11.2vw, 54px); line-height: 0.95; letter-spacing: -0.038em; }
    .lead { margin-top: 22px; font-size: 15px; line-height: 1.56; }
    .actions { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 26px; }
    .button { width: 100%; min-width: 0; min-height: 52px; }
    .trust-row { display: grid; grid-template-columns: 1fr; gap: 13px; margin-top: 28px; }
    .trust-row article,
    .trust-row article:first-child { padding: 0; border: 0; }
    .trust-row svg { width: 29px; height: 29px; }
    .trust-row span { font-size: 10px; }
    .hero-visual { height: 390px; }
    .destination-pin { width: 23px; height: 31px; right: 14%; bottom: 25%; }
    .destination-pin span { left: 7px; top: 6px; width: 9px; height: 9px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .desktop-nav a::after,
    .header-cta { transition: none; }
    .button:hover,
    .button:focus-visible { transform: none; }
  }
</style>
