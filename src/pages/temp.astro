---
import LandingLayout from '../layouts/LandingLayout.astro';

const whatsapp = 'https://wa.me/5511984240398?text=Ol%C3%A1%2C%20Henrico.%20Gostaria%20de%20solicitar%20um%20or%C3%A7amento.%0A%0AOrigem%3A%0ADestino%3A%0AData%3A%0AHor%C3%A1rio%3A%0APassageiros%3A%0ABagagem%2Fobserva%C3%A7%C3%B5es%3A';
---

<LandingLayout title="MotoristaOPS | Motorista Particular em São Paulo">
  <main class="landing-v3">
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#inicio" aria-label="MotoristaOPS — início">
          <img src="/landing-v3/logo-header-v3.svg" alt="MotoristaOPS" />
        </a>

        <nav class="desktop-nav" aria-label="Navegação principal">
          <a href="#servicos">Serviços</a>
          <a href="#como-funciona">Como funciona</a>
          <a href="#quem-dirige">Quem dirige</a>
        </nav>

        <a class="header-cta" href={whatsapp} aria-label="Falar no WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.4-4.2A8.5 8.5 0 1 1 20.5 11.7Z"/><path d="M8.3 7.8c.3-.3.7-.2.9.1l1.1 1.8c.2.3.1.6-.1.9l-.7.8c.8 1.6 2 2.8 3.7 3.6l.8-.8c.2-.2.6-.3.9-.1l1.8 1.1c.3.2.4.6.1.9-.6.7-1.4 1.1-2.3 1-3.8-.5-7.1-3.7-7.6-7.5-.1-.9.3-1.8 1.4-1.8Z"/></svg>
          <span>Falar no WhatsApp</span>
        </a>
      </div>
    </header>

    <section class="hero" id="inicio">
      <div class="hero-visual" aria-hidden="true">
        <img src="/landing-v3/hero-visual-html.svg" alt="" />
        <div class="hero-visual-fade"></div>
      </div>

      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">SÃO PAULO <span>•</span> CORRIDAS AGENDADAS</p>

          <h1>
            MOTORISTA PARTICULAR<br />
            EM SÃO PAULO, COM<br />
            <em>CONFORTO, DISCRIÇÃO E<br />PONTUALIDADE.</em>
          </h1>

          <p class="lead">Atendimento direto para aeroportos, reuniões, compromissos e deslocamentos planejados — com comunicação clara e uma experiência cuidadosa do início ao fim.</p>

          <div class="actions">
            <a class="button button-primary" href={whatsapp}>Falar no WhatsApp</a>
            <a class="button button-secondary" href="#servicos">Ver serviços <span aria-hidden="true">→</span></a>
          </div>

          <div class="trust-row" aria-label="Diferenciais do atendimento">
            <article>
              <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12"/><path d="M16 8v9l6 3"/></svg>
              <span>Atendimento com<br />hora marcada</span>
            </article>
            <article>
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m6 17 20-9-8 20-3-8-9-3Z"/><path d="m15 20 5-5"/></svg>
              <span>Aeroportos e<br />deslocamentos</span>
            </article>
            <article>
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 28s9-8.4 9-15A9 9 0 0 0 7 13c0 6.6 9 15 9 15Z"/><circle cx="16" cy="13" r="3"/></svg>
              <span>São Paulo<br />e região</span>
            </article>
          </div>
        </div>
      </div>
    </section>
  </main>
</LandingLayout>

<style>
  :global(:root){--night:#070709;--graphite:#151518;--champagne:#C79C5B;--ivory:#F3EFE4;--stone:#A6A39E;--amber:#F0B44D}
  .landing-v3{min-height:100vh;background:var(--night);overflow:hidden}
  .shell{width:min(1500px,calc(100% - 96px));margin:0 auto}

  .site-header{position:relative;z-index:20;height:104px;border-bottom:1px solid rgba(199,156,91,.45);background:#070709}
  .header-inner{height:100%;display:flex;align-items:center;gap:42px}
  .brand{display:block;width:255px;flex:0 0 255px}
  .brand img{display:block;width:100%;height:auto}
  .desktop-nav{display:flex;align-items:center;gap:56px;margin-left:auto}
  .desktop-nav a{color:var(--ivory);text-decoration:none;font-size:14px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap}
  .header-cta{margin-left:18px;display:inline-flex;align-items:center;gap:12px;padding:16px 22px;border:1px solid rgba(199,156,91,.85);border-radius:4px;text-decoration:none;color:var(--champagne);font-size:13px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;white-space:nowrap}
  .header-cta svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}

  .hero{position:relative;min-height:760px;background:#070709;border-bottom:1px solid rgba(199,156,91,.12);isolation:isolate}
  .hero-visual{position:absolute;z-index:0;right:0;top:0;width:69%;height:100%;overflow:hidden}
  .hero-visual img{width:100%;height:100%;object-fit:cover;object-position:center right;display:block}
  .hero-visual:before{content:'';position:absolute;z-index:2;inset:0;background:linear-gradient(90deg,#070709 0%,rgba(7,7,9,.95) 8%,rgba(7,7,9,.54) 30%,rgba(7,7,9,.08) 58%,rgba(7,7,9,.05) 100%)}
  .hero-visual-fade{position:absolute;z-index:3;left:0;right:0;bottom:0;height:30%;background:linear-gradient(180deg,transparent,#070709 94%)}

  .hero-inner{position:relative;z-index:5;min-height:760px;display:flex;align-items:center}
  .hero-copy{width:min(660px,48vw);padding:56px 0 48px}
  .eyebrow{margin:0 0 28px;color:var(--amber);font-size:13px;font-weight:650;letter-spacing:.28em;text-transform:uppercase}
  .eyebrow span{margin:0 .5em;color:var(--champagne)}

  h1{margin:0;color:var(--ivory);font-size:clamp(54px,4.85vw,82px);font-weight:700;line-height:.95;letter-spacing:-.045em;text-transform:uppercase;font-variation-settings:'wdth' 78}
  h1 em{font-style:normal;color:var(--champagne)}
  .lead{max-width:610px;margin:26px 0 0;color:rgba(243,239,228,.88);font-size:18px;line-height:1.62}

  .actions{display:flex;gap:18px;margin-top:32px}
  .button{height:58px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:0 26px;border-radius:4px;text-decoration:none;text-transform:uppercase;font-size:13px;font-weight:750;letter-spacing:.08em;transition:transform .18s ease,background .18s ease,border-color .18s ease}
  .button:hover,.button:focus-visible{transform:translateY(-1px)}
  .button-primary{background:var(--champagne);border:1px solid var(--champagne);color:var(--night)}
  .button-secondary{background:rgba(7,7,9,.56);border:1px solid rgba(199,156,91,.84);color:var(--champagne)}

  .trust-row{display:flex;align-items:center;gap:0;margin-top:34px}
  .trust-row article{display:flex;align-items:center;gap:13px;padding:0 24px;border-left:1px solid rgba(199,156,91,.34)}
  .trust-row article:first-child{padding-left:0;border-left:0}
  .trust-row svg{width:38px;height:38px;fill:none;stroke:var(--amber);stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto}
  .trust-row span{color:rgba(243,239,228,.9);font-size:12px;font-weight:600;line-height:1.45;text-transform:uppercase;letter-spacing:.05em}

  @media(max-width:1180px){
    .shell{width:min(1120px,calc(100% - 56px))}
    .brand{width:220px;flex-basis:220px}
    .desktop-nav{gap:28px}.desktop-nav a{font-size:12px}
    .header-cta{padding:14px 16px;font-size:11px}
    .hero-visual{width:72%}
    .hero-copy{width:min(590px,50vw)}
    h1{font-size:clamp(46px,5vw,66px)}
    .lead{font-size:16px}
  }

  @media(max-width:900px){
    .site-header{height:82px}
    .header-inner{gap:16px}
    .desktop-nav{display:none}
    .brand{width:190px;flex-basis:190px}
    .header-cta{margin-left:auto;padding:12px 14px}
    .header-cta span{display:none}
    .hero{min-height:auto;padding-bottom:0}
    .hero-inner{min-height:auto;display:block;padding-top:38px}
    .hero-copy{width:100%;max-width:640px;padding:0 0 390px}
    .hero-visual{top:auto;bottom:0;width:100%;height:430px}
    .hero-visual:before{background:linear-gradient(180deg,#070709 0%,rgba(7,7,9,.68) 20%,rgba(7,7,9,.08) 54%,rgba(7,7,9,.25) 100%)}
    .eyebrow{font-size:11px;margin-bottom:20px}
    h1{font-size:clamp(44px,9vw,64px)}
    .lead{max-width:560px}
  }

  @media(max-width:620px){
    .shell{width:calc(100% - 32px)}
    .site-header{height:74px}
    .brand{width:165px;flex-basis:165px}
    .header-cta{padding:10px 11px}
    .hero-inner{padding-top:28px}
    .hero-copy{padding-bottom:330px}
    .eyebrow{font-size:9px;letter-spacing:.22em}
    h1{font-size:clamp(38px,11vw,50px);line-height:.96}
    .lead{font-size:15px;margin-top:20px}
    .actions{display:grid;grid-template-columns:1fr;margin-top:24px}
    .button{width:100%;height:54px}
    .trust-row{display:grid;grid-template-columns:1fr;gap:14px;margin-top:24px}
    .trust-row article,.trust-row article:first-child{padding:0;border:0}
    .trust-row svg{width:30px;height:30px}
    .trust-row span{font-size:11px}
    .hero-visual{height:350px}
  }

  @media(prefers-reduced-motion:reduce){.button{transition:none}.button:hover,.button:focus-visible{transform:none}}
</style>