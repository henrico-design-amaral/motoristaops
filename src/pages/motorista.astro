---
import BaseLayout from '../layouts/BaseLayout.astro';
const whatsapp = 'https://wa.me/5511953970704?text=Olá%2C%20Henrico.%20Gostaria%20de%20falar%20sobre%20uma%20corrida%20particular.';
---
<BaseLayout title="Henrico Amaral · Motorista particular em São Paulo">
  <main class="driver-page">
    <nav class="driver-nav" aria-label="Navegação principal"><a class="brand" href="#inicio">HENRICO<span>motorista</span></a><div><a href="#servicos">Serviços</a><a href="#experiencia">Experiência</a><a class="nav-cta" href={whatsapp}>WhatsApp</a></div></nav>
    <section id="inicio" class="hero">
      <div class="hero-copy"><p class="kicker">Motorista particular · São Paulo e região</p><h1>Seu caminho merece <em>mais cuidado.</em></h1><p class="lead">Corridas particulares, compromissos, aeroportos e deslocamentos planejados com atendimento direto, pontualidade e atenção em cada etapa.</p><div class="actions"><a class="primary" href={whatsapp}>Chamar no WhatsApp <span>↗</span></a><a class="secondary" href="#servicos">Conhecer o serviço</a></div><p class="signature">Levando pessoas, cuidando de histórias.</p></div>
      <div class="hero-visual" aria-hidden="true"><div class="route"><span class="point point-a"></span><span class="line"></span><span class="point point-b"></span></div><div class="visual-card"><small>ATENDIMENTO DIRETO</small><strong>Do primeiro contato<br/>ao destino.</strong><span>Sem intermediários.</span></div></div>
    </section>
    <section id="servicos" class="section"><div class="section-intro"><p class="kicker">Como posso ajudar</p><h2>Mobilidade para a vida real.</h2><p>Do compromisso do dia a dia à viagem que precisa acontecer no horário certo.</p></div><div class="service-grid"><article><span>01</span><h3>Corridas particulares</h3><p>Deslocamentos sob demanda com contato direto e atendimento pessoal.</p></article><article><span>02</span><h3>Aeroportos e rodoviárias</h3><p>Saídas programadas, acompanhamento de horário e margem para imprevistos.</p></article><article><span>03</span><h3>Compromissos agendados</h3><p>Consultas, reuniões, eventos e trajetos que pedem previsibilidade.</p></article><article><span>04</span><h3>Aplicativos</h3><p>Experiência diária nas ruas também como motorista de aplicativo.</p></article></div></section>
    <section id="experiencia" class="experience"><div><p class="kicker">A experiência</p><h2>Menos promessa.<br/>Mais presença.</h2></div><div class="experience-copy"><p>Um bom deslocamento não é só chegar. É saber quem vai te buscar, combinar diretamente, entrar em um carro cuidado e seguir viagem com tranquilidade.</p><ul><li><span>01</span>Contato direto pelo WhatsApp</li><li><span>02</span>Horário e trajeto combinados com clareza</li><li><span>03</span>Carro limpo e cuidado</li><li><span>04</span>Atendimento discreto e respeitoso</li></ul></div></section>
    <section class="about"><div class="about-mark">HA</div><div><p class="kicker">Quem dirige</p><h2>Henrico Amaral.</h2><p>Motorista particular e de aplicativo. Um serviço construído na prática, corrida após corrida, com atenção ao que realmente importa para quem está do outro lado: segurança, respeito, conforto e confiança.</p></div></section>
    <section class="final-cta"><p class="kicker">Precisa ir?</p><h2>Me diga para onde.</h2><p>Envie origem, destino, dia e horário. Eu retorno pelo WhatsApp para combinarmos a corrida.</p><a class="primary primary--light" href={whatsapp}>Falar com Henrico no WhatsApp <span>↗</span></a></section>
    <footer><div class="brand">HENRICO<span>motorista</span></div><p>Levando pessoas, cuidando de histórias.</p><a href={whatsapp}>WhatsApp ↗</a></footer>
    <a class="floating" href={whatsapp} aria-label="Falar com Henrico pelo WhatsApp">WhatsApp</a>
  </main>
</BaseLayout>
<style>
:global(body){margin:0;background:#11110f;color:#ece8df;font-family:Inter,system-ui,sans-serif}.driver-page{--gold:#c6a36b;--ink:#11110f;--paper:#ece8df;--muted:#a7a198;overflow:hidden}.driver-nav{height:88px;display:flex;align-items:center;justify-content:space-between;max-width:1240px;margin:auto;padding:0 28px;border-bottom:1px solid #ffffff18}.brand{font-weight:800;letter-spacing:.16em;color:inherit;text-decoration:none}.brand span{display:block;font-size:.58rem;font-weight:500;letter-spacing:.28em;color:var(--gold);margin-top:3px}.driver-nav>div{display:flex;gap:28px;align-items:center}.driver-nav a{color:#d7d2c9;text-decoration:none;font-size:.82rem}.nav-cta{border:1px solid #6d624f;padding:12px 18px}.hero{max-width:1240px;min-height:720px;margin:auto;padding:80px 28px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:70px}.kicker{text-transform:uppercase;letter-spacing:.2em;color:var(--gold);font-size:.72rem;font-weight:700}.hero h1,.section h2,.experience h2,.about h2,.final-cta h2{font-family:Georgia,serif;font-weight:400;letter-spacing:-.04em}.hero h1{font-size:clamp(4rem,8vw,7.6rem);line-height:.88;margin:24px 0 30px;max-width:850px}.hero h1 em{color:var(--gold);font-weight:400}.lead{max-width:650px;font-size:1.14rem;line-height:1.75;color:#bcb6ad}.actions{display:flex;gap:14px;align-items:center;margin-top:38px}.primary,.secondary{display:inline-flex;gap:24px;align-items:center;padding:17px 22px;text-decoration:none;font-size:.88rem}.primary{background:var(--gold);color:#15130f;font-weight:800}.secondary{color:#ddd8cf;border:1px solid #ffffff24}.signature{font-family:Georgia,serif;font-style:italic;color:#8e887f;margin-top:70px}.hero-visual{min-height:520px;position:relative;background:radial-gradient(circle at 50% 35%,#a6804624,transparent 35%),linear-gradient(145deg,#181714,#0d0d0c);border:1px solid #ffffff10}.route{position:absolute;inset:70px;display:flex;flex-direction:column;align-items:center}.line{height:290px;width:1px;background:linear-gradient(var(--gold),#c6a36b1a);transform:rotate(22deg)}.point{width:9px;height:9px;border:1px solid var(--gold);border-radius:50%}.point-b{background:var(--gold)}.visual-card{position:absolute;left:32px;right:32px;bottom:32px;background:#14130ff0;border:1px solid #ffffff16;padding:28px}.visual-card small{color:var(--gold);letter-spacing:.16em}.visual-card strong{display:block;font-family:Georgia,serif;font-size:1.7rem;font-weight:400;margin:12px 0}.visual-card span{color:var(--muted);font-size:.86rem}.section{background:#e8e2d7;color:#1a1916;padding:120px max(28px,calc((100vw - 1184px)/2))}.section-intro{display:grid;grid-template-columns:.6fr 1fr 1fr;gap:40px;align-items:end}.section h2,.experience h2,.about h2{font-size:clamp(2.8rem,5vw,5rem);margin:0}.section-intro>p:last-child{line-height:1.7;color:#625e57}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:75px;border-top:1px solid #aaa298}.service-grid article{padding:30px 24px 20px 0;border-right:1px solid #aaa298;margin-right:24px}.service-grid article:last-child{border:0}.service-grid span{font-size:.72rem;color:#8c7148}.service-grid h3{font-family:Georgia,serif;font-size:1.5rem;font-weight:400;margin:45px 0 15px}.service-grid p{color:#69645d;line-height:1.65;font-size:.9rem}.experience{max-width:1184px;margin:auto;padding:130px 28px;display:grid;grid-template-columns:1fr 1fr;gap:100px}.experience-copy>p,.about p{font-size:1.08rem;line-height:1.8;color:#b6b0a7}.experience ul{list-style:none;padding:30px 0 0;margin:0}.experience li{border-top:1px solid #ffffff1c;padding:20px 0}.experience li span{color:var(--gold);font-size:.7rem;margin-right:28px}.about{background:#181714;max-width:1184px;margin:0 auto 130px;display:grid;grid-template-columns:.75fr 1.25fr;align-items:center}.about-mark{min-height:420px;display:grid;place-items:center;font-family:Georgia,serif;font-size:9rem;color:#c6a36b38;background:radial-gradient(circle,#c6a36b16,transparent 55%)}.about>div:last-child{padding:55px}.final-cta{text-align:center;background:var(--gold);color:#16140f;padding:110px 28px}.final-cta .kicker{color:#4c3b24}.final-cta h2{font-size:clamp(4rem,8vw,7rem);margin:14px}.final-cta p{max-width:560px;margin:0 auto 30px;line-height:1.7}.primary--light{background:#16140f;color:#eee8dc}footer{max-width:1184px;margin:auto;padding:45px 28px;display:flex;align-items:center;justify-content:space-between;color:#8e887f;font-size:.78rem}footer a{color:var(--gold);text-decoration:none}.floating{display:none;position:fixed;right:18px;bottom:18px;background:var(--gold);color:#15130f;text-decoration:none;font-weight:800;padding:15px 18px;z-index:10}@media(max-width:800px){.driver-nav>div>a:not(.nav-cta){display:none}.hero{grid-template-columns:1fr;min-height:auto;padding-top:60px}.hero h1{font-size:clamp(3.7rem,17vw,5.8rem)}.hero-visual{min-height:400px}.section-intro,.experience,.about{grid-template-columns:1fr}.service-grid{grid-template-columns:1fr 1fr}.experience{gap:45px}.about-mark{min-height:280px}.about>div:last-child{padding:38px 28px}footer{padding-bottom:100px;align-items:flex-start;gap:22px;flex-direction:column}.floating{display:block}}@media(max-width:520px){.driver-nav{height:74px}.hero{padding:50px 20px 70px}.lead{font-size:1rem}.actions{align-items:stretch;flex-direction:column}.primary,.secondary{justify-content:space-between}.hero-visual{min-height:330px}.route{inset:45px}.line{height:180px}.section{padding-top:85px;padding-bottom:85px}.section-intro{gap:18px}.service-grid{grid-template-columns:1fr;margin-top:45px}.service-grid article{border-right:0;margin:0;border-bottom:1px solid #aaa298}.service-grid h3{margin-top:25px}.experience{padding:85px 20px}.about{margin-bottom:0}.final-cta{padding:85px 20px}.final-cta h2{font-size:3.8rem}}
</style>