---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contextFeatureVectors, signalImpactMatrix, contextReadiness, contextFeatureModelMeta } from '../data/context-feature-engine-v2';
const brl = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const pct = new Intl.NumberFormat('pt-BR',{style:'percent',maximumFractionDigits:0});
const n = new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1});
const topWindows = contextFeatureVectors.slice(0,12);
---
<BaseLayout title="MotoristaOPS · Contexto operacional">
  <main class="context-shell">
    <header class="hero">
      <div>
        <p class="eyebrow">MotoristaOPS · contexto operacional v2</p>
        <h1>Medir o que muda a qualidade de uma janela.</h1>
        <p>CET, acidente, obra, evento, chuva, dinâmica e aeroporto passam a existir como features estruturadas por data, faixa horária, origem e destino. O sistema separa ocorrência confirmada, sinal observado, pendência e ausência de evidência.</p>
      </div>
      <div class="links"><a href="/inteligencia">← Inteligência</a><a href="/previsao">Previsão →</a></div>
    </header>

    <section class="grid metrics">
      <article><span>Janelas contextuais</span><strong>{contextFeatureVectors.length}</strong><small>data × faixa × origem × destino</small></article>
      <article><span>Tipos de sinal</span><strong>{contextReadiness.length}</strong><small>CET, acidente, obra, evento, clima, aeroporto, notícia, dinâmica e rota de aeroporto</small></article>
      <article><span>Melhor score atual</span><strong>{pct.format(topWindows[0]?.recommendationScore ?? 0)}</strong><small>heurístico, ainda não calibrado</small></article>
      <article><span>Contexto conhecido</span><strong>{pct.format(topWindows[0]?.contextCompleteness ?? 0)}</strong><small>na janela mais bem ranqueada</small></article>
    </section>

    <section class="section">
      <div class="section-head"><div><p class="eyebrow">01 · cobertura</p><h2>Prontidão por sinal</h2></div><p>Pending e not-located são estados de dados. Eles não significam que o fenômeno não ocorreu.</p></div>
      <div class="readiness">
        {contextReadiness.map(item => <article>
          <div><strong>{item.feature}</strong><span>{pct.format(item.coverage)} de cobertura</span></div>
          <dl><div><dt>observado</dt><dd>{item.observed}</dd></div><div><dt>pendente</dt><dd>{item.pending}</dd></div><div><dt>não localizado</dt><dd>{item.notLocated}</dd></div><div><dt>desconhecido</dt><dd>{item.unknown}</dd></div></dl>
        </article>)}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><p class="eyebrow">02 · impacto</p><h2>Sinal × desempenho</h2></div><p>O delta só vira leitura direcional quando há pelo menos três janelas afetadas e três comparáveis de baseline.</p></div>
      <div class="impact-table">
        <div class="head"><span>Sinal</span><span>Amostra</span><span>Δ R$/h</span><span>Δ velocidade</span><span>Δ ocupação</span><span>Uso</span></div>
        {signalImpactMatrix.map(row => <div class="row"><strong>{row.feature}</strong><span>{row.affectedWindows}/{row.baselineWindows}</span><span>{row.deltaRevenuePerRideHour===null?'—':pct.format(row.deltaRevenuePerRideHour)}</span><span>{row.deltaSpeed===null?'—':pct.format(row.deltaSpeed)}</span><span>{row.deltaOccupancy===null?'—':pct.format(row.deltaOccupancy)}</span><span>{row.usableForRecommendation?'direcional':row.evidenceGrade}</span></div>)}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><div><p class="eyebrow">03 · janela operacional</p><h2>Score de recomendação atual</h2></div><p>O score usa desempenho observado. Sinais externos só poderão alterar a recomendação quando a amostra comparável for suficiente.</p></div>
      <div class="windows">
        {topWindows.map(row => <article>
          <div class="window-top"><strong>{row.date.slice(8,10)}/{row.date.slice(5,7)} · {row.hourBand}</strong><em>{pct.format(row.recommendationScore)}</em></div>
          <h3>{row.originRegion} → {row.destinationRegion}</h3>
          <dl><div><dt>R$/h corrida</dt><dd>{brl.format(row.revenuePerRideHour)}</dd></div><div><dt>R$/km</dt><dd>{brl.format(row.revenuePerKm)}</dd></div><div><dt>velocidade</dt><dd>{n.format(row.speedKmh)} km/h</dd></div><div><dt>ocupação proxy</dt><dd>{pct.format(row.occupancyProxy)}</dd></div></dl>
          <p>{row.activeFeatures.length ? row.activeFeatures.join(' · ') : 'sem sinal ativo confirmado/observado'}</p>
        </article>)}
      </div>
    </section>

    <section class="note"><strong>Modelo {contextFeatureModelMeta.version}</strong><p>{contextFeatureModelMeta.recommendation}</p><p>{contextFeatureModelMeta.impact}</p><p>{contextFeatureModelMeta.completeness}</p></section>
  </main>
  <style>
    .context-shell{max-width:1500px;margin:auto;padding:42px 34px 80px}.hero{display:flex;justify-content:space-between;gap:42px;padding:42px 0 48px;border-bottom:1px solid var(--mo-line)}.hero h1{font-size:clamp(3rem,7vw,7rem);line-height:.9;letter-spacing:-.07em;max-width:10ch}.hero p:not(.eyebrow){max-width:70ch;color:var(--mo-muted);line-height:1.7}.eyebrow{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--mo-gold-soft);font-weight:800}.links{display:flex;gap:8px;align-items:flex-start;flex-wrap:wrap}.links a{color:var(--mo-paper);text-decoration:none;border:1px solid var(--mo-line);padding:12px 16px;border-radius:999px}.grid{display:grid}.metrics{grid-template-columns:repeat(4,1fr);gap:1px;background:var(--mo-line);border:1px solid var(--mo-line);border-radius:18px;overflow:hidden;margin:30px 0}.metrics article{background:var(--mo-bg);padding:22px}.metrics span,.metrics small{display:block;color:var(--mo-muted);font-size:.68rem}.metrics strong{display:block;font-size:1.65rem;margin:9px 0}.section{margin-top:58px}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:22px}.section-head h2{font-size:clamp(2rem,4vw,4rem);letter-spacing:-.05em}.section-head>p{max-width:50ch;color:var(--mo-muted)}.readiness{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.readiness article,.windows article{border:1px solid var(--mo-line);border-radius:16px;padding:20px;background:rgba(25,22,20,.76)}.readiness article>div{display:flex;justify-content:space-between;gap:12px}.readiness article>div span{color:var(--mo-muted);font-size:.68rem}.readiness dl,.windows dl{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--mo-line);margin:16px 0 0}.readiness dl div,.windows dl div{background:var(--mo-bg-deep);padding:10px}.readiness dt,.windows dt{font-size:.55rem;text-transform:uppercase;color:var(--mo-muted)}.readiness dd,.windows dd{margin:4px 0 0;font-size:.72rem}.impact-table{border:1px solid var(--mo-line);border-radius:16px;overflow:hidden}.impact-table .head,.impact-table .row{display:grid;grid-template-columns:1.2fr .7fr .8fr .8fr .8fr .8fr;gap:12px;align-items:center;padding:13px 16px}.impact-table .head{font-size:.57rem;text-transform:uppercase;color:var(--mo-muted);background:var(--mo-bg-deep)}.impact-table .row{border-top:1px solid var(--mo-line);font-size:.72rem}.impact-table strong{color:var(--mo-gold-soft)}.windows{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.window-top{display:flex;justify-content:space-between;gap:14px}.window-top em{font-style:normal;color:var(--mo-gold-soft);font-weight:800}.windows h3{font-size:1rem;line-height:1.4;margin:14px 0}.windows p{font-size:.65rem;color:var(--mo-muted);line-height:1.5}.note{margin-top:30px;border-left:3px solid var(--mo-gold);padding:20px;background:rgba(66,52,36,.28)}.note p{color:var(--mo-muted);line-height:1.6;margin:8px 0}
    @media(max-width:1000px){.metrics{grid-template-columns:1fr 1fr}.readiness,.windows{grid-template-columns:1fr 1fr}.impact-table .head,.impact-table .row{grid-template-columns:1fr .7fr .8fr .8fr}.impact-table .head span:nth-child(5),.impact-table .head span:nth-child(6),.impact-table .row span:nth-child(5),.impact-table .row span:nth-child(6){display:none}}
    @media(max-width:720px){.context-shell{padding:24px 16px 60px}.hero,.section-head{display:grid}.metrics,.readiness,.windows{grid-template-columns:1fr}.impact-table .head{display:none}.impact-table .row{grid-template-columns:1fr 1fr}.impact-table .row span:nth-child(3),.impact-table .row span:nth-child(4){text-align:right}}
  </style>
</BaseLayout>
