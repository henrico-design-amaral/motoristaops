---
import BaseLayout from '../layouts/BaseLayout.astro';
import { predictiveSummary, weekdayScores, hourScores, regionScores, routeScores, recommendedWindows } from '../data/predictive-engine-v3';
const brl = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
---
<BaseLayout title="MotoristaOPS · Previsão operacional">
<main class="pred-shell">
<header><div><p class="eyebrow">MotoristaOPS · previsão v3</p><h1>Quando e onde vale mais a pena trabalhar?</h1><p>O motor combina eficiência histórica, recorrência e qualidade da amostra para priorizar janelas de trabalho. Ainda é heurístico: trânsito, clima, eventos, km vazio e tempo ocioso entram nas próximas iterações.</p></div><nav><a href="/inteligencia">← Inteligência</a><a href="/">Dashboard</a></nav></header>
<section class="hero-score"><div><span>Melhor combinação atual</span><strong>{predictiveSummary.bestWindow?.weekday ?? '—'} · {predictiveSummary.bestWindow?.hourBand ?? '—'}</strong><p>{predictiveSummary.bestWindow?.rationale}</p></div><b>{predictiveSummary.bestWindow?.score ?? 0}<small>/100</small></b></section>
<section class="section"><div class="head"><div><p class="eyebrow">01</p><h2>Janelas priorizadas</h2></div><p>Combinação de dia da semana + faixa horária. Use como hipótese operacional e confirme com trânsito/eventos antes de sair.</p></div><div class="window-grid">{recommendedWindows.map((x,i)=><article><span>#{i+1} · confiança {x.confidence}</span><strong>{x.weekday}</strong><b>{x.hourBand}</b><div class="meter"><i style={`width:${x.score}%`}></i></div><small>score {x.score}/100</small><p>{x.rationale}</p></article>)}</div></section>
<section class="section grid"><article><div class="head compact"><h2>Dias</h2></div>{weekdayScores.map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.label}</strong><small>{x.days} dia(s) · confiança {x.confidence}</small></span><em>{brl.format(x.profitPerHour)}/h · {x.score}</em></div>)}</article><article><div class="head compact"><h2>Horários</h2></div>{hourScores.slice(0,7).map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas · confiança {x.confidence}</small></span><em>{brl.format(x.revenuePerRideHour)}/h · {x.score}</em></div>)}</article></section>
<section class="section grid"><article><div class="head compact"><h2>Regiões</h2></div>{regionScores.slice(0,8).map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas</small></span><em>{x.score}/100</em></div>)}</article><article><div class="head compact"><h2>Rotas</h2></div>{routeScores.slice(0,8).map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas · ticket {brl.format(x.avgTicket)}</small></span><em>{x.score}/100</em></div>)}</article></section>
<section class="section caveat"><div><p class="eyebrow">Próxima camada</p><h2>Do ranking para a previsão contextual.</h2><p>{predictiveSummary.caveat}</p></div><div>{predictiveSummary.nextSignals.map(x=><span>→ {x}</span>)}</div></section>
</main>
<style>.pred-shell{max-width:1480px;margin:auto;padding:42px 34px 80px}header{display:flex;justify-content:space-between;gap:40px;padding:30px 0 44px;border-bottom:1px solid var(--mo-line)}header h1{font-size:clamp(3rem,7vw,6.5rem);line-height:.92;letter-spacing:-.07em;max-width:11ch}header p:not(.eyebrow){max-width:72ch;color:var(--mo-muted);line-height:1.7}nav{display:flex;gap:10px}nav a{color:var(--mo-paper);text-decoration:none;border:1px solid var(--mo-line);padding:11px 14px;border-radius:999px;height:max-content}.eyebrow{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--mo-gold-soft);font-weight:800}.hero-score{display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;margin:30px 0;padding:28px;border:1px solid var(--mo-line);border-radius:18px;background:linear-gradient(145deg,rgba(66,52,36,.55),rgba(25,22,20,.9))}.hero-score span,.hero-score small{color:var(--mo-muted)}.hero-score strong{display:block;font-size:clamp(2rem,4vw,4rem);margin:8px 0}.hero-score>b{font-size:4rem;color:var(--mo-gold-soft)}.hero-score>b small{font-size:1rem}.section{margin-top:56px}.head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:20px}.head h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.05em}.head>p{max-width:52ch;color:var(--mo-muted)}.window-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.window-grid article,.grid>article{border:1px solid var(--mo-line);border-radius:16px;padding:20px;background:rgba(25,22,20,.72)}.window-grid span,.window-grid small{font-size:.63rem;color:var(--mo-muted)}.window-grid strong,.window-grid b{display:block}.window-grid strong{font-size:1.35rem;margin-top:10px}.window-grid b{font-size:2rem;color:var(--mo-gold-soft)}.window-grid p{font-size:.72rem;line-height:1.55;color:var(--mo-muted)}.meter{height:6px;background:var(--mo-bg-deep);border-radius:999px;overflow:hidden;margin:12px 0 6px}.meter i{display:block;height:100%;background:var(--mo-gold-soft)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.head.compact h2{font-size:2rem}.rank{display:grid;grid-template-columns:28px 1fr auto;gap:12px;align-items:center;padding:12px 0;border-top:1px solid var(--mo-line)}.rank>b{color:var(--mo-gold-soft)}.rank span{display:grid}.rank small{color:var(--mo-muted);font-size:.64rem}.rank em{font-style:normal;font-weight:700}.caveat{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:28px;border-left:3px solid var(--mo-gold);background:rgba(66,52,36,.25)}.caveat h2{font-size:2.5rem}.caveat p{line-height:1.7;color:var(--mo-muted)}.caveat>div:last-child{display:grid;gap:10px;align-content:center}.caveat span{padding:10px 0;border-bottom:1px solid var(--mo-line)}@media(max-width:900px){header{display:grid}.window-grid{grid-template-columns:1fr 1fr}.grid,.caveat{grid-template-columns:1fr}}@media(max-width:560px){.pred-shell{padding:24px 16px 60px}.window-grid{grid-template-columns:1fr}.hero-score{grid-template-columns:1fr}.rank{grid-template-columns:22px 1fr}.rank em{grid-column:2}.head{display:grid}}</style>
</BaseLayout>
