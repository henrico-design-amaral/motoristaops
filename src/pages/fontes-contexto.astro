---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contextSourceRegistryV1, sourceReadinessSummary } from '../data/context-source-registry-v1';
const label = (status:string) => ({'confirmed-data':'dado confirmado','source-found':'fonte localizada','access-blocked':'acesso bloqueado','not-located':'não localizado','pending-reconciliation':'a reconciliar'}[status] ?? status);
---
<BaseLayout title="MotoristaOPS · Fontes de contexto">
<main class="sources-shell">
  <header>
    <div><p class="eyebrow">MotoristaOPS · ingestão contextual</p><h1>O que já virou dado e o que ainda é lacuna.</h1><p>Esta tela separa ausência de evidência, fonte localizada, acesso bloqueado e dado já utilizável. A previsão só deve consumir contexto externo quando a origem e o recorte temporal puderem ser auditados.</p></div>
    <nav><a href="/contexto">← Contexto</a><a href="/inteligencia">Inteligência</a></nav>
  </header>

  <section class="stats">
    <article><span>Fontes/recortes</span><strong>{sourceReadinessSummary.total}</strong></article>
    <article><span>Utilizáveis agora</span><strong>{sourceReadinessSummary.usableNow}</strong></article>
    <article><span>Fontes localizadas</span><strong>{sourceReadinessSummary.sourceFound}</strong></article>
    <article><span>Acesso bloqueado</span><strong>{sourceReadinessSummary.accessBlocked}</strong></article>
  </section>

  <section class="section">
    <div class="head"><div><p class="eyebrow">01 · prontidão</p><h2>Cobertura por tipo</h2></div><p>“Fonte localizada” não significa que o dado histórico já esteja disponível no modelo.</p></div>
    <div class="kind-grid">{sourceReadinessSummary.byKind.map(item=><article><strong>{item.kind}</strong><span>{item.usable}/{item.total} utilizável(is)</span></article>)}</div>
  </section>

  <section class="section">
    <div class="head"><div><p class="eyebrow">02 · registro de fontes</p><h2>Fonte × status × uso</h2></div></div>
    <div class="source-list">
      {contextSourceRegistryV1.map(item=><article>
        <div class="source-top"><span class={`status ${item.status}`}>{label(item.status)}</span><span>{item.kind}</span>{item.date && <span>{item.date.slice(8,10)}/{item.date.slice(5,7)}</span>}</div>
        <h3>{item.source}</h3><p class="region">{item.region} · granularidade {item.timeGranularity}</p><p>{item.note}</p>
        <div class="usable"><strong>{item.usableNow?'PODE ENTRAR NO MODELO':'NÃO ALTERA RECOMENDAÇÃO AINDA'}</strong><a href={item.sourceUrl} target="_blank" rel="noreferrer">abrir fonte ↗</a></div>
      </article>)}
    </div>
  </section>

  <section class="warning"><strong>Regra de governança</strong><p>Não localizado ≠ não aconteceu. Acesso bloqueado ≠ dado inexistente. Fonte encontrada ≠ dado reconciliado. Só “dado confirmado” com recorte temporal/regional compatível pode alterar leitura contextual.</p></section>
</main>
<style>
.sources-shell{max-width:1450px;margin:auto;padding:42px 34px 80px}header{display:flex;justify-content:space-between;gap:40px;padding:38px 0 46px;border-bottom:1px solid var(--mo-line)}header h1{font-size:clamp(3rem,6.5vw,6.7rem);line-height:.92;letter-spacing:-.06em;max-width:11ch}header p:not(.eyebrow){max-width:72ch;line-height:1.7;color:var(--mo-muted)}nav{display:flex;gap:8px;flex-wrap:wrap}nav a{color:var(--mo-paper);text-decoration:none;border:1px solid var(--mo-line);padding:11px 14px;border-radius:999px;height:max-content}.eyebrow{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--mo-gold-soft);font-weight:800}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--mo-line);border:1px solid var(--mo-line);border-radius:18px;overflow:hidden;margin:28px 0}.stats article{background:var(--mo-bg);padding:22px}.stats span{display:block;color:var(--mo-muted);font-size:.66rem}.stats strong{display:block;font-size:2rem;margin-top:8px}.section{margin-top:58px}.head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:20px}.head h2{font-size:clamp(2rem,4vw,4rem);letter-spacing:-.05em}.head>p{max-width:52ch;color:var(--mo-muted)}.kind-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.kind-grid article{border:1px solid var(--mo-line);border-radius:12px;padding:16px}.kind-grid strong{display:block;text-transform:uppercase;font-size:.72rem}.kind-grid span{display:block;color:var(--mo-muted);font-size:.62rem;margin-top:7px}.source-list{display:grid;gap:10px}.source-list article{border:1px solid var(--mo-line);border-radius:15px;padding:20px;background:rgba(25,22,20,.72)}.source-top{display:flex;gap:7px;flex-wrap:wrap}.source-top span{font-size:.58rem;text-transform:uppercase;letter-spacing:.07em;border:1px solid var(--mo-line);padding:5px 7px;border-radius:999px}.status.confirmed-data{color:var(--mo-gold-soft)}.status.access-blocked{border-style:dashed}.source-list h3{font-size:1.3rem;margin:13px 0 4px}.source-list p{max-width:90ch;color:var(--mo-paper-soft);line-height:1.6}.source-list .region{font-size:.68rem;color:var(--mo-muted)}.usable{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-top:14px;padding-top:12px;border-top:1px solid var(--mo-line)}.usable strong{font-size:.61rem;letter-spacing:.08em}.usable a{color:var(--mo-gold-soft);font-size:.68rem}.warning{margin-top:30px;border-left:3px solid var(--mo-gold);padding:22px;background:rgba(66,52,36,.24)}.warning p{color:var(--mo-muted);line-height:1.6}@media(max-width:900px){header,.head{display:grid}.stats{grid-template-columns:1fr 1fr}.kind-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.sources-shell{padding:24px 16px 60px}.stats,.kind-grid{grid-template-columns:1fr}.usable{display:grid}}
</style>
</BaseLayout>
