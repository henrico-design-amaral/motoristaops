---
import BaseLayout from '../layouts/BaseLayout.astro';
import { regionScores, hourScores, weekdayScores } from '../data/predictive-engine-v3';
const topRegions=regionScores.slice(0,6);
const topHours=hourScores.slice(0,4);
const topDays=weekdayScores.slice(0,4);
---
<BaseLayout title="MotoristaOPS · Cidade agora">
<main class="traffic-shell">
  <header class="hero">
    <div><p class="eyebrow">MotoristaOPS · contexto vivo</p><h1>A cidade agora, antes da próxima corrida.</h1><p>CET, clima e saúde da fonte aeroportuária no mesmo painel. A prioridade operacional cruza esses sinais com o seu histórico, sem confundir ajuste de curto prazo com previsão estatística calibrada.</p></div>
    <nav><a href="/">Cockpit</a><a href="/inteligencia">Inteligência</a><a href="/previsao">Previsão</a></nav>
  </header>

  <section class="live-strip" aria-live="polite">
    <div><span>Status CET</span><strong id="live-status">carregando</strong><small id="live-age">aguardando snapshot</small></div>
    <div><span>Lentidão total</span><strong id="live-total">—</strong><small>km publicados pela CET</small></div>
    <div><span>Região mais pressionada</span><strong id="live-worst">—</strong><small id="live-pressure">pressão indisponível</small></div>
    <div><span>Clima agora</span><strong id="live-weather">—</strong><small id="live-weather-detail">aguardando</small></div>
    <div><span>Congonhas</span><strong id="live-airport">—</strong><small>saúde da fonte Aena</small></div>
  </section>

  <section class="section adaptive">
    <div class="head"><div><p class="eyebrow">01 · prioridade operacional</p><h2>Histórico ajustado pelo trânsito de agora.</h2></div><p>O score-base vem das suas corridas. O CET pode aplicar um ajuste pequeno pela pressão da macrozona. Clima e aeroporto permanecem informativos até termos amostra histórica suficiente.</p></div>
    <div id="adaptive-grid" class="adaptive-grid"><article><span>calculando prioridade…</span></article></div>
  </section>

  <section class="section">
    <div class="head"><div><p class="eyebrow">02 · cidade</p><h2>Trânsito por região</h2></div><p>Atualização esperada a cada cinco minutos. A idade do snapshot fica explícita e o sistema preserva o último estado quando uma fonte falha.</p></div>
    <div id="zone-grid" class="zone-grid">{['Norte','Oeste','Centro','Leste','Sul'].map(name=><article data-zone={name}><span>{name}</span><strong>—</strong><small>aguardando</small><i></i></article>)}</div>
  </section>

  <section class="section two-col">
    <article class="panel"><div class="head compact"><div><p class="eyebrow">03 · histórico</p><h2>Regiões com melhor eficiência</h2></div></div>{topRegions.map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas · confiança {x.confidence}</small></span><em>{x.score}/100</em></div>)}</article>
    <article class="panel"><div class="head compact"><div><p class="eyebrow">04 · timing</p><h2>Quando o histórico rende melhor</h2></div></div>{topDays.map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.label}</strong><small>{x.days} dia(s) · confiança {x.confidence}</small></span><em>{x.score}/100</em></div>)}<div class="divider"></div>{topHours.map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas · confiança {x.confidence}</small></span><em>{x.score}/100</em></div>)}</article>
  </section>

  <section class="section learning-box"><div><p class="eyebrow">05 · aprendizado</p><h2>O live também vira memória.</h2><p>Os snapshots são guardados numa trilha separada do código para futuramente comparar condição da cidade × corrida × ganho. Essa memória é o que permitirá calibrar o efeito real de trânsito e chuva no seu resultado.</p></div><div><span>Trânsito regional CET · a cada ~5 min</span><span>Clima São Paulo · temperatura, chuva e umidade</span><span>Congonhas · fonte monitorada, parser quantitativo pendente</span><span>Próximo dado crítico · km vazio e deslocamento até embarque</span></div></section>

  <section class="source-box"><strong>Governança</strong><p>O trânsito pode ajustar a prioridade live em até poucos pontos; não reescreve o score histórico. Chuva e Congonhas não alteram a recomendação nesta versão. Ausência de dado não significa condição normal.</p><p id="source-time">Última coleta: —</p></section>
</main>
<script is:inline define:vars={{regionScores,weekdayScores,hourScores}}>
const RAW='https://raw.githubusercontent.com/henrico-design-amaral/motoristaops/live-data/public/live-context.json';
const fmt=n=>Number.isFinite(Number(n))?new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1}).format(Number(n)):'—';
const ageText=iso=>{if(!iso)return 'sem coleta';const m=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/60000));return m<1?'atualizado agora':m<60?`atualizado há ${m} min`:`atualizado há ${Math.round(m/60)} h`;};
const clamp=(v,min,max)=>Math.max(min,Math.min(max,v));
const macroFor=region=>{const r=region.toLowerCase();const rules=[['Oeste',['butant','pinheiros','perdizes','lapa','leopoldina','sônia','raposo','rio pequeno','jardins','jardim paulista','consola']],['Sul',['santo amaro','campo belo','congonhas','jabaquara','saúde','moema','vila mariana','ibirapuera','vila andrade','campo limpo','morumbi']],['Centro',['centro','sé','república','santa efigênia','pari','bela vista','higienópolis']],['Norte',['santana','tucuruvi','casa verde','freguesia','jaçanã']],['Leste',['tatuapé','mooca','itaquera','penha','aricanduva','são mateus','vila prudente']]];return rules.find(([,tokens])=>tokens.some(t=>r.includes(t)))?.[0]??null;};
const currentBand=()=>{const h=new Date().getHours();if(h<6)return'04–06';if(h<9)return'06–09';if(h<12)return'09–12';if(h<15)return'12–15';if(h<18)return'15–18';if(h<21)return'18–21';return'21–00';};
const currentDay=()=>['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'][new Date().getDay()];
async function getData(){const r=await fetch(`${RAW}?t=${Date.now()}`,{cache:'no-store'});if(!r.ok)throw new Error(`HTTP ${r.status}`);return r.json();}
function adaptive(d){const zoneMap=new Map((d.traffic?.zones??[]).map(z=>[z.name,z]));const band=currentBand(),day=currentDay();const ds=weekdayScores.find(x=>x.label===day)?.score??50,hs=hourScores.find(x=>x.key===band)?.score??50;return regionScores.slice(0,10).map(x=>{const macro=macroFor(x.key),share=macro?zoneMap.get(macro)?.sharePct:null;const traffic=Number.isFinite(share)?clamp((20-Number(share))*.35,-10,5):0;const temporal=(ds-50)*.08+(hs-50)*.12;return {...x,macro,share,traffic,adjusted:Math.round(clamp(x.score+traffic+temporal,0,100)),band,day};}).sort((a,b)=>b.adjusted-a.adjusted);}
function render(d){const t=d.traffic??{},w=d.weather??{},a=d.airport??{};const stale=!d.collectedAt||Date.now()-new Date(d.collectedAt).getTime()>20*60000;document.querySelector('#live-status').textContent=t.status==='live'&&!stale?'ao vivo':stale?'atrasado':'indisponível';document.querySelector('#live-age').textContent=ageText(d.collectedAt);document.querySelector('#live-total').textContent=`${fmt(t.derived?.totalSlowKm)} km`;document.querySelector('#live-worst').textContent=t.derived?.worstZone??'—';document.querySelector('#live-pressure').textContent=`pressão ${t.derived?.pressure??'indisponível'}`;document.querySelector('#live-weather').textContent=w.status==='live'?`${fmt(w.temperatureC)} °C`:'—';document.querySelector('#live-weather-detail').textContent=w.status==='live'?`${w.raining?'chuva':'sem chuva observada'} · umidade ${fmt(w.humidityPct)}%`:'clima indisponível';document.querySelector('#live-airport').textContent=a.status==='source-live'?'fonte online':'fonte indisponível';document.querySelector('#source-time').textContent=`Última coleta: ${d.collectedAt?new Date(d.collectedAt).toLocaleString('pt-BR'):'—'}`;(t.zones??[]).forEach(z=>{const el=document.querySelector(`[data-zone="${z.name}"]`);if(!el)return;el.querySelector('strong').textContent=`${fmt(z.slowKm)} km`;el.querySelector('small').textContent=z.sharePct==null?'participação indisponível':`${fmt(z.sharePct)}% da lentidão`;el.querySelector('i').style.width=`${clamp(Number(z.sharePct)||0,0,100)}%`;});const rows=adaptive(d).slice(0,5);document.querySelector('#adaptive-grid').innerHTML=rows.map((x,i)=>`<article><b>#${i+1}</b><span>${x.macro??'fora do recorte CET'}</span><strong>${x.key}</strong><em>${x.adjusted}/100</em><small>base ${x.score} · CET ${x.traffic>=0?'+':''}${x.traffic.toFixed(1)} · ${x.day} ${x.band}</small></article>`).join('');}
async function refresh(){try{render(await getData());}catch{document.querySelector('#live-status').textContent='indisponível';document.querySelector('#live-age').textContent='snapshot não carregou';}}
refresh();setInterval(refresh,60000);
</script>
<style>
.traffic-shell{max-width:1500px;margin:auto;padding:42px 34px 80px}.hero{display:flex;justify-content:space-between;gap:40px;align-items:flex-start;padding:40px 0 48px;border-bottom:1px solid var(--mo-line)}.hero h1{font-size:clamp(3rem,7vw,7rem);line-height:.9;letter-spacing:-.07em;max-width:10ch}.hero p:not(.eyebrow){max-width:70ch;line-height:1.7;color:var(--mo-muted)}.eyebrow{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--mo-gold-soft);font-weight:800}nav{display:flex;gap:8px;flex-wrap:wrap}nav a{color:var(--mo-paper);text-decoration:none;border:1px solid var(--mo-line);padding:11px 14px;border-radius:999px}.live-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--mo-line);border:1px solid var(--mo-line);border-radius:18px;overflow:hidden;margin:28px 0}.live-strip>div{background:var(--mo-bg);padding:20px}.live-strip span,.live-strip small{display:block;color:var(--mo-muted);font-size:.66rem}.live-strip strong{display:block;font-size:1.5rem;margin:8px 0}.section{margin-top:60px}.head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:20px}.head h2,.learning-box h2{font-size:clamp(2rem,4vw,4rem);letter-spacing:-.05em}.head>p{max-width:54ch;color:var(--mo-muted)}.adaptive-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.adaptive-grid article{border:1px solid var(--mo-line);border-radius:15px;padding:18px;background:linear-gradient(145deg,rgba(66,52,36,.34),rgba(20,18,17,.85))}.adaptive-grid b,.adaptive-grid span,.adaptive-grid small{display:block;color:var(--mo-muted);font-size:.62rem}.adaptive-grid strong{display:block;font-size:1.05rem;margin:10px 0}.adaptive-grid em{display:block;font-style:normal;font-size:1.8rem;color:var(--mo-gold-soft);font-weight:800}.zone-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.zone-grid article,.panel{border:1px solid var(--mo-line);border-radius:15px;padding:18px}.zone-grid span,.zone-grid small{display:block;color:var(--mo-muted);font-size:.66rem}.zone-grid strong{display:block;font-size:2rem;margin:10px 0}.zone-grid i{display:block;height:4px;background:var(--mo-gold-soft);margin-top:14px;width:0}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px}.head.compact h2{font-size:2rem}.rank{display:grid;grid-template-columns:28px 1fr auto;gap:12px;align-items:center;padding:12px 0;border-top:1px solid var(--mo-line)}.rank>b{color:var(--mo-gold-soft)}.rank span{display:grid}.rank small{font-size:.63rem;color:var(--mo-muted)}.rank em{font-style:normal;font-weight:700}.divider{height:1px;background:var(--mo-line);margin:16px 0}.learning-box{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:30px;border:1px solid var(--mo-line);border-radius:18px;background:rgba(66,52,36,.22)}.learning-box p{color:var(--mo-muted);line-height:1.65}.learning-box>div:last-child{display:grid;align-content:center;gap:10px}.learning-box span{padding:11px 0;border-bottom:1px solid var(--mo-line)}.source-box{margin-top:24px;padding:22px;border-left:3px solid var(--mo-gold);background:rgba(66,52,36,.23)}.source-box p{color:var(--mo-muted);line-height:1.6}@media(max-width:1100px){.live-strip,.adaptive-grid{grid-template-columns:repeat(3,1fr)}.zone-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.traffic-shell{padding:24px 16px 60px}.hero,.head,.two-col,.learning-box{display:grid;grid-template-columns:1fr}.live-strip,.adaptive-grid,.zone-grid{grid-template-columns:1fr 1fr}}@media(max-width:460px){.live-strip,.adaptive-grid,.zone-grid{grid-template-columns:1fr}.rank{grid-template-columns:24px 1fr}.rank em{grid-column:2}}
</style>
</BaseLayout>