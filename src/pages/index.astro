---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/dashboard-product-v3.css';
import { currentClosings, currentVehicleExpenses, currentFuelings, personalMonthlyExpenses, vehicleProfile } from '../data/current-ops';
import { evidenceDays, privatePipeline, privatePricingPolicy, dataHealth } from '../data/dashboard-refresh';
import { predictiveSummary, weekdayScores, hourScores, regionScores, routeScores, recommendedWindows } from '../data/predictive-engine-v3';
import { predictiveIntelligence, dailyContextReviews } from '../data/strategic-intelligence-v2';
import { contextReadiness, signalImpactMatrix } from '../data/context-feature-engine-v2';

const brl=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const num=new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1});
const completeAugust=currentClosings.filter(x=>x.date.startsWith('2026-08'));
const sum=(rows:readonly any[],key:string)=>rows.reduce((s,x)=>s+(Number(x[key])||0),0);
const revenue=sum(completeAugust,'grossRevenue');
const profit=sum(completeAugust,'operationalProfit');
const hours=sum(completeAugust,'hoursOnline');
const km=sum(completeAugust,'kmTotal');
const trips=sum(completeAugust,'tripsTotal');
const evidenceOnly=evidenceDays.filter(x=>x.status==='evidence-only');
const evidenceRevenue=evidenceOnly.reduce((s,x)=>s+(x.platformRevenue??0),0);
const latestEvidence=evidenceDays.at(-1)!;
const personalTotal=personalMonthlyExpenses.reduce((s,x)=>s+Number(x[1]),0);
const maintenanceTotal=currentVehicleExpenses.reduce((s,x)=>s+x.value,0);
const fuelTotal=currentFuelings.filter(x=>x.date.startsWith('2026-08')).reduce((s,x)=>s+x.totalPaid,0);
const pipelineTotal=privatePipeline.reduce((s,x)=>s+x.quotedValue,0);
const contextReady=contextReadiness.filter(x=>x.coverage>0).slice(0,5);
const usableSignals=signalImpactMatrix.filter(x=>x.usableForRecommendation);
const revenuePerHour=hours?revenue/hours:0;
const profitPerHour=hours?profit/hours:0;
const revenuePerKm=km?revenue/km:0;
const revenuePerTrip=trips?revenue/trips:0;
const tripsPerHour=hours?trips/hours:0;
const fuelPerKm=km?fuelTotal/km:0;
const observedRevenue=revenue+evidenceRevenue;
const trend=[
  ...completeAugust.map(x=>({date:x.date,dateBR:x.dateBR,value:x.grossRevenue,kind:'closed' as const,label:`${x.tripsTotal} corridas`})),
  ...evidenceOnly.map(x=>({date:x.date,dateBR:x.date.split('-').reverse().join('/'),value:x.platformRevenue??0,kind:'evidence' as const,label:`${x.completedTrips??0} corridas observadas`}))
].sort((a,b)=>a.date.localeCompare(b.date));
const trendMax=Math.max(...trend.map(x=>x.value),1);
const recentActivity=[...trend].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,6);
const actionItems=[
  ...(dataHealth.missingClosingDates.length?[{tone:'warn',title:`Fechar ${dataHealth.missingClosingDates.length} dia(s) sem fechamento`,detail:dataHealth.missingClosingDates.map(x=>x.slice(8,10)+'/08').join(' · '),href:'#dados'}]:[]),
  ...(evidenceOnly.length?[{tone:'warn',title:`Reconciliar ${brl.format(evidenceRevenue)} em evidências`,detail:`${evidenceOnly.length} dias observados ainda fora do consolidado`,href:'#atividade'}]:[]),
  {tone:'signal',title:`Testar ${predictiveSummary.bestRegion?.key??'melhor região'} na próxima janela`,detail:`${predictiveSummary.bestWindow?.weekday??'—'} · ${predictiveSummary.bestWindow?.hourBand??'—'} · score ${predictiveSummary.bestWindow?.score??0}/100`,href:'./previsao'},
  ...(usableSignals.length===0?[{tone:'neutral',title:'Aumentar amostra contextual',detail:'Trânsito e clima ainda têm efeito limitado na recomendação',href:'./contexto'}]:[])
].slice(0,4);
const quickLinks=[
  ['Trânsito ao vivo','CET + contexto da cidade','./transito'],
  ['Previsão','Dias, horários, regiões e rotas','./previsao'],
  ['Inteligência','Corridas, reviews e padrões','./inteligencia'],
  ['Contexto','Clima, eventos e sinais externos','./contexto'],
  ['Importar','Adicionar histórico Uber','./importar-uber'],
  ['Fontes','Cobertura e confiabilidade','./fontes-contexto']
] as const;
---
<BaseLayout title="MotoristaOPS · Dashboard">
<div class="product-shell">
  <aside class="product-sidebar">
    <a class="product-brand" href="#overview" aria-label="Motorista Ops — visão geral">
      <span>MO</span><div><strong>MOTORISTA OPS</strong><small>operations intelligence</small></div>
    </a>
    <nav aria-label="Navegação do dashboard">
      <a class="is-active" href="#overview">Visão geral</a>
      <a href="#plano">Plano operacional</a>
      <a href="#performance">Performance</a>
      <a href="#atividade">Atividade</a>
      <a href="#particular">Particular</a>
      <a href="#veiculo">Veículo</a>
      <a href="#dados">Dados</a>
    </nav>
    <div class="product-modules">
      <span>Módulos</span>
      <a href="./transito">Trânsito <b>↗</b></a>
      <a href="./previsao">Previsão <b>↗</b></a>
      <a href="./inteligencia">Inteligência <b>↗</b></a>
      <a href="./contexto">Contexto <b>↗</b></a>
    </div>
    <div class="product-system-status"><i></i><div><strong>Operação conectada</strong><small>Supabase {dataHealth.supabaseStatus}</small></div></div>
  </aside>

  <main class="product-main" id="overview">
    <header class="product-topbar">
      <div>
        <p class="product-kicker">Dashboard operacional</p>
        <h1>Visão geral</h1>
      </div>
      <div class="topbar-meta">
        <span>Agosto 2026</span>
        <span class="topbar-status"><i></i> dados até {dataHealth.latestEvidenceDate.split('-').reverse().join('/')}</span>
        <a href="./importar-uber">+ Importar corridas</a>
      </div>
    </header>

    <section class="product-kpis" aria-label="Indicadores principais">
      <article class="kpi-primary"><span>Receita consolidada</span><strong>{brl.format(revenue)}</strong><small>{completeAugust.length} fechamentos completos</small></article>
      <article class="kpi-primary"><span>Lucro operacional</span><strong>{brl.format(profit)}</strong><small>{revenue?num.format((profit/revenue)*100):'—'}% da receita</small></article>
      <article><span>Receita / hora</span><strong>{brl.format(revenuePerHour)}</strong><small>{num.format(hours)} h online</small></article>
      <article><span>Receita / km</span><strong>{brl.format(revenuePerKm)}</strong><small>{num.format(km)} km totais</small></article>
      <article><span>Corridas</span><strong>{trips}</strong><small>{num.format(tripsPerHour)} por hora</small></article>
      <article><span>Receita observada</span><strong>{brl.format(observedRevenue)}</strong><small>inclui {brl.format(evidenceRevenue)} pendentes</small></article>
    </section>

    <section class="product-command-grid" id="plano">
      <article class="operating-plan">
        <div class="panel-heading"><div><span>Próxima melhor decisão</span><h2>Plano operacional</h2></div><a href="./previsao">Abrir previsão →</a></div>
        <div class="plan-main">
          <div class="plan-score"><strong>{predictiveSummary.bestWindow?.score??0}</strong><small>/100</small><span>score histórico</span></div>
          <div class="plan-copy">
            <span>Melhor janela mapeada</span>
            <h3>{predictiveSummary.bestWindow?.weekday??'—'} · {predictiveSummary.bestWindow?.hourBand??'—'}</h3>
            <p>{predictiveSummary.bestWindow?.rationale}</p>
          </div>
        </div>
        <div class="plan-facts">
          <div><span>Região</span><strong>{predictiveSummary.bestRegion?.key??'—'}</strong><small>{predictiveSummary.bestRegion?.confidence??'baixa'} confiança</small></div>
          <div><span>Rota</span><strong>{predictiveSummary.bestRoute?.key??'—'}</strong><small>score {predictiveSummary.bestRoute?.score??0}/100</small></div>
          <div><span>Próxima alternativa</span><strong>{recommendedWindows[1]?.weekday??'—'} · {recommendedWindows[1]?.hourBand??'—'}</strong><small>score {recommendedWindows[1]?.score??0}/100</small></div>
        </div>
      </article>

      <aside class="action-center">
        <div class="panel-heading"><div><span>Pendências e próximos passos</span><h2>Action Center</h2></div><b>{actionItems.length}</b></div>
        <div class="action-items">
          {actionItems.map((item,i)=><a href={item.href} data-tone={item.tone}><span>0{i+1}</span><div><strong>{item.title}</strong><small>{item.detail}</small></div><b>→</b></a>)}
        </div>
      </aside>
    </section>

    <section class="product-section live-section" id="cidade">
      <div class="section-heading"><div><span>Cidade agora</span><h2>Contexto live</h2></div><a href="./transito">Painel de trânsito →</a></div>
      <div class="live-grid product-live-grid">
        <article class="live-primary"><div class="live-title"><span id="live-status">carregando CET…</span><small id="live-age">—</small></div><strong id="live-total">—</strong><p>lentidão total observada</p><div class="live-regions" id="live-regions"><span>aguardando snapshot</span></div></article>
        <article class="live-pressure"><span>Região mais pressionada</span><strong id="live-region">—</strong><small id="live-region-value">—</small><p>Compare pressão atual com as regiões historicamente eficientes antes de mudar de zona.</p></article>
      </div>
    </section>

    <section class="product-section" id="performance">
      <div class="section-heading"><div><span>Performance</span><h2>Eficiência e tendência</h2></div><span>{trips} corridas · {num.format(hours)} h · {num.format(km)} km</span></div>
      <div class="performance-grid">
        <article class="trend-panel">
          <div class="subheading"><div><span>Receita por dia</span><strong>{brl.format(observedRevenue)}</strong></div><small>sólido = fechado · contorno = evidência</small></div>
          <div class="trend-chart" role="img" aria-label="Receita observada por dia em agosto">
            {trend.map(x=><div class="trend-column" title={`${x.dateBR}: ${brl.format(x.value)} · ${x.label}`}><span class:list={['trend-bar',x.kind==='evidence'&&'is-evidence']} style={`height:${Math.max(10,(x.value/trendMax)*100)}%`}><i>{brl.format(x.value)}</i></span><small>{x.date.slice(8,10)}</small></div>)}
          </div>
        </article>
        <article class="economics-panel">
          <div class="subheading"><div><span>Unit economics</span><strong>Por turno consolidado</strong></div></div>
          <dl>
            <div><dt>Lucro / hora</dt><dd>{brl.format(profitPerHour)}</dd></div>
            <div><dt>Receita / viagem</dt><dd>{brl.format(revenuePerTrip)}</dd></div>
            <div><dt>Viagens / hora</dt><dd>{num.format(tripsPerHour)}</dd></div>
            <div><dt>Combustível / km</dt><dd>{brl.format(fuelPerKm)}</dd></div>
            <div><dt>Combustível pago</dt><dd>{brl.format(fuelTotal)}</dd></div>
            <div><dt>Manutenção registrada</dt><dd>{brl.format(maintenanceTotal)}</dd></div>
          </dl>
        </article>
      </div>
      <div class="market-rankings">
        <article><span>Melhores dias</span>{weekdayScores.slice(0,4).map((x,i)=><div><b>{i+1}</b><strong>{x.label}</strong><em>{brl.format(x.profitPerHour)}/h</em></div>)}</article>
        <article><span>Melhores horários</span>{hourScores.slice(0,4).map((x,i)=><div><b>{i+1}</b><strong>{x.key}</strong><em>{brl.format(x.revenuePerRideHour)}/h</em></div>)}</article>
        <article><span>Melhores regiões</span>{regionScores.slice(0,4).map((x,i)=><div><b>{i+1}</b><strong>{x.key}</strong><em>{x.score}/100</em></div>)}</article>
      </div>
    </section>

    <section class="product-section" id="atividade">
      <div class="section-heading"><div><span>Histórico</span><h2>Atividade recente</h2></div><a href="./inteligencia">Analisar corridas →</a></div>
      <div class="activity-layout">
        <div class="activity-list">
          {recentActivity.map(x=><article><time datetime={x.date}>{x.dateBR}</time><div><strong>{x.kind==='closed'?'Fechamento completo':'Evidência operacional'}</strong><small>{x.label}</small></div><b>{brl.format(x.value)}</b><span class:list={['activity-status',x.kind==='closed'?'is-closed':'is-pending']}>{x.kind==='closed'?'fechado':'reconciliar'}</span></article>)}
        </div>
        <article class="latest-operation">
          <span>Última operação observada</span>
          <strong>{brl.format(latestEvidence.platformRevenue??0)}</strong>
          <p>{latestEvidence.completedTrips} corridas · {num.format(latestEvidence.observedRideKm??0)} km em corrida · {num.format(latestEvidence.observedRideHours??0)} h em viagem</p>
          <small>{latestEvidence.note}</small>
        </article>
      </div>
    </section>

    <section class="product-section split-business" id="particular">
      <div class="business-summary">
        <div class="section-heading"><div><span>Receita própria</span><h2>Particular</h2></div><span>{brl.format(pipelineTotal)} em pipeline</span></div>
        <div class="business-kpis"><div><span>Preço base</span><strong>{brl.format(privatePricingPolicy.basePerKm)}/km</strong></div><div><span>Mínimo agendado</span><strong>{brl.format(privatePricingPolicy.scheduledMinimum)}</strong></div><div><span>Reserva</span><strong>{brl.format(privatePricingPolicy.reservationFee)}</strong></div></div>
      </div>
      <div class="pipeline-list">{privatePipeline.map(x=><article><time>{x.serviceDate.slice(8,10)}/09</time><div><strong>{x.label}</strong><small>{x.appointment} · retirada {x.provisionalPickup}</small></div><b>{brl.format(x.quotedValue)}</b></article>)}</div>
    </section>

    <section class="product-section vehicle-data-grid" id="veiculo">
      <article><div class="section-heading"><div><span>Ativo operacional</span><h2>{vehicleProfile.vehicle}</h2></div><span>{vehicleProfile.fuel}</span></div><dl><div><dt>Odômetro recente</dt><dd>{num.format(vehicleProfile.recentOdometerKm)} km</dd></div><div><dt>Abastecimentos</dt><dd>{currentFuelings.length}</dd></div><div><dt>Manutenções</dt><dd>{currentVehicleExpenses.length}</dd></div><div><dt>Custo combustível ago.</dt><dd>{brl.format(fuelTotal)}</dd></div></dl></article>
      <article id="dados"><div class="section-heading"><div><span>Qualidade</span><h2>Dados</h2></div><a href="./fontes-contexto">Auditar fontes →</a></div><dl><div><dt>Supabase</dt><dd>{dataHealth.supabaseStatus}</dd></div><div><dt>Último fechamento</dt><dd>{dataHealth.supabaseCompleteThrough.split('-').reverse().join('/')}</dd></div><div><dt>Lacunas</dt><dd>{dataHealth.missingClosingDates.length}</dd></div><div><dt>Corridas detalhadas</dt><dd>{predictiveIntelligence.sample.detailedRides}</dd></div></dl></article>
    </section>

    <section class="product-section quick-links-section">
      <div class="section-heading"><div><span>Explorar</span><h2>Módulos operacionais</h2></div></div>
      <div class="quick-links">{quickLinks.map(([title,detail,href])=><a href={href}><div><strong>{title}</strong><small>{detail}</small></div><b>↗</b></a>)}</div>
    </section>

    <footer class="product-footer"><strong>MOTORISTA OPS</strong><span>Performance · decisão · contexto · operação</span><small>Confirmado, estimado e desconhecido continuam separados.</small></footer>
  </main>
</div>
<script>import '../scripts/dashboard-live.ts';</script>
</BaseLayout>
