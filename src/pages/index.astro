---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  currentClosings,
  currentVehicleExpenses,
  currentFuelings,
  personalMonthlyExpenses,
  vehicleProfile
} from '../data/current-ops';
import { evidenceDays, privatePricingPolicy, privatePipeline, dataHealth } from '../data/dashboard-refresh';

const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
const num = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 1 });
const pct = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 0 });

const completeAugust = currentClosings.filter((item) => item.date.startsWith('2026-08'));
const sum = (items: readonly any[], key: string) => items.reduce((total, item) => total + (Number(item[key]) || 0), 0);
const consolidatedRevenue = sum(completeAugust, 'grossRevenue');
const consolidatedProfit = sum(completeAugust, 'operationalProfit');
const consolidatedHours = sum(completeAugust, 'hoursOnline');
const consolidatedKm = sum(completeAugust, 'kmTotal');
const consolidatedTrips = sum(completeAugust, 'tripsTotal');
const evidenceRevenue = evidenceDays.filter((item) => item.status === 'evidence-only').reduce((total, item) => total + (item.platformRevenue || 0), 0);
const observedRevenue = consolidatedRevenue + evidenceRevenue;
const personalExpenseTotal = personalMonthlyExpenses.reduce((total, item) => total + Number(item[1]), 0);
const maintenanceTotal = currentVehicleExpenses.reduce((total, item) => total + item.value, 0);
const fuelingPaidTotal = currentFuelings.filter((item) => item.date.startsWith('2026-08')).reduce((total, item) => total + item.totalPaid, 0);
const latestComplete = completeAugust.at(-1)!;
const latestEvidence = evidenceDays.at(-1)!;
const privatePipelineTotal = privatePipeline.reduce((total, item) => total + item.quotedValue, 0);
const completeAvgPerHour = consolidatedHours ? consolidatedRevenue / consolidatedHours : 0;
const completeProfitPerHour = consolidatedHours ? consolidatedProfit / consolidatedHours : 0;
const completeRevenuePerKm = consolidatedKm ? consolidatedRevenue / consolidatedKm : 0;
const personalCoverage = personalExpenseTotal ? consolidatedProfit / personalExpenseTotal * 100 : 0;
const chartRows = [
  ...completeAugust.map((item) => ({ dateBR: item.dateBR.slice(0, 5), value: item.grossRevenue, quality: 'complete' as const })),
  ...evidenceDays.filter((item) => item.status === 'evidence-only').map((item) => ({ dateBR: item.dateBR.slice(0, 5), value: item.platformRevenue || 0, quality: 'evidence' as const }))
];
const chartMax = Math.max(...chartRows.map((item) => item.value), 1);
const lastFueling = currentFuelings.at(-1);
---

<BaseLayout title="MotoristaOPS — Controle operacional">
  <div class="shell">
    <aside class="rail">
      <a class="brand" href="#agora" aria-label="Motorista Ops — início">
        <span class="brand-mark">MO</span>
        <span><strong>MOTORISTA OPS</strong><small>controle operacional</small></span>
      </a>

      <nav aria-label="Seções do dashboard">
        <a href="#agora" class="active">Agora</a>
        <a href="#fechamentos">Fechamentos</a>
        <a href="#evidencias">Qualidade dos dados</a>
        <a href="#particular">Particular</a>
        <a href="#caixa">Caixa</a>
        <a href="#veiculo">Veículo</a>
        <a href="#dados">Dados & importação</a>
      </nav>

      <div class="rail-status">
        <span class="pulse"></span>
        <div><strong>Supabase saudável</strong><small>estrutura ativa · dados ainda em reconciliação</small></div>
      </div>
    </aside>

    <main>
      <section id="agora" class="hero">
        <div class="eyebrow"><span>17 AGO 2026</span><i></i><span>snapshot operacional</span></div>
        <div class="hero-grid">
          <div>
            <h1>O dashboard volta a mostrar o que está acontecendo <em>agora.</em></h1>
            <p class="lead">Separando fechamento completo, evidência de app e dado ausente. Sem transformar print parcial em lucro, km ou custo inventado.</p>
            <div class="hero-actions">
              <a class="button primary" href="./importar-uber">Importar corridas</a>
              <a class="button" href="./historico-importacoes">Histórico de importações</a>
              <a class="button ghost" href="./motorista">Perfil público</a>
            </div>
          </div>
          <div class="today-card">
            <div class="today-head"><span>Ganhos observados hoje</span><span class="badge warning">aguarda fechamento operacional</span></div>
            <strong>{brl.format(latestEvidence.platformRevenue || 0)}</strong>
            <p>{latestEvidence.completedTrips} corridas concluídas · {latestEvidence.paidCancellations} cancelamento pago · {latestEvidence.unpaidCancellations} sem pagamento</p>
            <div class="today-foot"><span>Fonte: sequência de prints do app</span><span>até “Fim das atividades”</span></div>
          </div>
        </div>
      </section>

      <section class="kpis" aria-label="Indicadores principais">
        <article class="kpi featured">
          <span>Receita consolidada · agosto</span>
          <strong>{brl.format(consolidatedRevenue)}</strong>
          <small>{completeAugust.length} fechamentos completos até {latestComplete.dateBR}</small>
        </article>
        <article class="kpi evidence-kpi">
          <span>Receita observada · pendente</span>
          <strong>+ {brl.format(evidenceRevenue)}</strong>
          <small>12, 13, 16 e 17/08 · não entra no lucro ainda</small>
        </article>
        <article class="kpi">
          <span>Lucro operacional consolidado</span>
          <strong>{brl.format(consolidatedProfit)}</strong>
          <small>{brl.format(completeProfitPerHour)}/h nos fechamentos completos</small>
        </article>
        <article class="kpi">
          <span>Horas consolidadas</span>
          <strong>{num.format(consolidatedHours)} h</strong>
          <small>{brl.format(completeAvgPerHour)}/h de receita bruta</small>
        </article>
        <article class="kpi">
          <span>Quilometragem consolidada</span>
          <strong>{num.format(consolidatedKm)} km</strong>
          <small>{brl.format(completeRevenuePerKm)}/km de receita</small>
        </article>
        <article class="kpi danger-kpi">
          <span>Lacunas explícitas</span>
          <strong>{dataHealth.missingClosingDates.length} dias</strong>
          <small>14 e 15/08 sem evidência localizada</small>
        </article>
      </section>

      <section class="grid-2 section-block">
        <article class="panel" id="fechamentos">
          <div class="panel-title">
            <div><span class="section-code">01</span><h2>Evolução de receita</h2></div>
            <div class="legend"><span><i class="dot complete"></i> completo</span><span><i class="dot evidence"></i> evidência</span></div>
          </div>
          <p class="panel-intro">A barra cheia é fechamento operacional. A barra tracejada mostra apenas ganho confirmado no app, ainda sem custo, horas e km totais.</p>
          <div class="bars">
            {chartRows.map((item) => (
              <div class="bar-row">
                <span>{item.dateBR}</span>
                <div class={`bar-track ${item.quality}`}><i style={`width:${Math.max(4, item.value / chartMax * 100)}%`}></i></div>
                <strong>{brl.format(item.value)}</strong>
              </div>
            ))}
          </div>
          <div class="panel-callout">
            <span>Receita observada no período coberto</span>
            <strong>{brl.format(observedRevenue)}</strong>
            <small>Não é “receita fechada do mês”: inclui {brl.format(evidenceRevenue)} ainda em reconciliação.</small>
          </div>
        </article>

        <article class="panel decision">
          <div class="panel-title"><div><span class="section-code">02</span><h2>Centro de decisão</h2></div></div>
          <div class="decision-list">
            <div class="decision-item priority">
              <span class="decision-icon">!</span>
              <div><strong>Fechar 17/08 operacionalmente</strong><p>Ganhos do app já estão completos, mas faltam horas totais, km, combustível e qualquer receita fora da Uber.</p></div>
            </div>
            <div class="decision-item">
              <span class="decision-icon">↻</span>
              <div><strong>Reconciliar 12 e 13/08</strong><p>13/08 tem sequência completa do app. 12/08 tem apenas o fim do histórico; não pode virar total do dia.</p></div>
            </div>
            <div class="decision-item">
              <span class="decision-icon">?</span>
              <div><strong>Resolver 14 e 15/08</strong><p>Nenhum fechamento foi localizado. Confirmar folga ou recuperar os registros.</p></div>
            </div>
            <div class="decision-item good">
              <span class="decision-icon">✓</span>
              <div><strong>Banco voltou ao ar</strong><p>Supabase está ACTIVE_HEALTHY e a arquitetura de fechamento, metas, custos, importações e manutenção existe.</p></div>
            </div>
          </div>
        </article>
      </section>

      <section id="evidencias" class="section-block">
        <div class="section-heading">
          <div><span class="section-code">03</span><h2>Qualidade dos dados</h2></div>
          <p>O estado de cada dia agora é uma informação de primeira classe do produto.</p>
        </div>
        <div class="quality-grid">
          {evidenceDays.map((item) => (
            <article class={`quality-card ${item.status}`}>
              <div class="quality-head"><strong>{item.dateBR}</strong><span>{item.label}</span></div>
              <span class="quality-status">{item.status === 'missing' ? 'sem dado' : item.observedMinimum ? 'mínimo observado' : 'evidência do app'}</span>
              {item.platformRevenue !== undefined && <strong class="quality-value">{item.observedMinimum ? '≥ ' : ''}{brl.format(item.platformRevenue)}</strong>}
              {item.paidEntries !== undefined && <small>{item.paidEntries} lançamentos com valor</small>}
              <p>{item.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="particular" class="section-block">
        <div class="section-heading">
          <div><span class="section-code">04</span><h2>Operação particular</h2></div>
          <p>Precificação virou regra operacional; orçamento futuro não entra como receita realizada.</p>
        </div>

        <div class="grid-2 private-grid">
          <article class="panel pricing-card">
            <div class="pricing-hero"><span>Política {privatePricingPolicy.version}</span><strong>{brl.format(privatePricingPolicy.basePerKm)}<small>/km</small></strong><p>base de referência para particular</p></div>
            <div class="rules">
              <div><span>Mínimo agendado</span><strong>{brl.format(privatePricingPolicy.scheduledMinimum)}</strong></div>
              <div><span>Reserva / agendamento</span><strong>{brl.format(privatePricingPolicy.reservationFee)}</strong></div>
              <div><span>Espera</span><strong>{privatePricingPolicy.waitingToleranceMin} min + {brl.format(privatePricingPolicy.waitingPerMin)}/min</strong></div>
              <div><span>Parada adicional</span><strong>+ {brl.format(privatePricingPolicy.additionalScheduledStop)}</strong></div>
              <div><span>Horário especial</span><strong>{privatePricingPolicy.specialHours} · +{privatePricingPolicy.specialHoursSurchargePct}%</strong></div>
              <div><span>Pedágio / estacionamento</span><strong>{privatePricingPolicy.tollsAndParking}</strong></div>
            </div>
            <p class="fineprint">Alteração relevante de rota exige recálculo. No-show pode chegar a 100% do serviço. Retorno vazio não é somado quando a operação continua após o desembarque.</p>
          </article>

          <article class="panel pipeline-card">
            <div class="panel-title"><div><h3>Orçamentos em radar</h3><small>{brl.format(privatePipelineTotal)} cotados · não realizados</small></div></div>
            {privatePipeline.map((item) => (
              <div class="service-row">
                <div class="service-date"><strong>{item.serviceDate.slice(8,10)}</strong><span>SET</span></div>
                <div class="service-main">
                  <div><strong>{item.label}</strong><span class="badge neutral">{item.status}</span></div>
                  <p>Compromisso {item.appointment} · retirada provisória {item.provisionalPickup}</p>
                  <small>{item.destination} · {item.informedDistanceKm} km informados</small>
                  <small>Revisar trânsito por volta de {item.trafficReviewAround}</small>
                </div>
                <strong class="service-value">{brl.format(item.quotedValue)}</strong>
              </div>
            ))}
          </article>
        </div>
      </section>

      <section id="caixa" class="section-block">
        <div class="section-heading">
          <div><span class="section-code">05</span><h2>Caixa e obrigações</h2></div>
          <p>Operação do carro e vida pessoal continuam separadas para não mascarar desempenho.</p>
        </div>
        <div class="kpis compact">
          <article class="kpi"><span>Despesas pessoais mensais</span><strong>{brl.format(personalExpenseTotal)}</strong><small>{personalMonthlyExpenses.length} itens recorrentes mapeados</small></article>
          <article class="kpi"><span>Cobertura pelo lucro consolidado</span><strong>{pct.format(personalCoverage)}%</strong><small>com fechamentos completos de agosto até 11/08</small></article>
          <article class="kpi"><span>Manutenção registrada</span><strong>{brl.format(maintenanceTotal)}</strong><small>investimento separado do lucro operacional diário</small></article>
          <article class="kpi"><span>Abastecimentos pagos · agosto</span><strong>{brl.format(fuelingPaidTotal)}</strong><small>sem contar cortesia de 03/08</small></article>
        </div>
        <div class="obligations">
          {personalMonthlyExpenses.map(([label, value]) => (
            <div><span>{label}</span><strong>{brl.format(Number(value))}</strong></div>
          ))}
        </div>
      </section>

      <section id="veiculo" class="section-block grid-2">
        <article class="panel vehicle-card">
          <div class="panel-title"><div><span class="section-code">06</span><h2>Veículo</h2></div></div>
          <div class="vehicle-name"><span>Operação atual</span><strong>{vehicleProfile.vehicle}</strong></div>
          <div class="vehicle-stats">
            <div><span>Combustível</span><strong>{vehicleProfile.fuel}</strong></div>
            <div><span>Odômetro recente</span><strong>{num.format(vehicleProfile.recentOdometerKm)} km</strong></div>
            <div><span>Último abastecimento</span><strong>{lastFueling ? brl.format(lastFueling.pricePerLiter) + '/L' : '—'}</strong></div>
            <div><span>Consumo recente</span><strong>{lastFueling?.consumptionKmL ? num.format(lastFueling.consumptionKmL) + ' km/L' : '—'}</strong></div>
          </div>
          <h3>Manutenção registrada</h3>
          <div class="maintenance-list">
            {currentVehicleExpenses.map((item) => (
              <div><span>{item.dateBR}<small>{item.description}</small></span><strong>{brl.format(item.value)}</strong></div>
            ))}
          </div>
        </article>

        <article class="panel fueling-card">
          <div class="panel-title"><div><h2>Abastecimentos</h2><small>histórico recente</small></div></div>
          <div class="fueling-list">
            {[...currentFuelings].reverse().map((item) => (
              <div class="fuel-row">
                <span>{item.dateBR}</span>
                <div><strong>{num.format(item.liters)} L</strong><small>{brl.format(item.pricePerLiter)}/L</small></div>
                <div><strong>{brl.format(item.totalPaid)}</strong><small>{item.totalPaid === 0 ? 'cortesia' : 'pago'}</small></div>
              </div>
            ))}
          </div>
        </article>
      </section>

      <section id="dados" class="section-block data-section">
        <div class="section-heading">
          <div><span class="section-code">07</span><h2>Dados & reconciliação</h2></div>
          <p>O próximo estado do produto é banco como fonte operacional, importação como entrada e evidência como fila de revisão.</p>
        </div>
        <div class="data-grid">
          <article><span class="status-dot good"></span><div><strong>Supabase</strong><p>ACTIVE_HEALTHY · tabelas de fechamento, métricas, snapshots, despesas, metas, combustível, manutenção, anexos e imports disponíveis.</p></div></article>
          <article><span class="status-dot warning"></span><div><strong>Banco operacional</strong><p>Último fechamento hoje no banco: {dataHealth.supabaseCompleteThrough.split('-').reverse().join('/')}. Precisa receber os fechamentos completos já existentes no frontend.</p></div></article>
          <article><span class="status-dot warning"></span><div><strong>Frontend consolidado</strong><p>Fechamentos completos chegam até {dataHealth.lastCompleteClosing.split('-').reverse().join('/')}; evidências chegam até {dataHealth.latestEvidenceDate.split('-').reverse().join('/')}.</p></div></article>
          <article><span class="status-dot danger"></span><div><strong>Fila de revisão</strong><p>12 e 13/08 precisam virar fechamento operacional; 14 e 15/08 precisam ser confirmados; 16 e 17/08 precisam de horas, km e custos.</p></div></article>
        </div>
        <div class="data-actions">
          <a class="button primary" href="./importar-uber">Abrir importador</a>
          <a class="button" href="./historico-importacoes">Ver histórico</a>
        </div>
      </section>

      <footer>
        <span>MOTORISTA OPS <small>por HENRICO AMARAL</small></span>
        <p>Mobilidade particular com método, presença e cuidado humano.</p>
        <small>Snapshot reorganizado em 17/08/2026 · dados incompletos permanecem explicitamente incompletos.</small>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  :global(html){scroll-behavior:smooth;background:#0b0c0d}
  :global(body){margin:0;background:#0b0c0d;color:#f2efe9;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  :global(*){box-sizing:border-box}
  :global(a){color:inherit}
  .shell{min-height:100vh;display:grid;grid-template-columns:240px minmax(0,1fr)}
  .rail{position:sticky;top:0;height:100vh;padding:28px 20px;border-right:1px solid #2b2e32;background:#0b0c0d;display:flex;flex-direction:column;z-index:10}
  .brand{display:flex;align-items:center;gap:12px;text-decoration:none;margin-bottom:42px}.brand-mark{width:38px;height:38px;border:1px solid #c8a96b;border-radius:50%;display:grid;place-items:center;color:#c8a96b;font-size:11px;font-weight:800;letter-spacing:.08em}.brand strong{font-size:12px;letter-spacing:.12em}.brand small{display:block;color:#777b80;font-size:10px;margin-top:3px;letter-spacing:.08em;text-transform:uppercase}
  nav{display:grid;gap:5px}nav a{padding:10px 12px;text-decoration:none;color:#8f9398;font-size:13px;border-radius:8px;transition:.2s}nav a:hover,nav a.active{background:#181a1d;color:#f2efe9}nav a.active{border-left:2px solid #c8a96b}
  .rail-status{margin-top:auto;padding:14px 12px;border:1px solid #2b2e32;border-radius:10px;background:#131416;display:flex;gap:10px;align-items:flex-start}.pulse{width:8px;height:8px;border-radius:50%;background:#79a982;margin-top:4px;box-shadow:0 0 0 4px rgba(121,169,130,.08)}.rail-status strong{font-size:11px}.rail-status small{display:block;color:#73777c;font-size:9px;line-height:1.5;margin-top:3px}
  main{min-width:0;padding:0 46px 54px;max-width:1540px;width:100%;margin:0 auto}
  .hero{padding:56px 0 30px;border-bottom:1px solid #2b2e32}.eyebrow{display:flex;align-items:center;gap:12px;color:#96999d;font-size:10px;letter-spacing:.16em;text-transform:uppercase}.eyebrow i{width:44px;height:1px;background:#c8a96b}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(320px,.75fr);gap:54px;align-items:end;margin-top:30px}.hero h1{max-width:830px;font-size:clamp(34px,4vw,62px);line-height:1.02;letter-spacing:-.045em;margin:0;font-weight:650}.hero h1 em{font-style:normal;color:#c8a96b}.lead{max-width:740px;color:#989b9f;line-height:1.7;font-size:15px;margin:24px 0 0}.hero-actions,.data-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.button{display:inline-flex;align-items:center;justify-content:center;padding:10px 14px;border:1px solid #35383c;border-radius:7px;text-decoration:none;font-size:11px;font-weight:650;letter-spacing:.03em;background:#181a1d;color:#d9d5cf}.button.primary{background:#c8a96b;color:#0b0c0d;border-color:#c8a96b}.button.ghost{background:transparent}
  .today-card{border:1px solid #34373a;border-radius:16px;padding:22px;background:linear-gradient(145deg,#181a1d,#101113)}.today-head{display:flex;justify-content:space-between;gap:12px;align-items:center;color:#9fa2a6;font-size:10px;text-transform:uppercase;letter-spacing:.08em}.badge{display:inline-flex;padding:5px 7px;border-radius:999px;font-size:8px;letter-spacing:.05em;text-transform:uppercase}.badge.warning{background:rgba(200,169,107,.12);color:#d8bd86}.badge.neutral{background:#26292d;color:#aeb1b5}.today-card>strong{display:block;font-size:44px;letter-spacing:-.04em;margin-top:30px}.today-card p{color:#b3b5b7;font-size:12px;line-height:1.6}.today-foot{display:flex;justify-content:space-between;gap:8px;color:#6f7377;font-size:9px;border-top:1px solid #2b2e32;padding-top:14px;margin-top:22px}
