---
import BaseLayout from '../layouts/BaseLayout.astro';
import legacy from '../data/motoristaops.json';
import { currentClosings, currentVehicleExpenses, currentFuelings, personalMonthlyExpenses, vehicleProfile } from '../data/current-ops';
import { strategicIntelligence as intel } from '../data/strategic-intelligence';

const money = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const number = new Intl.NumberFormat('pt-BR',{maximumFractionDigits:2});
const percent = new Intl.NumberFormat('pt-BR',{style:'percent',maximumFractionDigits:0});
const base = import.meta.env.BASE_URL || '/';
const importUrl = `${base}importar-uber`;
const legacyDaily = Array.isArray((legacy as any).daily) ? (legacy as any).daily : [];
const mergedMap = new Map<string, any>(); legacyDaily.forEach((row:any)=>mergedMap.set(row.date,row)); currentClosings.forEach((row:any)=>mergedMap.set(row.date,row));
const closings=[...mergedMap.values()].sort((a,b)=>String(b.date).localeCompare(String(a.date)));
const currentMonth=closings[0]?.date?.slice(0,7)??'2026-08'; const monthRows=closings.filter((r:any)=>r.date?.startsWith(currentMonth));
const sum=(rows:any[],key:string)=>rows.reduce((t,r)=>t+Number(r[key]??0),0);
const monthRevenue=sum(monthRows,'grossRevenue'), monthProfit=sum(monthRows,'operationalProfit'), monthHours=sum(monthRows,'hoursOnline'), monthKm=sum(monthRows,'kmTotal'), monthTrips=sum(monthRows,'tripsTotal');
const monthUber=sum(monthRows,'revenueUber'), month99=sum(monthRows,'revenue99'), monthPrivate=sum(monthRows,'revenuePrivate');
const historicRevenue=sum(closings,'grossRevenue'), historicTrips=sum(closings,'tripsTotal'), historicDays=closings.filter((r:any)=>Number(r.grossRevenue??0)>0).length;
const personalMonthlyTotal=personalMonthlyExpenses.reduce((t,item)=>t+item[1],0), maintenanceTotal=currentVehicleExpenses.filter(i=>i.category.includes('Manutenção')).reduce((t,i)=>t+i.value,0), recentFuelPaid=currentFuelings.reduce((t,i)=>t+i.totalPaid,0);
const latestFuelEfficiency=[...currentFuelings].reverse().find(i=>i.consumptionKmL)?.consumptionKmL??null, latest=closings[0];
const monthLabel=new Intl.DateTimeFormat('pt-BR',{month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(`${currentMonth}-01T00:00:00Z`));
const chartRows=[...monthRows].sort((a,b)=>String(a.date).localeCompare(String(b.date))), chartMax=Math.max(1,...chartRows.map((r:any)=>Number(r.grossRevenue??0)));
const chartData=chartRows.map((r:any)=>({...r,chartHeight:Math.max(8,Number(r.grossRevenue??0)/chartMax*100),chartTitle:`${r.dateBR??r.date} · ${money.format(Number(r.grossRevenue??0))}`,chartDay:String(r.date).slice(8)}));
const monthDays=Math.max(1,monthRows.filter((r:any)=>Number(r.grossRevenue??0)>0).length), avgRevenueDay=monthRevenue/monthDays, avgTripsDay=monthTrips/monthDays, avgTicket=monthTrips?monthRevenue/monthTrips:0;
const coverage=personalMonthlyTotal?monthProfit/personalMonthlyTotal:0, netAfterPersonal=monthProfit-personalMonthlyTotal, operatingMargin=monthRevenue?monthProfit/monthRevenue:0, latestProfitPerHour=Number(latest?.hoursOnline??0)?Number(latest?.operationalProfit??0)/Number(latest?.hoursOnline??0):0;
const platformTotal=Math.max(1,monthUber+month99+monthPrivate), platformMix=[{name:'Uber',value:monthUber,share:monthUber/platformTotal},{name:'99',value:month99,share:month99/platformTotal},{name:'Particular',value:monthPrivate,share:monthPrivate/platformTotal}];
---
<BaseLayout title="MotoristaOps · Painel de controle da operação">
<div class="app-shell app-shell--open"><aside class="sidebar"><div class="sidebar-brand"><span>MO</span><div><strong>MotoristaOps</strong><small>Controle da operação</small></div></div><nav aria-label="Navegação do painel"><button class="nav-item active" data-section="overview">Visão geral</button><button class="nav-item" data-section="intelligence">Inteligência</button><button class="nav-item" data-section="closings">Fechamentos</button><button class="nav-item" data-section="expenses">Despesas mensais</button><button class="nav-item" data-section="maintenance">Manutenção</button><button class="nav-item" data-section="fuelings">Abastecimentos</button><button class="nav-item" data-section="vehicle">Veículo</button></nav><div class="sidebar-bottom"><span class="sidebar-status"><i></i> operação ativa</span><a class="nav-item nav-link" href={`${base}motorista/`}>Landing Page ↗</a></div></aside>
<section class="workspace"><header class="workspace-header workspace-header--control"><div><div class="workspace-live"><span><i></i> MotoristaOps ao vivo</span><time id="live-clock">--:--</time></div><p class="eyebrow">Painel de controle</p><h1>Sua operação,<br/>sem ruído.</h1><p>Receita, eficiência, custos e inteligência operacional em uma leitura única.</p></div><div class="header-actions"><a class="button button--gold" href={importUrl}>Importar corridas</a><button class="button button--ghost" data-section="intelligence">Ver inteligência</button></div></header>
<section id="overview" class="workspace-section"><div class="control-strip"><article><span>Snapshot</span><strong>{latest?.dateBR??latest?.date}</strong><small>último fechamento</small></article><article class={coverage>=1?'control-positive':'control-alert'}><span>Cobertura pessoal</span><strong>{percent.format(coverage)}</strong><small>lucro / despesas mensais</small></article><article><span>Consumo recente</span><strong>{latestFuelEfficiency?`${number.format(latestFuelEfficiency)} km/L`:'—'}</strong><small>etanol · ref. {money.format(vehicleProfile.referenceFuelPrice)}/L</small></article><article><span>Particular</span><strong>{money.format(monthPrivate)}</strong><small>receita própria no mês</small></article></div>
<div class="section-title"><div><span>{monthLabel}</span><h2>Pulso da operação</h2></div><p>Fechamentos registrados e consolidados.</p></div><div class="metric-grid"><article class="metric-card metric-card--signal"><span>Receita do mês</span><strong>{money.format(monthRevenue)}</strong><small>{money.format(avgRevenueDay)} / dia</small></article><article class="metric-card"><span>Lucro operacional</span><strong>{money.format(monthProfit)}</strong><small>{percent.format(operatingMargin)} de margem</small></article><article class="metric-card" data-state={netAfterPersonal>=0?'positive':'negative'}><span>Após despesas pessoais</span><strong>{money.format(netAfterPersonal)}</strong><small>{money.format(personalMonthlyTotal)} / mês</small></article><article class="metric-card"><span>Horas</span><strong>{number.format(monthHours)}h</strong><small>{monthHours?`${money.format(monthRevenue/monthHours)}/h bruto`:'—'}</small></article><article class="metric-card"><span>Km</span><strong>{number.format(monthKm)} km</strong><small>{monthKm?`${money.format(monthRevenue/monthKm)}/km bruto`:'—'}</small></article><article class="metric-card"><span>Viagens</span><strong>{number.format(monthTrips)}</strong><small>{number.format(avgTripsDay)} / dia · ticket {money.format(avgTicket)}</small></article></div>
<div class="dashboard-grid dashboard-grid--command"><article class="panel panel--chart"><div class="panel-head"><div><span>Ritmo</span><h2>Receita por fechamento</h2></div><small>{monthRows.length} registros</small></div><div class="daily-chart">{chartData.map((r:any)=><div class="chart-bar" title={r.chartTitle}><span style={`height:${r.chartHeight}%`}></span><small>{r.chartDay}</small></div>)}</div></article><article class="panel latest-card"><div class="panel-head"><div><span>Último fechamento</span><h2>{latest?.dateBR??latest?.date}</h2></div><span class="status-pill">consolidado</span></div><div class="latest-summary"><strong>{money.format(Number(latest?.grossRevenue??0))}</strong><span>{latest?.platform??'—'}</span><div class="latest-grid"><div><b>{Number(latest?.tripsTotal??0)}</b><small>viagens</small></div><div><b>{number.format(Number(latest?.hoursOnline??0))}h</b><small>trabalho</small></div><div><b>{number.format(Number(latest?.kmTotal??0))}</b><small>km</small></div><div><b>{money.format(latestProfitPerHour)}</b><small>lucro/h</small></div></div></div></article></div>
<div class="dashboard-grid dashboard-grid--balanced"><article class="panel mix-card"><div class="panel-head"><div><span>Composição</span><h2>De onde vem a receita</h2></div></div><div class="mix-list">{platformMix.map(i=><div class="mix-row"><div><strong>{i.name}</strong><span>{money.format(i.value)}</span></div><div class="mix-track"><i style={`width:${Math.max(2,i.share*100)}%`}></i></div><small>{percent.format(i.share)}</small></div>)}</div></article><article class="panel action-card"><div class="panel-head"><div><span>Decisão</span><h2>Centro de inteligência</h2></div></div><div class="action-list"><button data-section="intelligence"><span>Melhores dias, horários e locais</span><b>Abrir análise estratégica</b><i>→</i></button><a href={importUrl}><span>Importar novo fechamento</span><b>Adicionar e revisar corridas</b><i>↗</i></a></div></article></div></section>
<section id="intelligence" class="workspace-section" hidden><div class="section-title"><div><span>Inteligência operacional</span><h2>Quando e onde trabalhar.</h2></div><p>Ranking baseado em dados reais. Amostras pequenas são explicitadas para evitar falsa precisão.</p></div><div class="metric-grid"><article class="metric-card metric-card--signal"><span>Maior faturamento</span><strong>{money.format(intel.bestRevenueDay.grossRevenue)}</strong><small>{intel.bestRevenueDay.dateBR} · {money.format(intel.bestRevenueDay.revenuePerHour)}/h</small></article><article class="metric-card"><span>Melhor R$/h</span><strong>{money.format(intel.bestRevenuePerHourDay.revenuePerHour)}/h</strong><small>{intel.bestRevenuePerHourDay.dateBR} · {number.format(intel.bestRevenuePerHourDay.hoursOnline)}h</small></article><article class="metric-card"><span>Melhor R$/km</span><strong>{money.format(intel.bestRevenuePerKmDay.revenuePerKm)}/km</strong><small>{intel.bestRevenuePerKmDay.dateBR}</small></article><article class="metric-card" data-state="negative"><span>Pior R$/h recente</span><strong>{money.format(intel.worstRevenuePerHourDay.revenuePerHour)}/h</strong><small>{intel.worstRevenuePerHourDay.dateBR}</small></article></div>
<div class="dashboard-grid dashboard-grid--balanced"><article class="panel table-panel"><div class="panel-head"><div><span>Dia da semana</span><h2>Eficiência acumulada</h2></div></div><table><thead><tr><th>Dia</th><th>Amostra</th><th>R$/h</th><th>R$/km</th></tr></thead><tbody>{intel.weekdayRanking.map(i=><tr><td>{i.day}</td><td>{i.days} dia(s)</td><td>{money.format(i.revenuePerHour)}</td><td>{money.format(i.revenuePerKm)}</td></tr>)}</tbody></table></article><article class="panel table-panel"><div class="panel-head"><div><span>Faixas horárias</span><h2>Melhores janelas</h2></div></div><table><thead><tr><th>Horário</th><th>Corridas</th><th>Receita</th><th>R$/h em corrida</th></tr></thead><tbody>{intel.hourRanking.slice(0,8).map(i=><tr><td>{i.key}</td><td>{i.rides}</td><td>{money.format(i.revenue)}</td><td>{i.revenuePerHour?money.format(i.revenuePerHour):'—'}</td></tr>)}</tbody></table></article></div>
<div class="dashboard-grid dashboard-grid--balanced"><article class="panel table-panel"><div class="panel-head"><div><span>Origem</span><h2>Regiões mais produtivas</h2></div></div><table><thead><tr><th>Região</th><th>Corridas</th><th>Receita</th><th>R$/h em corrida</th></tr></thead><tbody>{intel.regionRanking.slice(0,8).map(i=><tr><td>{i.key}</td><td>{i.rides}</td><td>{money.format(i.revenue)}</td><td>{i.revenuePerHour?money.format(i.revenuePerHour):'—'}</td></tr>)}</tbody></table></article><article class="panel strategic-card"><span>{intel.trafficContext.label}</span><h2>Trânsito entra na decisão.</h2><p>{intel.trafficContext.description}</p><p><strong>Próxima camada:</strong> cruzar cada fechamento com trânsito observado, incidentes e eventos para distinguir dia ruim de estratégia ruim.</p></article></div><div class="panel"><small>{intel.sampleNotice}</small></div></section>
<section id="closings" class="workspace-section" hidden><div class="section-title"><div><span>Histórico operacional</span><h2>Fechamentos</h2></div></div><div class="panel table-panel"><table><thead><tr><th>Data</th><th>Plataforma</th><th>Receita</th><th>Lucro</th><th>Horas</th><th>Km</th><th>Viagens</th></tr></thead><tbody>{closings.map((r:any)=><tr><td>{r.dateBR??r.date}</td><td>{r.platform??'—'}</td><td>{money.format(Number(r.grossRevenue??0))}</td><td>{money.format(Number(r.operationalProfit??0))}</td><td>{r.hoursOnline==null?'—':`${number.format(Number(r.hoursOnline))}h`}</td><td>{r.kmTotal==null?'—':number.format(Number(r.kmTotal))}</td><td>{number.format(Number(r.tripsTotal??0))}</td></tr>)}</tbody></table></div></section>
<section id="expenses" class="workspace-section" hidden><div class="section-title"><div><span>Vida financeira</span><h2>Despesas pessoais mensais</h2></div></div><div class="panel table-panel"><table><thead><tr><th>Despesa</th><th>Valor mensal</th></tr></thead><tbody>{personalMonthlyExpenses.map(i=><tr><td>{i[0]}</td><td>{money.format(i[1])}</td></tr>)}</tbody></table></div></section>
<section id="maintenance" class="workspace-section" hidden><div class="section-title"><div><span>Veículo</span><h2>Manutenção e cuidados</h2></div></div><div class="panel table-panel"><table><thead><tr><th>Data</th><th>Categoria</th><th>Descrição</th><th>Valor</th></tr></thead><tbody>{currentVehicleExpenses.map(i=><tr><td>{i.dateBR}</td><td>{i.category}</td><td>{i.description}</td><td>{money.format(i.value)}</td></tr>)}</tbody></table></div></section>
<section id="fuelings" class="workspace-section" hidden><div class="section-title"><div><span>Combustível</span><h2>Abastecimentos</h2></div></div><div class="panel table-panel"><table><thead><tr><th>Data</th><th>Litros</th><th>Preço/L</th><th>Total pago</th><th>Consumo</th></tr></thead><tbody>{currentFuelings.map(i=><tr><td>{i.dateBR}</td><td>{number.format(i.liters)} L</td><td>{money.format(i.pricePerLiter)}</td><td>{money.format(i.totalPaid)}</td><td>{i.consumptionKmL?`${number.format(i.consumptionKmL)} km/L`:'—'}</td></tr>)}</tbody></table></div></section>
<section id="vehicle" class="workspace-section" hidden><div class="section-title"><div><span>Frota</span><h2>{vehicleProfile.vehicle}</h2></div></div><div class="dashboard-grid dashboard-grid--balanced"><article class="panel"><span>Odômetro</span><h2>{number.format(vehicleProfile.recentOdometerKm)} km</h2><p>Último registro conhecido.</p></article><article class="panel"><span>Etanol padrão</span><h2>{money.format(vehicleProfile.referenceFuelPrice)}/L</h2><p>Referência gerencial dos diagnósticos.</p></article></div></section>
</section></div><script is:inline>const setSection=(s)=>{document.querySelectorAll('.workspace-section').forEach(n=>n.hidden=n.id!==s);document.querySelectorAll('.nav-item[data-section]').forEach(n=>n.classList.toggle('active',n.dataset.section===s));window.scrollTo({top:0,behavior:'smooth'})};document.addEventListener('click',e=>{const t=e.target.closest('[data-section]');if(t)setSection(t.dataset.section)});const c=document.getElementById('live-clock');const tick=()=>{if(c)c.textContent=new Intl.DateTimeFormat('pt-BR',{hour:'2-digit',minute:'2-digit',second:'2-digit'}).format(new Date())};tick();setInterval(tick,1000);</script>
</BaseLayout>
