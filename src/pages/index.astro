---
import BaseLayout from '../layouts/BaseLayout.astro';
import { driverProfile as profile } from '../data/driver-profile';

const portrait = 'https://meuairgo.com.br/assets/uploads/images/users/image-05-06-2026-17-50.webp';
const services = [
  ['Corridas particulares','Deslocamentos urbanos e regionais com conforto, segurança e atendimento pessoal.','https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&w=1200&q=82'],
  ['Aeroportos e rodoviárias','Traslados pontuais para aeroportos e rodoviárias com total previsibilidade.','https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1200&q=82'],
  ['Agenda e compromissos','Compromissos profissionais, consultas e reuniões com foco em pontualidade.','https://images.unsplash.com/photo-1506784983877-45594efa4cbe?auto=format&fit=crop&w=1200&q=82'],
  ['Viagens e deslocamentos','Viagens intermunicipais e longas distâncias com planejamento e conforto.','https://images.unsplash.com/photo-1500534314209-a25ddb2bd429?auto=format&fit=crop&w=1200&q=82']
];
const method = [
  ['◉','PRESENÇA','Henrico responde pessoalmente por cada serviço.'],
  ['◇','PROTEÇÃO','Cuidado com pessoas, horários, trajetos e pertences.'],
  ['▤','MÉTODO','Planejamento antes da partida e comunicação durante o percurso.'],
  ['◔','DISCRIÇÃO','Profissionalismo sem exposição, excesso ou formalidade fria.'],
  ['⌖','CONTINUIDADE','A experiência continua antes da corrida e termina depois da chegada.']
];
---
<BaseLayout title="Motorista Particular em São Paulo | MotoristaOPS">
<main class="mops-page">
  <header class="mops-header">
    <a class="mops-brand" href="#inicio" aria-label="MotoristaOPS — início">
      <span class="mops-brand-mark">M</span>
      <span class="mops-brand-name">MOTORISTA<span>OPS</span></span>
    </a>
    <nav class="mops-nav" aria-label="Navegação principal">
      <a href="#servicos">SERVIÇOS</a><a href="#como-funciona">COMO FUNCIONA</a><a href="#metodo">MÉTODO</a><a href="#quem-dirige">QUEM DIRIGE</a><a href="#contato">CONTATO</a>
    </nav>
    <a class="mops-btn mops-btn--gold mops-header-cta" href={profile.whatsapp}>FALAR NO WHATSAPP</a>
  </header>

  <section id="inicio" class="mops-hero">
    <div class="mops-hero-copy">
      <h1><span>SEU TRAJETO NÃO</span><span>COMEÇA NO CARRO.</span><span>COMEÇA NO MÉTODO.</span></h1>
      <p>Cada corrida começa com contato direto, definição clara do trajeto, confiança e responsabilidade — com acompanhamento até a chegada.</p>
      <p>Mais que dirigir, entregamos presença, método e tranquilidade.</p>
      <div class="mops-actions"><a class="mops-btn mops-btn--gold" href={profile.whatsapp}>◉ FALAR NO WHATSAPP</a><a class="mops-btn mops-btn--outline" href="#contato">▣ AGENDAR CORRIDA</a></div>
      <div class="mops-benefits">
        <article><i>◇</i><div><strong>Contato direto</strong><span>Você fala com quem vai te atender.</span></div></article>
        <article><i>◷</i><div><strong>Pontualidade</strong><span>Planejamento e execução com precisão.</span></div></article>
        <article><i>♡</i><div><strong>Cuidado em cada percurso</strong><span>Conforto, discrição e responsabilidade.</span></div></article>
      </div>
    </div>

    <div class="mops-hero-visual" aria-hidden="true">
      <div class="mops-city">
        {Array.from({length:20}).map((_,i)=><span style={`--i:${i};--h:${110 + (i%7)*27}px`}></span>)}
      </div>
      <svg class="mops-route" viewBox="0 0 620 620" preserveAspectRatio="none" aria-hidden="true">
        <defs><filter id="glow"><feGaussianBlur stdDeviation="8" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
        <path d="M78 620 C220 520, 96 465, 310 390 C470 334, 180 282, 412 210 C500 182, 418 155, 455 112" fill="none" stroke="#F0B44D" stroke-width="16" opacity=".2" filter="url(#glow)"/>
        <path d="M78 620 C220 520, 96 465, 310 390 C470 334, 180 282, 412 210 C500 182, 418 155, 455 112" fill="none" stroke="#FFF0C8" stroke-width="6" filter="url(#glow)"/>
      </svg>
      <div class="mops-pin"><span></span></div>
      <div class="mops-profile-card">
        <img src={portrait} alt="" />
        <div><h2>{profile.name}</h2><p>Motorista Particular</p><b></b><strong>Confiança que<br/>se constrói em<br/>cada detalhe.</strong></div>
      </div>
    </div>
  </section>

  <section class="mops-section mops-direct" id="contato">
    <div class="mops-kicker">TRÊS CAMINHOS.</div><h2>TODOS DIRETOS.</h2>
    <div class="mops-direct-grid">
      <a href={profile.whatsapp}><i>◉</i><div><strong>WHATSAPP</strong><span>Fale comigo de forma rápida e direta.</span></div></a>
      <a href={profile.instagram} target="_blank" rel="noreferrer"><i>◎</i><div><strong>INSTAGRAM</strong><span>Acompanhe o dia a dia e os bastidores.</span></div></a>
      <a href={profile.google} target="_blank" rel="noreferrer"><i>G</i><div><strong>GOOGLE</strong><span>Avalie e encontre minha localização.</span></div></a>
    </div>
  </section>

  <section class="mops-section" id="servicos">
    <div class="mops-kicker">SERVIÇOS</div><h2>MOBILIDADE PARA A <em>VIDA REAL.</em></h2>
    <div class="mops-services-grid">{services.map(([title,desc,img])=><article><div class="mops-service-img" style={`background-image:url('${img}')`}></div><h3>{title}</h3><p>{desc}</p></article>)}</div>
  </section>

  <section class="mops-section" id="metodo">
    <div class="mops-kicker">NOSSO MÉTODO</div><h2>UMA MARCA PESSOAL COM <em>ESTRUTURA OPERACIONAL.</em></h2>
    <div class="mops-method-grid">{method.map(([icon,title,desc])=><article><i>{icon}</i><h3>{title}</h3><p>{desc}</p></article>)}</div>
  </section>

  <section class="mops-section" id="como-funciona">
    <div class="mops-kicker">COMO FUNCIONA.</div><h2>DIRETO AO PONTO. <em>DO JEITO QUE DEVE SER.</em></h2>
    <div class="mops-steps">
      <article><b>1</b><i>◉</i><div><h3>ME CHAMA.</h3><p>Você fala comigo diretamente.</p></div></article>
      <article><b>2</b><i>⌖</i><div><h3>ME PASSA O TRAJETO.</h3><p>Origem, destino, horários e o que for importante para você.</p></div></article>
      <article><b>3</b><i>✓</i><div><h3>EU CONFIRMO.</h3><p>Confirmo os detalhes, combino o horário e estou pronto para te atender.</p></div></article>
    </div>
  </section>

  <section class="mops-section mops-presence">
    <div class="mops-kicker">MENOS PROMESSA.</div><h2>MAIS PRESENÇA.</h2>
    <div class="mops-presence-grid"><article><i>◇</i><div><h3>CONTATO DIRETO</h3><p>Você fala com quem vai te atender.</p></div></article><article><i>◷</i><div><h3>PONTUALIDADE</h3><p>Compromisso real com horários e prazos.</p></div></article><article><i>♡</i><div><h3>CUIDADO</h3><p>Condução responsável e atenção em cada detalhe.</p></div></article><article><i>▣</i><div><h3>DISCRIÇÃO</h3><p>Presença profissional com respeito e reserva.</p></div></article></div>
  </section>

  <section class="mops-about" id="quem-dirige">
    <img src={portrait} alt="Henrico Amaral, motorista particular" />
    <div><span>QUEM DIRIGE</span><h2>HENRICO AMARAL.</h2><p>Motorista particular com foco absoluto em segurança, respeito e confiança. Cada trajeto é conduzido com método, experiência e atenção aos detalhes que realmente importam.</p><div class="mops-about-tags"><b>◇ EXPERIÊNCIA<br/>COMPROVADA</b><b>◇ DISCRIÇÃO<br/>E RESPEITO</b><b>◉ ATENDIMENTO<br/>PERSONALIZADO</b><b>◇ COMPROMISSO<br/>COM VOCÊ</b></div></div>
  </section>

  <section class="mops-final-cta">
    <div><h2>ME DIGA <em>PARA ONDE.</em></h2><p>Entre em contato e tenha ao seu lado um motorista particular que entende do que importa: você.</p><a class="mops-btn mops-btn--gold" href={profile.whatsapp}>◉ FALAR NO WHATSAPP ›</a></div>
    <div class="mops-mini-route"><span></span><i></i></div>
  </section>

  <footer class="mops-footer">
    <div class="mops-footer-brand"><div class="mops-brand"><span class="mops-brand-mark">M</span><span class="mops-brand-name">MOTORISTA<span>OPS</span></span></div><small>por Henrico Amaral<br/>MOTORISTA PARTICULAR</small></div>
    <div><b>SERVIÇOS</b><a href="#servicos">Corridas particulares</a><a href="#servicos">Aeroportos e rodoviárias</a><a href="#servicos">Agenda e compromissos</a><a href="#servicos">Viagens e deslocamentos</a></div>
    <div><b>LINKS</b><a href="#como-funciona">Como funciona</a><a href="#metodo">Método</a><a href="#quem-dirige">Quem dirige</a><a href="#contato">Contato</a></div>
    <div><b>CONTATO</b><a href={profile.whatsapp}>Falar no WhatsApp</a><a href={profile.instagram}>Instagram</a></div>
  </footer>
  <div class="mops-legal"><span>© 2026 MotoristaOPS. Todos os direitos reservados.</span><span>Motorista Particular</span><span>Privacidade</span><span>Termos de uso</span></div>
</main>

<style>
:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#070709;color:#F3EFE4;font-family:"Arial Narrow","Roboto Condensed",Arial,sans-serif}.mops-page{--bg:#070709;--surface:#111114;--line:#6e5736;--gold:#C79C5B;--gold2:#F0B44D;--ivory:#F3EFE4;--muted:#aaa59b;background:radial-gradient(circle at 78% 8%,rgba(199,156,91,.06),transparent 28%),var(--bg);color:var(--ivory);min-height:100vh;overflow:hidden}.mops-header{height:88px;border-bottom:1px solid #5a462c;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:36px;padding:0 4.2vw;background:rgba(5,6,8,.96);position:relative;z-index:20}.mops-brand{display:flex;align-items:center;gap:12px;color:var(--ivory);text-decoration:none}.mops-brand-mark{width:38px;height:42px;display:grid;place-items:center;border:2px solid var(--gold2);border-radius:48% 48% 58% 58%;color:var(--gold2);font-weight:900;font-size:18px;box-shadow:inset 0 0 0 3px #070709}.mops-brand-name{font-size:22px;font-weight:900;letter-spacing:.06em}.mops-brand-name span{color:var(--gold2)}.mops-nav{display:flex;justify-content:center;gap:44px}.mops-nav a{color:#e7e1d7;text-decoration:none;font-weight:800;font-size:12px;letter-spacing:.05em}.mops-btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 24px;text-decoration:none;border:1px solid var(--gold);font-weight:900;font-size:13px;letter-spacing:.05em;box-sizing:border-box}.mops-btn--gold{background:linear-gradient(#d7ab66,#c79751);color:#18120b;border-color:#dbaf6c}.mops-btn--outline{color:var(--ivory);background:#0a0b0d}.mops-header-cta{min-height:48px}.mops-hero{min-height:810px;display:grid;grid-template-columns:43% 57%;border-bottom:1px solid #44331f;background:linear-gradient(90deg,#050608 0%,#050608 37%,rgba(5,6,8,.3) 64%,#050608 100%)}.mops-hero-copy{padding:82px 26px 42px 4.2vw;position:relative;z-index:4}.mops-hero h1{margin:0 0 24px;max-width:700px;font-size:clamp(52px,5.1vw,86px);line-height:.97;letter-spacing:-.025em;font-weight:900;text-transform:uppercase}.mops-hero h1 span{display:block}.mops-hero h1 span:last-child{color:var(--gold)}.mops-hero-copy>p{max-width:650px;margin:0 0 10px;color:#ded9cf;font-size:18px;line-height:1.55}.mops-actions{display:flex;gap:20px;margin-top:28px}.mops-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px;max-width:760px}.mops-benefits article{display:grid;grid-template-columns:58px 1fr;gap:12px;min-height:90px;padding-right:18px;border-right:1px solid #493923}.mops-benefits article:last-child{border-right:0}.mops-benefits i,.mops-direct i,.mops-method-grid i,.mops-steps i,.mops-presence-grid i{color:var(--gold2);font-style:normal;font-size:42px;line-height:1}.mops-benefits strong{display:block;font-size:16px}.mops-benefits span{display:block;margin-top:8px;color:#c2bbb0;font-size:13px;line-height:1.45}.mops-hero-visual{position:relative;overflow:hidden;min-width:0;background:radial-gradient(ellipse at 58% 36%,rgba(240,180,77,.08),transparent 23%),linear-gradient(#06080a,#08090b)}.mops-hero-visual:after{content:"";position:absolute;inset:38% 0 0;background:repeating-linear-gradient(8deg,transparent 0 34px,rgba(240,180,77,.08) 35px 36px),repeating-linear-gradient(98deg,transparent 0 55px,rgba(240,180,77,.07) 56px 57px);transform:perspective(500px) rotateX(62deg) scale(1.8);transform-origin:center top}.mops-city{position:absolute;inset:40px 0 auto 0;height:360px;display:flex;align-items:flex-end;justify-content:space-around;gap:8px;padding:0 26px;opacity:.95}.mops-city span{height:var(--h);width:34px;background:repeating-linear-gradient(90deg,transparent 0 8px,#f0a728 9px 11px,transparent 12px 18px),repeating-linear-gradient(0deg,#111317 0 11px,#252018 12px 14px);clip-path:polygon(0 9%,22% 9%,22% 0,78% 0,78% 12%,100% 12%,100% 100%,0 100%);filter:brightness(calc(.7 + var(--i)*.012))}.mops-route{position:absolute;left:4%;top:18%;width:70%;height:76%;z-index:2}.mops-pin{position:absolute;left:52%;top:27%;width:42px;height:54px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--gold2);box-shadow:0 0 30px rgba(240,180,77,.85);z-index:4}.mops-pin span{position:absolute;inset:13px;border-radius:50%;background:#292015}.mops-profile-card{position:absolute;right:5.5%;bottom:10%;width:min(500px,60%);height:230px;display:grid;grid-template-columns:45% 55%;border:1px solid #8d6633;background:rgba(10,11,13,.94);z-index:5}.mops-profile-card img{width:100%;height:100%;object-fit:cover;object-position:center top;filter:saturate(.86) contrast(1.08)}.mops-profile-card>div{padding:36px 28px}.mops-profile-card h2{margin:0;color:var(--gold);font-size:25px}.mops-profile-card p{margin:8px 0 18px;color:#f0ebe3;font-size:16px}.mops-profile-card b{display:block;width:36px;height:2px;background:var(--gold2);margin-bottom:25px}.mops-profile-card strong{font-size:18px;line-height:1.5;font-weight:500}.mops-section{padding:32px 8vw 34px;border-bottom:1px solid #33291d;text-align:center;background:linear-gradient(90deg,#090a0c,#0d0e10 50%,#090a0c)}.mops-kicker{color:var(--gold2);font-size:11px;letter-spacing:.24em;font-weight:900}.mops-section h2{margin:7px 0 20px;font-size:31px;letter-spacing:.05em}.mops-section h2 em{font-style:normal;color:var(--gold2)}.mops-direct-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1080px;margin:auto}.mops-direct-grid a{min-height:96px;border:1px solid #6a4c29;color:inherit;text-decoration:none;display:flex;align-items:center;gap:22px;padding:0 28px;text-align:left;background:#111214}.mops-direct-grid i{font-size:44px}.mops-direct-grid strong{display:block;font-size:18px}.mops-direct-grid span{display:block;margin-top:6px;color:#c1baaf;font-size:13px}.mops-services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;max-width:1180px;margin:auto}.mops-services-grid article{border:1px solid #6b4e2b;background:#111214;text-align:left;overflow:hidden}.mops-service-img{height:142px;background-size:cover;background-position:center;filter:saturate(.8) contrast(1.05)}.mops-services-grid h3{margin:14px 14px 6px;text-transform:uppercase;font-size:15px}.mops-services-grid p{margin:0 14px 16px;color:#c8c0b4;font-size:12px;line-height:1.5}.mops-method-grid{display:grid;grid-template-columns:repeat(5,1fr);max-width:1180px;margin:auto}.mops-method-grid article{padding:0 24px;border-right:1px solid #6a4c29}.mops-method-grid article:last-child{border-right:0}.mops-method-grid i{display:block;font-size:48px}.mops-method-grid h3{margin:8px 0 8px;font-size:16px}.mops-method-grid p{margin:0;color:#c6bfb4;font-size:12px;line-height:1.45}.mops-steps{display:grid;grid-template-columns:repeat(3,1fr);max-width:1080px;margin:28px auto 0;border-top:1px solid #826034}.mops-steps article{position:relative;display:grid;grid-template-columns:68px 1fr;gap:16px;text-align:left;padding:22px 24px}.mops-steps b{position:absolute;top:-15px;left:20px;width:27px;height:27px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--gold2);background:#0a0b0d;color:var(--gold2)}.mops-steps h3{margin:0;font-size:15px}.mops-steps p{margin:6px 0 0;color:#c6bfb4;font-size:12px;line-height:1.45}.mops-presence-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;max-width:1180px;margin:auto}.mops-presence-grid article{display:grid;grid-template-columns:54px 1fr;align-items:center;text-align:left;border:1px solid #674a29;min-height:88px;padding:0 18px}.mops-presence-grid i{font-size:40px}.mops-presence-grid h3{margin:0 0 5px;font-size:13px}.mops-presence-grid p{margin:0;color:#c4bdb2;font-size:11px;line-height:1.35}.mops-about{display:grid;grid-template-columns:260px 1fr;max-width:1180px;margin:18px auto;border:1px solid #73532d;background:#101113}.mops-about>img{width:100%;height:100%;min-height:250px;object-fit:cover;object-position:center 10%;filter:saturate(.86) contrast(1.05)}.mops-about>div{padding:28px 38px;text-align:left}.mops-about>div>span{color:var(--gold2);font-size:11px;letter-spacing:.15em}.mops-about h2{margin:6px 0 10px;font-size:32px}.mops-about p{max-width:760px;color:#d6cfc5;font-size:13px;line-height:1.55}.mops-about-tags{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:22px}.mops-about-tags b{padding-right:14px;border-right:1px solid #503c26;color:#d8d0c5;font-size:10px;line-height:1.4}.mops-about-tags b:last-child{border-right:0}.mops-final-cta{min-height:190px;margin:0;border-top:1px solid #7d5c32;border-bottom:1px solid #7d5c32;display:grid;grid-template-columns:42% 58%;align-items:center;padding:0 8vw;background:radial-gradient(circle at 73% 48%,rgba(240,180,77,.14),transparent 18%),#090a0c;overflow:hidden}.mops-final-cta h2{margin:0;font-size:42px}.mops-final-cta h2 em{color:var(--gold2);font-style:normal}.mops-final-cta p{max-width:450px;color:#d2cbc0;font-size:13px;line-height:1.45}.mops-mini-route{height:100%;position:relative;background:repeating-linear-gradient(12deg,transparent 0 35px,rgba(240,180,77,.08) 36px 37px),repeating-linear-gradient(102deg,transparent 0 58px,rgba(240,180,77,.06) 59px 60px)}.mops-mini-route:before{content:"";position:absolute;left:5%;bottom:22%;width:72%;height:5px;background:linear-gradient(90deg,transparent,#fff0c8 20%,#f0b44d 55%,transparent);transform:rotate(-6deg);box-shadow:0 0 18px #f0b44d}.mops-mini-route i{position:absolute;right:18%;top:26%;width:34px;height:45px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:var(--gold2);box-shadow:0 0 25px rgba(240,180,77,.7)}.mops-footer{display:grid;grid-template-columns:1.35fr 1fr .8fr .9fr;gap:44px;max-width:1180px;margin:auto;padding:28px 24px 24px}.mops-footer>div{display:flex;flex-direction:column;gap:6px}.mops-footer b{color:var(--gold2);font-size:10px}.mops-footer a{color:#d9d2c7;text-decoration:none;font-size:11px}.mops-footer-brand small{margin-top:8px;color:var(--gold);font-size:10px;line-height:1.45}.mops-legal{border-top:1px solid #2f291f;display:grid;grid-template-columns:1.6fr .7fr .5fr .6fr;gap:20px;padding:12px 6vw;co