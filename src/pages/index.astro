icle{padding:16px;border-right:1px solid #292c2f}.finance-grid strong,.vehicle-grid strong,.health-grid strong{display:block;font-size:17px;margin-top:7px}.closing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.closing-grid article{padding:14px;border:1px solid #292c2f;border-radius:10px}.closing-grid article>div{display:flex;justify-content:space-between;color:#767a7e;font-size:8px}.closing-grid article>b{display:block;font-size:18px;margin:10px 0 3px}.closing-grid article small,.closing-grid article em{display:block;color:#73777b;font-size:8px}.closing-grid article em{color:#8faa93;font-style:normal;margin-top:5px}.review-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.review-grid article{padding:18px;display:grid;grid-template-columns:52px 1fr;gap:14px}.review-date strong{display:block;font-size:28px;color:#c7a66a}.review-date span{font-size:8px;color:#71757a}.tag{font-size:7px;text-transform:uppercase;color:#a89268}.review-grid h3{font-size:11px;margin:7px 0}.review-grid p{color:#81858a;font-size:9px;line-height:1.6}.review-grid small{color:#666b70}.context-row{display:grid;grid-template-columns:1fr 1fr auto;gap:10px;margin-top:12px}.context-row>div,.context-row>a{padding:14px;border:1px solid #292c2f;border-radius:10px;text-decoration:none}.context-row span,.context-row small{display:block;color:#777b80;font-size:8px}.context-row strong{display:block;margin-top:5px;font-size:12px}.context-row a{font-size:9px;color:#c7a66a;display:grid;place-items:center}.private-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:12px}.policy{padding:20px}.policy>span{color:#9d875d;font-size:8px;text-transform:uppercase}.policy>strong{display:block;font-size:40px;margin:10px 0 18px}.policy>strong small{font-size:11px;color:#777}.policy p{display:flex;justify-content:space-between;font-size:9px;border-top:1px solid #292c2f;padding-top:10px}.pipeline{display:grid;gap:8px}.pipeline article{padding:15px;display:grid;grid-template-columns:1fr auto;gap:5px}.pipeline article>div{display:flex;gap:10px}.pipeline article>div span{color:#aaa}.pipeline article b{grid-row:1/3;grid-column:2}.pipeline article p,.pipeline article small{margin:0;color:#777b80;font-size:8px}.vehicle-grid,.health-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.vehicle-grid article,.health-grid article{padding:16px;border:1px solid #292c2f;border-radius:11px}.health-grid .ok{border-top-color:#638469}.health-grid .warn{border-top-color:#927a50}.data-health{padding-bottom:34px}footer{padding:30px 0 0;display:flex;align-items:center;gap:14px;color:#6f7377;font-size:8px}footer strong{color:#a68f65}footer small{margin-left:auto}@media(max-width:1100px){.app-shell{grid-template-columns:1fr}.rail{position:static;height:auto;border-right:0;border-bottom:1px solid #292c2f}.rail nav,.deep-links{display:flex;flex-wrap:wrap;margin-top:18px}.rail-foot{display:none}main{padding:0 24px 40px}.hero{grid-template-columns:1fr}.decision-strip{grid-template-columns:repeat(3,1fr)}.four-grid,.finance-grid{grid-template-columns:repeat(3,1fr)}.live-grid{grid-template-columns:1fr 1fr}.live-intel{grid-column:1/-1}}@media(max-width:700px){main{padding:0 15px 32px}.hero{padding-top:36px}.decision-strip{grid-template-columns:1fr 1fr}.prediction-grid,.private-grid,.review-grid,.live-grid{grid-template-columns:1fr}.four-grid,.finance-grid,.vehicle-grid,.health-grid,.closing-grid{grid-template-columns:1fr 1fr}.live-intel{grid-column:auto}.live-regions{grid-template-columns:1fr 1fr}.context-row{grid-template-columns:1fr}.section-head{display:grid;align-items:start}footer{display:grid}footer small{margin-left:0}}@media(max-width:430px){.decision-strip,.four-grid,.finance-grid,.vehicle-grid,.health-grid,.closing-grid{grid-template-columns:1fr}.decision-strip article{border-right:0;border-bottom:1px solid #292c2f;padding-left:0}.hero h1{font-size:38px}}
</style>
