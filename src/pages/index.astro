---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentClosings, currentVehicleExpenses, currentFuelings, personalMonthlyExpenses, vehicleProfile } from '../data/current-ops';
import { evidenceDays, privatePipeline, privatePricingPolicy, dataHealth } from '../data/dashboard-refresh';
import { predictiveSummary, weekdayScores, hourScores, regionScores, routeScores, recommendedWindows } from '../data/predictive-engine-v3';
import { predictiveIntelligence, dailyContextReviews } from '../data/strategic-intelligence-v2';
import { contextReadiness, signalImpactMatrix } from '../data/context-feature-engine-v2';

const brl=new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const num=new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1});
const completeAugust=currentClosings.filter(x=>x.date.startsWith('2026-08'));
const sum=(rows:readonly any[],key:string)=>rows.reduce((s,x)=>s+(Number(x[key])||0),0);
const revenue=sum(completeAugust,'grossRevenue');
const profit=sum(completeAugust,'operationalProfit');
const hours=sum(completeAugust,'hoursOnline');
const km=sum(completeAugust,'kmTotal');
const trips=sum(completeAugust,'tripsTotal');
const evidenceRevenue=evidenceDays.filter(x=>x.status==='evidence-only').reduce((s,x)=>s+(x.platformRevenue??0),0);
const latestEvidence=evidenceDays.at(-1)!;
const personalTotal=personalMonthlyExpenses.reduce((s,x)=>s+Number(x[1]),0);
const maintenanceTotal=currentVehicleExpenses.reduce((s,x)=>s+x.value,0);
const fuelTotal=currentFuelings.filter(x=>x.date.startsWith('2026-08')).reduce((s,x)=>s+x.totalPaid,0);
const pipelineTotal=privatePipeline.reduce((s,x)=>s+x.quotedValue,0);
const contextReady=contextReadiness.filter(x=>x.coverage>0).slice(0,5);
const usableSignals=signalImpactMatrix.filter(x=>x.usableForRecommendation);
---
<BaseLayout title="MotoristaOPS · Cockpit operacional">
<div class="app-shell">
  <aside class="rail">
    <a class="brand" href="#top"><span>MO</span><div><strong>MOTORISTA OPS</strong><small>cockpit operacional</small></div></a>
    <nav><a href="#top">Agora</a><a href="#previsao">Previsão</a><a href="#transito">Trânsito</a><a href="#financeiro">Financeiro</a><a href="#review">Review diário</a><a href="#particular">Particular</a><a href="#veiculo">Veículo</a><a href="#dados">Dados</a></nav>
    <div class="deep-links"><a href="./transito">Trânsito ao vivo ↗</a><a href="./previsao">Previsão ↗</a><a href="./inteligencia">Inteligência ↗</a><a href="./contexto">Contexto ↗</a><a href="./fontes-contexto">Fontes ↗</a></div>
    <div class="rail-foot"><i></i><span>Supabase ativo</span></div>
  </aside>

  <main id="top">
    <section class="hero">
      <div class="hero-copy"><p class="eyebrow">18 AGO 2026 · cockpit de decisão</p><h1>Onde trabalhar, quando sair e se o dia está <em>valendo a pena.</em></h1><p>O MotoristaOPS reúne caixa, operação, histórico, trânsito, contexto e previsão num mesmo cockpit. Dado confirmado vira decisão; lacuna continua visível.</p><div class="actions"><a class="btn primary" href="./transito">Ver trânsito agora</a><a class="btn" href="./previsao">Abrir previsão</a><a class="btn" href="./importar-uber">Importar corridas</a></div></div>
      <article class="now-card"><div class="card-top"><span>Última operação observada</span><b>17/08</b></div><strong>{brl.format(latestEvidence.platformRevenue??0)}</strong><p>{latestEvidence.completedTrips} corridas concluídas · {num.format(latestEvidence.observedRideKm??0)} km em corrida · {num.format(latestEvidence.observedRideHours??0)} h em viagem</p><div class="status-line"><i></i><span>aguarda fechamento completo</span></div></article>
    </section>

    <section class="decision-strip"><article><span>Receita consolidada</span><strong>{brl.format(revenue)}</strong><small>agosto · fechamentos completos</small></article><article><span>Lucro operacional</span><strong>{brl.format(profit)}</strong><small>{hours?brl.format(profit/hours):'—'}/h</small></article><article><span>Receita pendente</span><strong>+ {brl.format(evidenceRevenue)}</strong><small>evidência ainda não fechada</small></article><article><span>Melhor janela</span><strong>{predictiveSummary.bestWindow?.weekday??'—'} · {predictiveSummary.bestWindow?.hourBand??'—'}</strong><small>score {predictiveSummary.bestWindow?.score??0}/100</small></article><article><span>Melhor região</span><strong>{predictiveSummary.bestRegion?.key??'—'}</strong><small>confiança {predictiveSummary.bestRegion?.confidence??'baixa'}</small></article></section>

    <section id="previsao" class="section-block"><div class="section-head"><div><p class="eyebrow">01 · previsão operacional</p><h2>Onde a próxima hora tende a render melhor?</h2></div><a href="./previsao">ver análise completa →</a></div><div class="prediction-grid"><article class="best-window"><span>Melhor combinação histórica atual</span><strong>{predictiveSummary.bestWindow?.weekday??'—'}</strong><b>{predictiveSummary.bestWindow?.hourBand??'—'}</b><p>{predictiveSummary.bestWindow?.rationale}</p><div class="score"><i style={`width:${predictiveSummary.bestWindow?.score??0}%`}></i></div><small>score {predictiveSummary.bestWindow?.score??0}/100 · confiança {predictiveSummary.bestWindow?.confidence??'baixa'}</small></article><div class="rank-panel"><h3>Próximas janelas priorizadas</h3>{recommendedWindows.slice(0,5).map((x,i)=><div class="rank-row"><b>0{i+1}</b><span><strong>{x.weekday} · {x.hourBand}</strong><small>{x.confidence}</small></span><em>{x.score}</em></div>)}</div></div><div class="four-grid compact-cards"><article><span>Melhores dias</span>{weekdayScores.slice(0,3).map(x=><p><b>{x.label}</b><em>{brl.format(x.profitPerHour)}/h</em></p>)}</article><article><span>Melhores horários</span>{hourScores.slice(0,3).map(x=><p><b>{x.key}</b><em>{brl.format(x.revenuePerRideHour)}/h</em></p>)}</article><article><span>Melhores regiões</span>{regionScores.slice(0,3).map(x=><p><b>{x.key}</b><em>{x.score}/100</em></p>)}</article><article><span>Rotas recorrentes</span>{routeScores.slice(0,3).map(x=><p><b>{x.key}</b><em>{x.score}/100</em></p>)}</article></div></section>

    <section id="transito" class="section-block live-section"><div class="section-head"><div><p class="eyebrow">02 · cidade agora</p><h2>Trânsito quase em tempo real.</h2></div><a href="./transito">abrir painel operacional →</a></div><div class="live-grid"><article class="live-primary"><div class="live-title"><span id="live-status">carregando CET…</span><small id="live-age">—</small></div><strong id="live-total">—</strong><p>lentidão total observada</p><div class="live-regions" id="live-regions"><span>aguardando snapshot</span></div></article><article class="live-pressure"><span>Região mais pressionada</span><strong id="live-region">—</strong><small id="live-region-value">—</small><p>Esse dado ainda não altera a previsão automaticamente. Primeiro acumulamos histórico de trânsito × desempenho.</p></article><article class="live-intel"><span>Como usar agora</span><ul><li>Compare a região historicamente eficiente com a pressão atual.</li><li>Evite tratar lentidão alta como perda automática: dinâmica pode compensar.</li><li>Use contexto + previsão antes de mudar de zona.</li></ul></article></div></section>

    <section id="financeiro" class="section-block"><div class="section-head"><div><p class="eyebrow">03 · resultado</p><h2>O que virou dinheiro de verdade.</h2></div><span>{trips} corridas · {num.format(hours)} h · {num.format(km)} km</span></div><div class="finance-grid"><article><span>Receita / h</span><strong>{hours?brl.format(revenue/hours):'—'}</strong></article><article><span>Lucro / h</span><strong>{hours?brl.format(profit/hours):'—'}</strong></article><article><span>Receita / km</span><strong>{km?brl.format(revenue/km):'—'}</strong></article><article><span>Combustível pago</span><strong>{brl.format(fuelTotal)}</strong></article><article><span>Manutenção</span><strong>{brl.format(maintenanceTotal)}</strong></article><article><span>Obrigações pessoais</span><strong>{brl.format(personalTotal)}</strong></article></div><div class="closing-grid">{completeAugust.map(x=><article><div><strong>{x.dateBR}</strong><span>{x.day}</span></div><b>{brl.format(x.grossRevenue)}</b><small>{num.format(x.hoursOnline)} h · {num.format(x.kmTotal)} km · {x.tripsTotal} corridas</small><em>{brl.format(x.operationalProfit)} lucro</em></article>)}</div></section>

    <section id="review" class="section-block"><div class="section-head"><div><p class="eyebrow">04 · review diário</p><h2>Resultado + tempo + região + contexto.</h2></div><a href="./inteligencia">ver inteligência completa →</a></div><div class="review-grid">{dailyContextReviews.slice(-4).map(x=><article><div class="review-date"><strong>{x.date.slice(8,10)}</strong><span>{x.date.slice(5,7)}/26</span></div><div><span class="tag">{x.status}</span><h3>{x.operational}</h3><p>{x.review}</p><small>{x.trafficStatus}</small></div></article>)}</div><div class="context-row"><div><span>Contexto já mapeado</span><strong>{contextReady.length} tipos com cobertura</strong></div><div><span>Sinais aptos a alterar recomendação</span><strong>{usableSignals.length}</strong><small>trava mínima: 3 janelas afetadas + 3 baseline</small></div><a href="./contexto">Auditar contexto →</a></div></section>

    <section id="particular" class="section-block"><div class="section-head"><div><p class="eyebrow">05 · particular</p><h2>Receita fora dos apps, com regra própria.</h2></div><span>{brl.format(pipelineTotal)} em orçamentos futuros</span></div><div class="private-grid"><article class="policy"><span>Política {privatePricingPolicy.version}</span><strong>{brl.format(privatePricingPolicy.basePerKm)}<small>/km</small></strong><div><p>Mínimo agendado <b>{brl.format(privatePricingPolicy.scheduledMinimum)}</b></p><p>Reserva <b>{brl.format(privatePricingPolicy.reservationFee)}</b></p><p>Espera <b>{privatePricingPolicy.waitingToleranceMin} min + {brl.format(privatePricingPolicy.waitingPerMin)}/min</b></p><p>Horário especial <b>+{privatePricingPolicy.specialHoursSurchargePct}%</b></p></div></article><div class="pipeline">{privatePipeline.map(x=><article><div><strong>{x.serviceDate.slice(8,10)}/09</strong><span>{x.label}</span></div><b>{brl.format(x.quotedValue)}</b><p>{x.appointment} compromisso · retirada {x.provisionalPickup}</p><small>revisar trânsito: {x.trafficReviewAround}</small></article>)}</div></div></section>

    <section id="veiculo" class="section-block"><div class="section-head"><div><p class="eyebrow">06 · veículo</p><h2>{vehicleProfile.vehicle}</h2></div><span>{vehicleProfile.fuel}</span></div><div class="vehicle-grid"><article><span>Odômetro recente</span><strong>{num.format(vehicleProfile.recentOdometerKm)} km</strong></article><article><span>Abastecimentos registrados</span><strong>{currentFuelings.length}</strong></article><article><span>Manutenções registradas</span><strong>{currentVehicleExpenses.length}</strong></article><article><span>Combustível em agosto</span><strong>{brl.format(fuelTotal)}</strong></article></div></section>

    <section id="dados" class="section-block data-health"><div class="section-head"><div><p class="eyebrow">07 · confiança</p><h2>Saúde dos dados e próximas lacunas.</h2></div><a href="./fontes-contexto">fontes externas →</a></div><div class="health-grid"><article class="ok"><span>Supabase</span><strong>{dataHealth.supabaseStatus}</strong><small>fechamentos completos até {dataHealth.supabaseCompleteThrough.split('-').reverse().join('/')}</small></article><article class="warn"><span>Evidência mais recente</span><strong>{dataHealth.latestEvidenceDate.split('-').reverse().join('/')}</strong><small>ainda há dias pendentes de fechamento</small></article><article class="warn"><span>Lacunas</span><strong>{dataHealth.missingClosingDates.length}</strong><small>{dataHealth.missingClosingDates.map(x=>x.slice(8,10)+'/08').join(' · ')}</small></article><article><span>Modelo preditivo</span><strong>{predictiveSummary.model}</strong><small>{predictiveIntelligence.sample.detailedRides} corridas detalhadas no motor</small></article></div></section>

    <footer><strong>MOTORISTA OPS</strong><span>controle financeiro + inteligência operacional + contexto + previsão</span><small>Observado, inferido e desconhecido continuam separados.</small></footer>
  </main>
</div>
<script>import '../scripts/dashboard-live.ts';</script>
</BaseLayout>

<style>
:global(html){scroll-behavior:smooth;background:#0a0b0c}:global(body){margin:0;background:#0a0b0c;color:#f1eee8;font-family:Inter,system-ui,sans-serif}:global(*){box-sizing:border-box}:global(a){color:inherit}.app-shell{display:grid;grid-template-columns:230px minmax(0,1fr);min-height:100vh}.rail{position:sticky;top:0;height:100vh;padding:28px 18px;border-right:1px solid #292c2f;background:#0b0c0d;display:flex;flex-direction:column}.brand{display:flex;gap:11px;align-items:center;text-decoration:none}.brand>span{width:38px;height:38px;border:1px solid #c7a66a;border-radius:50%;display:grid;place-items:center;color:#c7a66a;font-size:11px;font-weight:800}.brand strong{font-size:11px;letter-spacing:.12em}.brand small{display:block;color:#71757a;font-size:8px;text-transform:uppercase;margin-top:3px}.rail nav{display:grid;gap:4px;margin-top:40px}.rail nav a,.deep-links a{padding:9px 10px;text-decoration:none;color:#8b8f93;font-size:11px;border-radius:7px}.rail nav a:hover,.deep-links a:hover{background:#17191b;color:#f1eee8}.deep-links{display:grid;margin-top:24px;padding-top:18px;border-top:1px solid #24272a}.deep-links a{color:#b7a17a}.rail-foot{margin-top:auto;display:flex;gap:8px;align-items:center;color:#7d8185;font-size:9px}.rail-foot i{width:7px;height:7px;border-radius:50%;background:#7da987}main{min-width:0;max-width:1540px;width:100%;margin:auto;padding:0 44px 52px}.hero{padding:58px 0 34px;border-bottom:1px solid #292c2f;display:grid;grid-template-columns:1.35fr .65fr;gap:46px;align-items:end}.eyebrow{color:#9d875d;font-size:9px;text-transform:uppercase;letter-spacing:.13em}.hero h1{font-size:clamp(38px,5vw,68px);line-height:.95;letter-spacing:-.055em;margin:14px 0 20px;max-width:900px}.hero h1 em{font-style:normal;color:#c7a66a}.hero-copy>p:not(.eyebrow){max-width:760px;color:#91959a;line-height:1.7;font-size:14px}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:24px}.btn{padding:10px 13px;border:1px solid #34373a;border-radius:8px;text-decoration:none;