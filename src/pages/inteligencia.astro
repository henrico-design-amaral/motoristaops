---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dailyContextReviews, predictiveIntelligence } from '../data/strategic-intelligence-v2';
const brl = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
const n = new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1});
---
<BaseLayout title="MotoristaOPS · Inteligência operacional">
  <main class="intel-shell">
    <header class="intel-hero">
      <div><p class="eyebrow">MotoristaOPS · inteligência v1</p><h1>Transformar fechamento em decisão.</h1><p>O painel passa a cruzar desempenho por dia, horário, região e rota com uma camada de contexto viário. A leitura preditiva é exploratória e mostra a qualidade da amostra para evitar falsa precisão.</p></div>
      <a class="back" href="/">← Dashboard</a>
    </header>

    <section class="summary-grid">
      <article><span>Melhor dia · lucro/h</span><strong>{predictiveIntelligence.bestWeekday?.label ?? '—'}</strong><small>{predictiveIntelligence.bestWeekday ? `${brl.format(predictiveIntelligence.bestWeekday.profitPerHour)}/h` : 'amostra insuficiente'}</small></article>
      <article><span>Melhor faixa detalhada</span><strong>{predictiveIntelligence.bestHourBand?.key ?? '—'}</strong><small>{predictiveIntelligence.bestHourBand ? `${brl.format(predictiveIntelligence.bestHourBand.revenuePerRideHour)}/h em corrida` : 'amostra insuficiente'}</small></article>
      <article><span>Melhor origem detalhada</span><strong>{predictiveIntelligence.bestOriginRegion?.key ?? '—'}</strong><small>{predictiveIntelligence.bestOriginRegion ? `${brl.format(predictiveIntelligence.bestOriginRegion.revenuePerRideHour)}/h em corrida` : 'amostra insuficiente'}</small></article>
      <article><span>Amostra atual</span><strong>{predictiveIntelligence.sample.completeDays} dias</strong><small>{predictiveIntelligence.sample.detailedRides} corridas detalhadas</small></article>
    </section>

    <section class="section">
      <div class="section-head"><div><p class="eyebrow">01 · fechamento contextual</p><h2>Review do dia</h2></div><p>Financeiro + tempo + regiões + trânsito + eventos + notícias.</p></div>
      <div class="review-list">
        {dailyContextReviews.map(item => <article class="review-card">
          <div class="review-date"><strong>{item.date.slice(8,10)}</strong><span>{item.date.slice(5,7)}/26 · {item.day}</span></div>
          <div class="review-main"><div class="review-top"><span class={`pill ${item.status}`}>{item.status}</span><span class="traffic">Trânsito: {item.trafficStatus}</span></div><h3>{item.operational}</h3><p>{item.review}</p><dl><div><dt>Regiões</dt><dd>{item.regions}</dd></div><div><dt>Contexto externo</dt><dd>{item.externalContext}</dd></div><div><dt>Fontes</dt><dd>{item.sources.join(' · ')}</dd></div></dl></div>
        </article>)}
      </div>
    </section>

    <section class="section ranking-grid">
      <article class="panel"><div class="section-head compact"><div><p class="eyebrow">02</p><h2>Dias da semana</h2></div></div>{predictiveIntelligence.weekdayRanking.map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.label}</strong><small>{x.days} dia(s) na amostra</small></span><em>{brl.format(x.profitPerHour)}/h lucro</em></div>)}</article>
      <article class="panel"><div class="section-head compact"><div><p class="eyebrow">03</p><h2>Faixas horárias</h2></div></div>{predictiveIntelligence.hourRanking.slice(0,6).map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas detalhadas</small></span><em>{brl.format(x.revenuePerRideHour)}/h</em></div>)}</article>
    </section>

    <section class="section ranking-grid">
      <article class="panel"><div class="section-head compact"><div><p class="eyebrow">04</p><h2>Regiões de origem</h2></div></div>{predictiveIntelligence.regionRanking.slice(0,8).map((x,i)=><div class="rank"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas · {n.format(x.km)} km</small></span><em>{brl.format(x.revenuePerRideHour)}/h</em></div>)}</article>
      <article class="panel"><div class="section-head compact"><div><p class="eyebrow">05</p><h2>Rotas recorrentes</h2></div></div>{predictiveIntelligence.routeRanking.slice(0,8).map((x,i)=><div class="rank route"><b>{i+1}</b><span><strong>{x.key}</strong><small>{x.rides} corridas · ticket {brl.format(x.avgTicket)}</small></span><em>{brl.format(x.revenuePerRideHour)}/h</em></div>)}</article>
    </section>

    <section class="section model-box"><div><p class="eyebrow">06 · análise preditiva</p><h2>O que o motor vai aprender a prever</h2><p>A versão atual é um ranking histórico ponderado pela eficiência. A próxima etapa adiciona variáveis externas e calcula probabilidade de uma janela ser boa antes de você sair para trabalhar.</p></div><div class="next-list">{predictiveIntelligence.nextModel.map(x=><div>→ {x}</div>)}</div></section>

    <section class="warning-box"><strong>Qualidade da previsão: exploratória</strong>{predictiveIntelligence.warnings.map(x=><p>• {x}</p>)}</section>
  </main>
  <style>
    .intel-shell{max-width:1500px;margin:auto;padding:42px 34px 80px}.intel-hero{display:flex;justify-content:space-between;gap:40px;align-items:flex-start;padding:40px 0 46px;border-bottom:1px solid var(--mo-line)}.intel-hero h1{font-size:clamp(3rem,7vw,7rem);line-height:.9;max-width:9ch;letter-spacing:-.07em}.intel-hero p:not(.eyebrow){max-width:70ch;line-height:1.7;color:var(--mo-muted)}.eyebrow{font-size:.62rem;text-transform:uppercase;letter-spacing:.14em;color:var(--mo-gold-soft);font-weight:800}.back{color:var(--mo-paper);text-decoration:none;border:1px solid var(--mo-line);padding:12px 16px;border-radius:999px}.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--mo-line);border:1px solid var(--mo-line);border-radius:18px;overflow:hidden;margin:30px 0}.summary-grid article{background:var(--mo-bg);padding:22px}.summary-grid span,.summary-grid small{display:block;color:var(--mo-muted);font-size:.68rem}.summary-grid strong{display:block;font-size:1.65rem;margin:9px 0}.section{margin-top:58px}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:22px}.section-head h2{font-size:clamp(2rem,4vw,4rem);letter-spacing:-.05em}.section-head>p{max-width:45ch;color:var(--mo-muted)}.review-list{display:grid;gap:12px}.review-card{display:grid;grid-template-columns:110px 1fr;border:1px solid var(--mo-line);border-radius:16px;overflow:hidden;background:rgba(25,22,20,.75)}.review-date{padding:24px;border-right:1px solid var(--mo-line)}.review-date strong{display:block;font-size:2.7rem;color:var(--mo-gold-soft)}.review-date span{font-size:.65rem;color:var(--mo-muted)}.review-main{padding:24px}.review-top{display:flex;gap:10px;flex-wrap:wrap}.pill,.traffic{font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;border:1px solid var(--mo-line);padding:5px 8px;border-radius:999px}.review-main h3{font-size:1.25rem;margin:15px 0 8px}.review-main p{color:var(--mo-paper-soft);line-height:1.65}.review-main dl{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--mo-line);margin-top:18px}.review-main dl div{background:var(--mo-bg-deep);padding:13px}.review-main dt{font-size:.58rem;text-transform:uppercase;letter-spacing:.08em;color:var(--mo-muted)}.review-main dd{margin:5px 0 0;font-size:.72rem;line-height:1.45}.ranking-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{border:1px solid var(--mo-line);border-radius:16px;padding:22px}.section-head.compact{margin-bottom:10px}.section-head.compact h2{font-size:2rem}.rank{display:grid;grid-template-columns:32px 1fr auto;gap:12px;align-items:center;padding:13px 0;border-top:1px solid var(--mo-line)}.rank>b{color:var(--mo-gold-soft)}.rank span{display:grid}.rank small{color:var(--mo-muted);font-size:.65rem}.rank em{font-style:normal;font-weight:700}.model-box{display:grid;grid-template-columns:1fr 1fr;gap:40px;padding:30px;border:1px solid var(--mo-line);border-radius:18px;background:linear-gradient(145deg,rgba(66,52,36,.55),rgba(25,22,20,.85))}.model-box h2{font-size:2.8rem;letter-spacing:-.05em}.model-box p{line-height:1.65}.next-list{display:grid;align-content:center;gap:12px}.next-list div{padding:13px 0;border-bottom:1px solid var(--mo-line)}.warning-box{margin-top:22px;padding:22px;border-left:3px solid var(--mo-gold);background:rgba(66,52,36,.28)}.warning-box p{margin:7px 0;color:var(--mo-muted)}
    @media(max-width:900px){.summary-grid{grid-template-columns:1fr 1fr}.ranking-grid,.model-box{grid-template-columns:1fr}.review-main dl{grid-template-columns:1fr}.intel-hero{display:grid}.review-card{grid-template-columns:80px 1fr}.intel-shell{padding:24px 16px 60px}}
    @media(max-width:520px){.summary-grid{grid-template-columns:1fr}.review-card{grid-template-columns:1fr}.review-date{border-right:0;border-bottom:1px solid var(--mo-line);display:flex;align-items:end;gap:8px}.rank{grid-template-columns:24px 1fr}.rank em{grid-column:2}.section-head{display:grid}}
  </style>
</BaseLayout>
